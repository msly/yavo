// id: T-C6
// kind: check-fail
// phase: P1
// rule: C5
// summary: 匹配已有位置得到的是借用，不能移走

struct Holder {
    item: ?String
}

fn keep(s: sink String) {
    println(s)
}

fn drain(h: inout Holder) {
    if let s = h.item {             // 对已有位置匹配：s 是借用
        keep(s)                     //~ ERROR E0401
    }
}

fn main() {
    var h = Holder{item: "x".toString()}
    drain(&h)
}
