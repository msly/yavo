// id: T-GR4
// kind: run-pass
// phase: P2
// rule: S4
// summary: 字节数组转字符串验证成功和失败偏移
// expect-stdout:
// | AB
// | 1

fn main() {
    let valid: Vec[byte] = [65, 66]
    match String.fromUtf8(valid) {
        ok(s) => println(s)
        err(e) => println("unexpected ${e.offset}")
    }
    let invalid: Vec[byte] = [102, 255, 111]
    match String.fromUtf8(invalid) {
        ok(_s) => println("unexpected success")
        err(e) => println(e.offset)
    }
}
