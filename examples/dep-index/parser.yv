use std/fs
use model

fn isSpace(c: byte) -> bool {
    return c == ' ' || c == '\t'
}

fn isInitial(c: byte) -> bool {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_'
}

fn validName(name: str) -> bool {
    if name.len() == 0 { return false }
    var atStart = true
    for i in 0..name.len() {
        let c = name[i]
        if c == '.' {
            if atStart { return false }
            atStart = true
        } else {
            if atStart {
                if !isInitial(c) { return false }
            } else {
                if !isInitial(c) && !(c >= '0' && c <= '9') { return false }
            }
            atStart = false
        }
    }
    return !atStart
}

pub fn parse(text: str, path: str) -> Module ! Failure {
    var moduleName = String{}
    var moduleLine = 0
    var dependencies: Vec[Dependency] = []
    var seen = Set[String]{}
    var start = 0
    var lineNumber = 1

    while start < text.len() {
        var end = start
        while end < text.len() && text[end] != '\n' { end += 1 }
        var contentEnd = end
        if end < text.len() && contentEnd > start && text[contentEnd - 1] == '\r' {
            contentEnd -= 1
        }
        let line = text[start..contentEnd]

        // Only CR immediately preceding this line's LF is an ending.
        for i in 0..line.len() {
            let c = line[i]
            if (c < 32 && c != '\t') || c == 127 {
                return err(model.sourceFailure(path, lineNumber, "EDEP_FORMAT", "invalid control byte or bare CR"))
            }
        }
        if lineNumber == 1 && line.len() >= 3 && line[0] == 239 && line[1] == 187 && line[2] == 191 {
            return err(model.sourceFailure(path, lineNumber, "EDEP_FORMAT", "initial UTF-8 BOM is not allowed"))
        }

        var first = 0
        var last = line.len()
        while first < last && isSpace(line[first]) { first += 1 }
        while last > first && isSpace(line[last - 1]) { last -= 1 }
        if first < last && line[first] != '#' {
            var separator = first
            while separator < last && !isSpace(line[separator]) { separator += 1 }
            let word = line[first..separator]
            var nameStart = separator
            while nameStart < last && isSpace(line[nameStart]) { nameStart += 1 }
            let name = line[nameStart..last]
            if separator == last || !validName(name) {
                return err(model.sourceFailure(path, lineNumber, "EDEP_FORMAT", "expected a directive and an ASCII module name"))
            }
            if word == "module" {
                if moduleLine != 0 {
                    return err(model.sourceFailure(path, lineNumber, "EDEP_FORMAT", "only one module directive is allowed"))
                }
                moduleName = name.toString()
                moduleLine = lineNumber
            } else if word == "use" {
                if moduleLine == 0 {
                    return err(model.sourceFailure(path, lineNumber, "EDEP_FORMAT", "use appears before the module directive"))
                }
                if !seen.has(name) {
                    seen.add(name.toString())
                    dependencies.push(Dependency{name: name.toString(), line: lineNumber})
                }
            } else {
                return err(model.sourceFailure(path, lineNumber, "EDEP_FORMAT", "unknown directive"))
            }
        }

        start = end
        if start < text.len() { start += 1 }
        lineNumber += 1
    }

    if moduleLine == 0 {
        return err(model.sourceFailure(path, 1, "EDEP_MODULE", "missing module directive"))
    }
    return Module{name: moduleName, path: path.toString(), moduleLine: moduleLine, dependencies: dependencies}
}

pub fn read(path: str) -> Module ! Failure {
    // readText validates the complete file's UTF-8 before any line is parsed.
    let text = fs.readText(path) catch _ { return err(model.readFailure(path)) }
    return try parse(text, path)
}
