use std/{fs, os}
use parser
use report
use stats

fn execute() -> int {
    let args = os.args()
    if args.len() == 2 && args[1] == "--help" {
        report.help()
        return 0
    }
    var paths: Vec[String] = []
    var optionsEnded = false
    for i in 1..args.len() {
        let arg = args[i]
        if !optionsEnded && arg == "--" {
            optionsEnded = true
        } else if !optionsEnded && arg.startsWith("-") {
            report.usageError()
            return 2
        } else {
            paths.push(arg.toString())
        }
    }
    if paths.len() == 0 {
        report.usageError()
        return 2
    }
    var rows: Vec[FileRow] = []
    var exitCode = 0
    for path in paths {
        let text = fs.readText(path) catch _ {
            report.readError(path)
            return 3
        }
        let summary = parser.parse(text) catch problem {
            report.logError(path, problem)
            return 2
        }
        if summary.mismatch {
            report.mismatch(path, summary.summaryLine)
        }
        if stats.status(summary) != "ok" { exitCode = 1 }
        rows.push(FileRow{path: path.clone(), summary: summary})
    }
    report.table(rows)
    return exitCode
}

fn main() {
    let exitCode = execute()
    if exitCode != 0 { os.exit(exitCode) }
}
