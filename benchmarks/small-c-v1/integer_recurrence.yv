use std/os

fn main() {
    let args = os.args()
    assert(args.len() == 4)
    let n = args[1].parseInt() ?? 0
    let work = args[2].parseInt() ?? 0
    let seed = args[3].parseInt() ?? 0
    assert(n > 0 && n <= 20000000 && work > 0 && work <= 100 && seed > 0 && seed <= 100000)
    var x = seed
    var checksum = 0
    for _round in 0..work {
        for _i in 0..n {
            x = (x * 1664525 + 1013904223) % 2147483647
            checksum = (checksum + x) % 1000000007
        }
    }
    println(checksum)
}
