{
  "schema": "yavo-small-c-bench/1",
  "target": "x86_64-linux-musl",
  "optimization": [
    "-std=c17",
    "-fno-strict-aliasing",
    "-O2",
    "-s"
  ],
  "samples": 7,
  "warmup_runs": 2,
  "warm_build_samples": 5,
  "cases": [
    {
      "id": "integer_recurrence",
      "args": [
        15000000,
        1,
        17
      ],
      "small_args": [
        [
          1,
          1,
          1
        ],
        [
          17,
          3,
          19
        ],
        [
          256,
          2,
          65520
        ]
      ],
      "description": "Bounded signed 64-bit recurrence and checksum; scalar arithmetic safety costs."
    },
    {
      "id": "vec_transform",
      "args": [
        524288,
        192,
        17
      ],
      "small_args": [
        [
          1,
          1,
          1
        ],
        [
          17,
          3,
          19
        ],
        [
          257,
          9,
          65520
        ]
      ],
      "description": "Contiguous int64 Vec, in-place modular transform and final checksum."
    },
    {
      "id": "mutref_scatter",
      "args": [
        262144,
        15000000,
        17
      ],
      "small_args": [
        [
          1,
          1,
          1
        ],
        [
          17,
          333,
          19
        ],
        [
          257,
          999,
          65520
        ]
      ],
      "description": "Contiguous int64 Vec, seeded random access through returned mutable references."
    },
    {
      "id": "deque_ring",
      "args": [
        4096,
        20000000,
        17
      ],
      "small_args": [
        [
          1,
          7,
          1
        ],
        [
          17,
          333,
          19
        ],
        [
          257,
          999,
          65520
        ]
      ],
      "description": "int64 ring buffer, identical doubling growth and front-pop/back-push sequence."
    }
  ]
}
