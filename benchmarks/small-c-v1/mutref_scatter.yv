use std/os

fn cell(values: inout Vec[int], i: int) -> &inout int of values {
    return &values[i]
}

fn main() {
    let args = os.args()
    assert(args.len() == 4)
    let n = args[1].parseInt() ?? 0
    let work = args[2].parseInt() ?? 0
    let seed = args[3].parseInt() ?? 0
    assert(n > 0 && n <= 2000000 && work > 0 && work <= 20000000 && seed > 0 && seed <= 100000)
    var values: Vec[int] = []
    values.reserve(n)
    for i in 0..n {
        values.push((i * 17 + seed) % 65521)
    }
    var x = seed
    for _i in 0..work {
        x = (x * 48271) % 2147483647
        let p = cell(&values, x % n)
        *p = (*p + 1) % 65521
    }
    var checksum = 0
    for i in 0..n {
        checksum += values[i]
    }
    println(checksum)
}
