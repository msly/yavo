// id: T-P3
// kind: run-pass
// phase: P3
// rule: P3
// summary: scope 中途 return：先等线程结束，再释放被借用的数据
// sanitize: address+undefined; thread
// sanitize-mode: separate-artifacts
// expect-stdout:
// | -1
// | 10

fn sumAll(xs: []int) -> int {
    var s = 0
    for i in 0..xs.len() {
        s += xs[i]
    }
    return s
}

fn work(early: bool) -> int {
    let data: Vec[int] = [1, 2, 3, 4]
    var total = 0
    scope {
        let h = spawn sumAll(data)      // 线程借用 data
        if early {
            return -1                   // 先等线程结束，再释放 data
        }
        total = h.join()
    }
    return total
}

fn main() {
    println(work(true))
    println(work(false))
}
