// id: T-S2
// kind: run-pass
// phase: P2
// rule: S5
// summary: 读取含非法 UTF-8 的文件得到编码错误，不替换
// fixture: T-S2.input.bin
// fixture-hex: 66ff6f
// cwd: test-dir
// expect-stdout:
// | utf8 error at 1

use std/fs

fn main() {
    match fs.readText("T-S2.input.bin") {
        ok(t) => println("unexpected: ${t}")
        err(.Utf8(offset)) => println("utf8 error at ${offset}")
        err(_e) => println("other error")
    }
}
