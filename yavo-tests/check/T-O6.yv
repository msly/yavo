// id: T-O6
// kind: check-fail
// phase: P1
// rule: O1
// summary: largest[str] 的结果携带来源，来源销毁后不能再用

fn largest[T: Ord + Copy](xs: []T) -> ?T of xs {
    if xs.len() == 0 {
        return none
    }
    var best = xs[0]
    for i in 0..xs.len() {
        if xs[i] > best {
            best = xs[i]
        }
    }
    return best
}

fn main() {
    var best: ?str = none
    {
        let text = "pear apple fig".toString()
        let words = text.fields()
        best = largest(words)       //~ ERROR E0305
    }
    println(best ?? "")
}
