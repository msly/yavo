use std/io

fn main() {
    let input = io.readAll() catch _ { return }
    var spans: Vec[(int, int)] = []
    for line in input.lines() {
        let fields = line.fields()
        if fields.len() == 0 {
            continue
        }
        if fields[0] == "add" {
            let left = fields[1].parseInt() ?? 0
            let right = fields[2].parseInt() ?? 0
            spans.push((left, right))
            spans.sortBy((a, b) => a.0 < b.0)
            var merged: Vec[(int, int)] = []
            var start = spans[0].0
            var end = spans[0].1
            for i in 1..spans.len() {
                if spans[i].0 <= end + 1 {
                    end = max(end, spans[i].1)
                } else {
                    merged.push((start, end))
                    start = spans[i].0
                    end = spans[i].1
                }
            }
            merged.push((start, end))
            spans = merged
        } else if fields[0] == "del" {
            let left = fields[1].parseInt() ?? 0
            let right = fields[2].parseInt() ?? 0
            var remaining: Vec[(int, int)] = []
            for span in spans {
                if span.1 < left || span.0 > right {
                    remaining.push(span)
                } else {
                    if span.0 < left {
                        remaining.push((span.0, left - 1))
                    }
                    if span.1 > right {
                        remaining.push((right + 1, span.1))
                    }
                }
            }
            spans = remaining
        } else if fields[0] == "has" {
            let value = fields[1].parseInt() ?? 0
            var found = false
            for span in spans {
                if span.0 <= value && value <= span.1 {
                    found = true
                }
            }
            if found {
                println("yes")
            } else {
                println("no")
            }
        } else if fields[0] == "show" {
            if spans.len() == 0 {
                println("empty")
            } else {
                var result: Vec[String] = []
                for span in spans {
                    result.push(format("${span.0}:${span.1}"))
                }
                println(result.join(" "))
            }
        }
    }
    var count = 0
    for span in spans {
        count += span.1 - span.0 + 1
    }
    println("count: ${count}")
}
