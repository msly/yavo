use std/io

fn transfer(accounts: inout Map[String, int], from: str, to: str, amount: int) -> String {
    if !accounts.has(from) {
        return format("unknown ${from}")
    }
    if !accounts.has(to) {
        return format("unknown ${to}")
    }
    let balance = accounts.getCopy(from) ?? 0
    if balance < amount {
        return format("funds ${from}")
    }
    if from != to {
        let other = accounts.getCopy(to) ?? 0
        accounts.set(from.toString(), balance - amount)
        accounts.set(to.toString(), other + amount)
    }
    return String{}
}

fn main() {
    let input = io.readAll() catch _ { return }
    let lines = input.lines()
    var accounts: Map[String, int] = [:]
    var pos = 0
    while pos < lines.len() {
        let parts = lines[pos].fields()
        pos += 1
        if parts.len() == 0 {
            continue
        }
        let op = parts[0]
        if op == "account" {
            let name = parts[1]
            if accounts.has(name) {
                println("error: duplicate ${name}")
            } else {
                accounts.set(name.toString(), parts[2].parseInt() ?? 0)
            }
        } else if op == "pay" {
            let error = transfer(&accounts, parts[1], parts[2], parts[3].parseInt() ?? 0)
            if error.len() == 0 {
                println("paid")
            } else {
                println("error: ${error}")
            }
        } else if op == "balance" {
            let name = parts[1]
            if let balance = accounts.getCopy(name) {
                println("${name}: ${balance}")
            } else {
                println("error: unknown ${name}")
            }
        } else if op == "batch" {
            let count = parts[1].parseInt() ?? 0
            var trial = accounts.clone()
            var failed = false
            for row in 0..count {
                let fields = lines[pos].fields()
                pos += 1
                if !failed {
                    let error = transfer(&trial, fields[0], fields[1], fields[2].parseInt() ?? 0)
                    if error.len() > 0 {
                        println("batch: row ${row + 1} ${error}")
                        failed = true
                    }
                }
            }
            if !failed {
                accounts = trial
                println("batch: ok")
            }
        }
    }
    var names: Vec[String] = []
    var total = 0
    for name, balance in accounts {
        names.push(name.clone())
        total += balance
    }
    names.sort()
    for name in names {
        let balance = accounts.getCopy(name) ?? 0
        println("${name}=${balance}")
    }
    println("total: ${total}")
}
