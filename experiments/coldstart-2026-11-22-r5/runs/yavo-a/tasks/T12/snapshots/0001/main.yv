use std/io

struct Version {
    original: String
    major: int
    minor: int
    patch: int
    pre: Vec[String]
}

fn numeric(s: str) -> bool {
    if s.len() == 0 {
        return false
    }
    for i in 0..s.len() {
        if s[i] < '0' || s[i] > '9' {
            return false
        }
    }
    return true
}

fn coreNumber(s: str) -> ?int {
    if !numeric(s) {
        return none
    }
    var value = 0
    for i in 0..s.len() {
        value = value * 10 + int(s[i] - '0')
        if value > 1000000000 {
            return none
        }
    }
    return value
}

fn validIdentifiers(s: str) -> bool {
    for id in s.split(".") {
        if id.len() == 0 || id.len() > 32 {
            return false
        }
        for i in 0..id.len() {
            let c = id[i]
            if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-') {
                return false
            }
        }
    }
    return s.len() > 0
}

fn parse(text: str) -> ?Version {
    let parts = text.split("+")
    if parts.len() > 2 {
        return none
    }
    if parts.len() == 2 && !validIdentifiers(parts[1]) {
        return none
    }
    let body = parts[0]
    var core = body
    var pre: Vec[String] = []
    if let hyphen = body.find("-") {
        core = body[0..hyphen]
        let suffix = body[hyphen + 1..body.len()]
        if !validIdentifiers(suffix) {
            return none
        }
        for id in suffix.split(".") {
            pre.push(id.toString())
        }
    }
    let numbers = core.split(".")
    if numbers.len() != 3 {
        return none
    }
    let major = coreNumber(numbers[0]) ?? return none
    let minor = coreNumber(numbers[1]) ?? return none
    let patch = coreNumber(numbers[2]) ?? return none
    return Version{original: text.toString(), major: major, minor: minor, patch: patch, pre: pre}
}

fn canonical(s: str) -> str of s {
    var pos = 0
    while pos + 1 < s.len() && s[pos] == '0' {
        pos += 1
    }
    return s[pos..s.len()]
}

fn compareId(a: str, b: str) -> int {
    let an = numeric(a)
    let bn = numeric(b)
    if an && !bn {
        return -1
    }
    if !an && bn {
        return 1
    }
    if an && bn {
        let x = canonical(a)
        let y = canonical(b)
        if x.len() < y.len() {
            return -1
        }
        if x.len() > y.len() {
            return 1
        }
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
        return 0
    }
    if a < b {
        return -1
    }
    if a > b {
        return 1
    }
    return 0
}

fn less(a: Version, b: Version) -> bool {
    if a.major != b.major {
        return a.major < b.major
    }
    if a.minor != b.minor {
        return a.minor < b.minor
    }
    if a.patch != b.patch {
        return a.patch < b.patch
    }
    if a.pre.len() == 0 {
        return false
    }
    if b.pre.len() == 0 {
        return true
    }
    for i in 0..min(a.pre.len(), b.pre.len()) {
        let comparison = compareId(a.pre[i], b.pre[i])
        if comparison != 0 {
            return comparison < 0
        }
    }
    return a.pre.len() < b.pre.len()
}

fn main() {
    let input = io.readAll() catch _ { return }
    var versions: Vec[Version] = []
    var invalid = 0
    for row, line in input.lines() {
        if let version = parse(line) {
            versions.push(version)
        } else {
            println("line ${row + 1}: invalid")
            invalid += 1
        }
    }
    versions.sortBy((a, b) => less(a, b))
    for version in versions {
        println(version.original)
    }
    println("valid: ${versions.len()} invalid: ${invalid}")
}
