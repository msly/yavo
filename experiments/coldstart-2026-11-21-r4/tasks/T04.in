# global settings
name = demo-${server.host}
  ; indented comment

[server]
host = example.org
port = 80
port = 8080
url = http://${server.host}:${server.port}/

[ db ]
user=admin
url = ${server.url}db?u=${db.user}
dsn = ${db.url} (unterminated ${db.user
empty =
[loop]
a = x${loop.b}
b = y${loop.c}
c = ${loop.a}z

[bad]
ref = ok ${server.port} then ${nope.k} and ${loop.a}
[server]
host = example.com
