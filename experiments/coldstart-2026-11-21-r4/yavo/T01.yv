use std/{io, os, collections}

struct Net {
    adj: Map[String, Set[String]]
    links: int

    fn linked(self, a: str, b: str) -> bool {
        if let s = self.adj.get(a) {
            return s.has(b)
        }
        return false
    }

    fn friendsOf(self, n: str) -> Vec[String] {
        var out: Vec[String] = []
        if let s = self.adj.get(n) {
            for f in s {
                out.push(f.clone())
            }
        }
        out.sort()
        return out
    }

    fn path(self, a: str, b: str) {
        var prev: Map[String, String] = [:]
        prev.set(a.toString(), "".toString())
        var q = Deque[String]{}
        q.pushBack(a.toString())
        var found = a == b
        while !found {
            let u = q.popFront() ?? break
            let fr = self.friendsOf(u)
            for v in fr {
                if prev.has(v) {
                    continue
                }
                prev.set(v.clone(), u.clone())
                if v == b {
                    found = true
                    break
                }
                q.pushBack(v.clone())
            }
        }
        if !found {
            println("path: none")
            return
        }
        var rev: Vec[String] = []
        var cur = b.toString()
        while cur != a {
            rev.push(cur.clone())
            var nx = "".toString()
            if let p = prev.get(cur) {
                nx = p.clone()
            }
            cur = nx
        }
        var out = String{}
        out.push("path: ")
        out.push(a)
        var i = rev.len()
        while i > 0 {
            i -= 1
            out.push(" -> ")
            out.push(rev[i])
        }
        println(out)
    }

    fn exec(inout self, f: []str) {
        let c = f[0]
        var need = 0
        if c == "add" || c == "remove" || c == "friends" {
            need = 2
        } else if c == "link" || c == "unlink" || c == "path" {
            need = 3
        } else {
            println("error: bad command")
            return
        }
        if f.len() != need {
            println("error: bad command")
            return
        }
        if c == "add" {
            if self.adj.has(f[1]) {
                println("error: ${f[1]} exists")
                return
            }
            self.adj.set(f[1].toString(), Set[String]{})
            return
        }
        var i = 1
        while i < f.len() {
            if !self.adj.has(f[i]) {
                println("error: no user ${f[i]}")
                return
            }
            i += 1
        }
        if c == "friends" {
            let fr = self.friendsOf(f[1])
            if fr.len() == 0 {
                println("${f[1]}: (none)")
            } else {
                println("${f[1]}: ${fr.join(" ")}")
            }
        } else if c == "path" {
            self.path(f[1], f[2])
        } else if c == "remove" {
            let fr = self.friendsOf(f[1])
            for x in fr {
                if let t = self.adj.getMut(x) {
                    let _r = t.remove(f[1])
                }
                self.links -= 1
            }
            let _o = self.adj.remove(f[1])
        } else if c == "link" {
            if f[1] == f[2] {
                println("error: self link")
                return
            }
            if self.linked(f[1], f[2]) {
                return
            }
            if let s = self.adj.getMut(f[1]) {
                s.add(f[2].toString())
            }
            if let s = self.adj.getMut(f[2]) {
                s.add(f[1].toString())
            }
            self.links += 1
        } else {
            if !self.linked(f[1], f[2]) {
                println("error: not linked")
                return
            }
            if let s = self.adj.getMut(f[1]) {
                let _r = s.remove(f[2])
            }
            if let s = self.adj.getMut(f[2]) {
                let _r = s.remove(f[1])
            }
            self.links -= 1
        }
    }
}

fn main() {
    let text = io.readAll() catch e {
        eprintln("read error: ${e}")
        os.exit(1)
    }
    var net = Net{adj: [:], links: 0}
    for line in text.lines() {
        let f = line.fields()
        if f.len() == 0 {
            continue
        }
        net.exec(f)
    }
    println("users: ${net.adj.len()} links: ${net.links}")
}
