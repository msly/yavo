use std/{fs, os}

fn main() {
    let args = os.args()
    if args.len() < 3 {
        eprintln("usage: T11 a b")
        os.exit(2)
    }
    let ta = fs.readText(args[1]) catch _ {
        eprintln("error: cannot read ${args[1]}")
        os.exit(2)
    }
    let tb = fs.readText(args[2]) catch _ {
        eprintln("error: cannot read ${args[2]}")
        os.exit(2)
    }
    let a = ta.lines()
    let b = tb.lines()
    let n = a.len()
    let m = b.len()
    let w = m + 1
    var l: Vec[int] = []
    var z = 0
    while z < (n + 1) * w {
        l.push(0)
        z += 1
    }
    var i = n
    while i > 0 {
        i -= 1
        var j = m
        while j > 0 {
            j -= 1
            if a[i] == b[j] {
                l[i * w + j] = l[(i + 1) * w + j + 1] + 1
            } else {
                l[i * w + j] = max(l[(i + 1) * w + j], l[i * w + j + 1])
            }
        }
    }
    var dels = 0
    var adds = 0
    i = 0
    var j = 0
    while i < n && j < m {
        if a[i] == b[j] {
            println("  ${a[i]}")
            i += 1
            j += 1
        } else if l[(i + 1) * w + j] >= l[i * w + j + 1] {
            println("- ${a[i]}")
            dels += 1
            i += 1
        } else {
            println("+ ${b[j]}")
            adds += 1
            j += 1
        }
    }
    while i < n {
        println("- ${a[i]}")
        dels += 1
        i += 1
    }
    while j < m {
        println("+ ${b[j]}")
        adds += 1
        j += 1
    }
    println("summary: -${dels} +${adds}")
    if dels + adds > 0 {
        os.exit(1)
    }
}
