use std/{io, os}

fn main() {
    let args = os.args()
    if args.len() < 2 {
        eprintln("usage: T07 WIDTH")
        os.exit(2)
    }
    let width = args[1].parseInt() ?? 0
    let text = io.readAll() catch e {
        eprintln("read error: ${e}")
        os.exit(1)
    }
    var cur = String{}
    for w in text.fields() {
        if cur.len() == 0 {
            cur.push(w)
        } else if cur.len() + 1 + w.len() <= width {
            cur.push(" ")
            cur.push(w)
        } else {
            println(cur)
            cur = String{}
            cur.push(w)
        }
    }
    if cur.len() > 0 {
        println(cur)
    }
}
