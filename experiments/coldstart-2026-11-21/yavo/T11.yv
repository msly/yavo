use std/{fs, os}

fn lcs(tab: Vec[int], m: int, n: int, i: int, j: int) -> int {
    return tab[(n - i) * (m + 1) + (m - j)]
}

fn diff(ta: str, tb: str) -> int {
    let a = ta.lines()
    let b = tb.lines()
    let n = a.len()
    let m = b.len()
    var tab: Vec[int] = []
    var i = n + 1
    while i > 0 {
        i -= 1
        var j = m + 1
        while j > 0 {
            j -= 1
            if i == n || j == m {
                tab.push(0)
            } else if a[i] == b[j] {
                let v1 = lcs(tab, m, n, i + 1, j + 1) + 1
                tab.push(v1)
            } else {
                let v2 = max(lcs(tab, m, n, i + 1, j), lcs(tab, m, n, i, j + 1))
                tab.push(v2)
            }
        }
    }
    var del = 0
    var add = 0
    i = 0
    var j = 0
    while i < n && j < m {
        if a[i] == b[j] {
            println("  ${a[i]}")
            i += 1
            j += 1
        } else if lcs(tab, m, n, i + 1, j) >= lcs(tab, m, n, i, j + 1) {
            println("- ${a[i]}")
            del += 1
            i += 1
        } else {
            println("+ ${b[j]}")
            add += 1
            j += 1
        }
    }
    while i < n {
        println("- ${a[i]}")
        del += 1
        i += 1
    }
    while j < m {
        println("+ ${b[j]}")
        add += 1
        j += 1
    }
    println("summary: -${del} +${add}")
    if del == 0 && add == 0 {
        return 0
    }
    return 1
}

fn main() {
    let args = os.args()
    if args.len() < 3 {
        eprintln("usage: T11 a b")
        os.exit(2)
    }
    let pa = args[1]
    let pb = args[2]
    let ta = fs.readText(pa) catch _e {
        eprintln("error: cannot read ${pa}")
        os.exit(2)
    }
    let tb = fs.readText(pb) catch _e {
        eprintln("error: cannot read ${pb}")
        os.exit(2)
    }
    let code = diff(ta, tb)
    if code != 0 {
        os.exit(code)
    }
}
