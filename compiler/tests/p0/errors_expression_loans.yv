// Expression-result origins survive branch exit and nested borrow-carrying values.
// Syntax/storage boundaries are tested separately in borrow_provenance.rs.
enum LoanBox { Text(value: String) }
fn matchLocal() -> str of static {
    let owner = "x".toString()
    return match owner[0..1] { view => view }
}
fn matchOwned() -> str of static {
    return match LoanBox.Text("x".toString()) { .Text(value) => value[0..value.len()] }
}
fn wrongParameter(a: str, _b: str) -> str of _b {
    return match a { view => view }
}
fn ifLocal(flag: bool) -> str of static {
