use std/sync

fn notSend() {
    let _ch = Channel[Rc[int]]{cap: 1}
}

fn noCap() {
    let _ch = Channel[int]{}
}

fn otherField() {
    let _ch = Channel[int]{cap: 1, size: 2}
}

fn sendWrongType() {
    let ch = Channel[int]{cap: 1}
    ch.send("x") catch _e { return }
}

fn unhandled() {
    let ch = Channel[int]{cap: 1}
    ch.send(1)
}

fn main() {
}
