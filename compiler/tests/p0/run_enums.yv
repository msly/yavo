// expect-stdout:
// | circle 12
// | rect 12
// | rect 30
// | other 0
// | total 54
// | num 7
// | word hi (2)
// | end
// | hi
// | Word(text: hi)
// | Rect(w: 3, h: 4) and Empty
// | r 1
// | num 3
// Enums: construction (qualified, shorthand, named and positional payloads), `match` as a
// statement and as an expression, nested patterns, printing, enums inside collections.
enum Shape {
    Circle(r: int)
    Rect(w: int, h: int)
    Empty
}

enum Token {
    Num(value: int)
    Word(text: String)
    End
}

fn area(s: Shape) -> int {
    match s {
        .Circle(r) => return 3 * r * r
        .Rect(w, h) => return w * h
        .Empty => return 0
    }
}

fn kind(s: Shape) -> str of static {
    return match s {
        .Circle(_) => "circle"
        Shape.Rect(_, _) => "rect"
        _ => "other"
    }
}

fn describe(t: Token) {
    match t {
        .Num(n) => println("num ${n}")
        .Word(w) => println("word ${w} (${w.len()})")
        .End => println("end")
    }
}

fn firstWord(ts: Vec[Token]) -> ?String {
    for t in ts {
        match t {
            .Word(w) => return some(w.clone())
            _ => {}
        }
    }
    return none
}

fn main() {
    let shapes = [Shape.Circle(r: 2), .Rect(w: 3, h: 4), Shape.Rect(5, 6), .Empty]
    var total = 0
    for s in shapes {
        total += area(s)
        println("${kind(s)} ${area(s)}")
    }
    println("total ${total}")
    var tokens: Vec[Token] = [.Num(value: 7), Token.Word(text: "hi".toString())]
    tokens.push(.End)
    for t in tokens {
        describe(t)
    }
    let w = firstWord(tokens) ?? "none".toString()
    println(w)
    println(tokens[1])
    println("${shapes[1]} and ${Shape.Empty}")
    let maybe: ?Shape = some(.Circle(r: 1))
    let r = match maybe {
        some(.Circle(r)) => r
        some(_) => -1
        none => 0
    }
    println("r ${r}")
    var cur = Token.Word(text: "old".toString())
    cur = .Num(value: 3)
    describe(cur)
}
