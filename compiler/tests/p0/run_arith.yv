// expect-stdout:
// | 5
// | 9
// | -3 -1 3 1
// | 7 6 1
// | 255 0 200
// | -128 127
// | 18446744073709551615
// | true false true
fn main() {
    println(1 + 2 * 3 - 4 / 2)
    println((1 + 2) * 3)
    println("${-7 / 2} ${-7 % 2} ${7 / 2} ${7 % 2}")
    println("${6 | 1} ${7 & 14} ${7 ^ 6}")
    let m: u8 = 255
    println("${m} ${m +% 1} ${m *% 2 -% 54}")
    println("${i8.min} ${i8.max}")
    println(u64.max)
    println("${1 < 2} ${2 <= 1} ${1 != 2 && (3 > 2 || false)}")
}
