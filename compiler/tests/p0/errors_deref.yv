fn readOnly() {
    let value = 1
    var p: &int = &value
    *p = 2
}

fn noContext() {
    var n = 1
    let p = &n
    println(p)
}

fn loopReadOnly() {
    var values: Vec[int] = [1, 2]
    for value in values {
        *value = 3
    }
}

fn useWhileLive() {
    var x = 1
    let p: &inout int = &x
    println(x)
    *p = 2
}

fn readerLive() {
    var x = 1
    let r: &int = &x
    let p: &inout int = &x
    *p = 2
    println(*r)
}

fn twoMut() {
    var x = 1
    let p: &inout int = &x
    let q: &inout int = &x
    *q = 3
    *p = 2
}

fn reborrowOrder() {
    var x = 1
    var p: &inout int = &x
    let q: &inout int = &p
    *p = 4
    *q = 3
}

fn letTarget() {
    let x = 1
    let p: &inout int = &x
    *p = 2
}

fn movedRef() {
    var x = 1
    let p: &inout int = &x
    let q = p
    *p = 2
    *q = 3
}

fn rebindLet() {
    var a = 1
    var b = 2
    let p: &inout int = &a
    p = &b
    *p = 3
}

fn derefInt() {
    var n = 1
    *n = 2
}

fn moveOut() {
    var s = "a".toString()
    let p: &inout String = &s
    let t = *p
    println(t)
}

fn tooShort() {
    var a = 1
    var p: &inout int = &a
    *p = 0
    if true {
        var b = 2
        p = &b
    }
    *p = 1
}

fn paramRef(p: &inout int) {
}

