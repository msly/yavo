// expect-stdout:
// | ABCDP1:2:ok:trueQ
// | AR3S
// | false
fn value(label: str, n: int) -> int {
    print(label)
    return n
}
fn text() -> str {
    print("C")
    return "ok"
}
fn truth() -> bool {
    print("D")
    return true
}
fn main() {
    let a = "A"
    let b = "B"
    println("P${value(a, 1)}:${value(b, 2)}:${text()}:${truth()}Q")
    print("R${value(a, 3)}S")
    println()
    println("${false && truth()}")
}
