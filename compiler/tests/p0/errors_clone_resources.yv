use std/sync

struct HoldsLock { lock: Mutex[int] }
enum LockChoice { One(lock: Mutex[int]), Empty }

struct Resource: Drop {
    id: int
    fn drop(inout self) { let _ = self.id }
}

fn vectorOfLocks() {
    let values: Vec[Mutex[int]] = [Mutex(1)]
    let _copy = values.clone()
}

fn mapOfLocks() {
    var values: Map[int, Mutex[int]] = [:]
    values.set(1, Mutex(1))
    let _copy = values.clone()
}

fn optionalLock() {
    let values: Vec[?Mutex[int]] = [some(Mutex(1))]
    let _copy = values.clone()
}

fn nestedLock() {
    let values: Vec[Vec[Mutex[int]]] = [[Mutex(1)]]
    let _copy = values.clone()
}

fn structLock() {
    let values: Vec[HoldsLock] = [HoldsLock{lock: Mutex(1)}]
    let _copy = values.clone()
}

fn enumLock() {
    let values: Vec[LockChoice] = [LockChoice.One(Mutex(1))]
    let _copy = values.clone()
}

fn tupleLock() {
    let values: Vec[(Mutex[int], int)] = [(Mutex(1), 2)]
    let _copy = values.clone()
}

fn boxedLock() {
    let values: Vec[Box[Mutex[int]]] = [Box(Mutex(1))]
    let _copy = values.clone()
}

fn userResource() {
    let values: Vec[Resource] = [Resource{id: 1}]
    let _copy = values.clone()
}

fn main() {
}
