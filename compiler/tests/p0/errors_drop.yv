struct Token: Drop {
    n: int
    fn drop(inout self) {
        println(self.n)
    }
}

struct NoMethod: Drop {
    n: int
}

struct Extra: Drop {
    n: int
    fn drop(inout self, k: int) {
        println(k)
    }
}

struct Plain {
    n: int
    fn drop(self) {
    }
}

struct Bad: Drop {
    name: String
    fn drop(inout self) {
        let t = take(&self)
        self = Bad{name: "x".toString()}
        let s = self
    }
}

fn copies() {
    let a = Token{n: 1}
    let b = a
    println(a.n)
    println(b.n)
}

fn direct() {
    var t = Token{n: 1}
    t.drop()
}

fn main() {
}
