struct Node {
    key: int
    name: String
    left: ?Box[Node]
}

fn link(a: inout ?Box[Node], b: inout Box[Node]) {
    b.key += 1
    a = none
}

fn shrink(t: inout ?Box[Node]) {
    if let n = t {
        link(&n.left, &n)
    }
}

fn readOnly(t: ?Box[Node]) {
    if let n = t {
        n.key += 1
    }
}

fn main() {
    let text = "a b".toString()
    let views: Box[str] = Box("x")
    let trimmed = Box(text.trim())
    var b = Box(Node{key: 1, name: "n".toString()})
    let taken = take(&b)
    let name = b.name
    let two = Box(1, 2)
    var root: ?Box[Node] = none
    shrink(&root)
    readOnly(root)
}
