// expect-stdout:
// | 80000
// | worker-1,worker-2
// | one
// | 60
// | 10
// | -1 3
use std/sync

struct Counter {
    n: int
}

fn bump(p: sink Arc[Mutex[Counter]], times: int) {
    for _i in 0..times {
        with g = p.lock() {
            g.n += 1
        }
    }
}

fn label(i: int) -> String {
    return format("worker-${i}")
}

fn sum(xs: []int) -> int {
    var s = 0
    for x in xs {
        s += x
    }
    return s
}

fn speak(word: sink String) {
    println(word)
}

fn early(stop: bool) -> int {
    let data: Vec[int] = [1, 2, 3, 4, 5]
    scope {
        let a = spawn sum(data[0..2])
        let _b = spawn sum(data)
        if stop {
            return -1
        }
        return a.join()
    }
}

fn main() {
    let shared = Arc(Mutex(Counter{n: 0}))
    scope {
        for _i in 0..8 {
            spawn bump(shared.clone(), 10000)
        }
    }
    with g = shared.lock() {
        println(g.n)
    }
    var names: Vec[String] = []
    scope {
        let h1 = spawn label(1)
        let h2 = spawn label(2)
        let _h3 = spawn label(3)
        names.push(h1.join())
        names.push(h2.join())
    }
    println(names.join(","))
    scope {
        spawn speak("one".toString())
    }
    let data: Vec[int] = [10, 20, 30]
    scope {
        let outer = spawn sum(data[0..1])
        scope {
            let inner = spawn sum(data)
            println(inner.join())
        }
        println(outer.join())
    }
    println("${early(true)} ${early(false)}")
}
