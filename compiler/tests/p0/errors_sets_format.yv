fn floats() {
    var s: Set[f64] = []
}

fn twoVars() {
    var s: Set[int] = []
    s.add(1)
    for a, b in s {
        println(a)
    }
}

fn writeElements() {
    var s: Set[int] = []
    s.add(1)
    for a in &s {
        println(a)
    }
}

fn alreadyBorrowed() {
    var s: Set[int] = []
    s.add(s.len())
}

fn readOnly(s: Set[int]) {
    s.add(1)
}

fn formatInt() {
    let n = 3
    println("${n:.2}")
}

fn formatOther() {
    let x = 1.5
    println("${x:>8}")
}

fn formatTooMany() {
    let x = 1.5
    println("${x:.20}")
}

