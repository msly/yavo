struct Counter {
    name: String
    total: int

    fn new(name: str) -> Counter {
        return Counter{name: name.toString(), total: 0}
    }
    fn label(self) -> str of self {
        return self.name
    }
    fn add(inout self, n: int) {
        self.total += n
    }
    fn finish(sink self) -> String {
        return self.name
    }
    fn leak(self) -> str {
        return self.name
    }
    fn local() -> str of static {
        let s = "x".toString()
        return s
    }
}

fn readOnly() {
    let c = Counter.new("a")
    c.add(1)
}

fn temporary() {
    Counter.new("a").add(1)
}

fn viewThenWrite() {
    var c = Counter.new("a")
    let l = c.label()
    c.add(1)
    println(l)
}

fn consumed() {
    let c = Counter.new("a")
    let s = c.finish()
    println(c.label())
    println(s)
}

fn arity() {
    var c = Counter.new("a")
    c.add(1, 2)
}

fn kinds() {
    let c = Counter.new("a")
    let x = c.new("b")
    let y = Counter.label()
    let z = c.missing()
}

fn main() {
}
