         "source_text" : "enum Issue { Bad }\nfn parse(s: str) -> int ! Issue {\n    let n = s.parseInt() ?? return err(.Bad)\n    return n\n}\nfn load(s: str) -> int ! Issue {\n    let n = try parse(s)\n    return n + 1\n}\nfn main() {\n    match load(\"41\") {\n        ok(n) => println(n)\n        err(_e) => println(\"bad\")\n    }\n    let fallback = parse(\"x\") catch _ => 0\n    println(fallback)\n    var opt: ?String = some(\"owned\".toString())\n    match take(&opt) {\n        some(value) => println(value)\n        none => println(\"missing\")\n    }\n    println(opt.isNone())\n}\n"
