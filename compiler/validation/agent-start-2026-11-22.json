         "source_text" : "fn main() {\n    var m: Map[String, int] = [:]\n    m.set(\"a\".toString(), 1)\n    m.update(\"a\".toString(), 0, (n) => n + 1)\n    if let p = m.getMut(\"a\") { *p += 3 }\n    println(m.getCopy(\"a\") ?? 0)\n    let removed = m.remove(\"a\") ?? 0\n    println(\"${removed} ${m.len()}\")\n    var s = Set[int]{}\n    s.add(1)\n    s.add(1)\n    let before = s.len()\n    let found = s.has(1)\n    let erased = s.remove(1)\n    println(\"${before} ${found} ${erased} ${s.len()}\")\n    var fs: Vec[f64] = [2.0, 1.0]\n    fs.sortBy((a, b) => a.totalCmp(b) == .Less)\n    println(\"${fs[0]:.1}\")\n    var out = String{}\n    out.push(\"x\")\n    let parts = \"a,b\".split(\",\")\n    out.push(parts.join(\"|\"))\n    println(out)\n    let pair = (1, \"ok\".toString())\n    println(\"${pair.0} ${pair.1}\")\n}\n"
