         "source_text" : "use std/{io, os}\n\nfn main() {\n    let text = io.readAll() catch e {\n        eprintln(\"${e}\")\n        os.exit(1)\n    }\n    var nums: Vec[int] = []\n    for word in text.fields() {\n        let n = word.parseInt() ?? return\n        nums.push(n)\n    }\n    nums.sort()\n    var sum = 0\n    for n in nums { sum += n }\n    println(\"${sum} ${nums.len()}\")\n}\n"
