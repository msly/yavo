use std/os
use support

// The bootstrap subset deliberately rejects syntax it cannot yet compile.
// Keep statement termination and string decoding aligned with the Rust lexer.

pub enum TokenKind {
    Word
    Number
    Text
    Symbol
    Newline
    Eof
    Byte
    StringStart
    StringEnd
    InterpolationStart
    InterpolationEnd
    FormatSpec
    DeferredError
}

// The Eof token's text holds the input path for diagnostics. InterpolationStart
// text retains its raw expression range; a deferred inner fault follows the
// inner tokens. StringStart/StringEnd span only their own quote, so no token
// is rewritten after it is pushed (owned element places are outside the subset).
pub struct Token {
    kind: TokenKind
    text: String
    start: int
    end: int
    line: int
    column: int
    message: String = ""
    lineBase: int = 0
    // Only a file's Eof owns its JSON diagnostic context. Text mode retains
    // neither a source copy nor a hash; ordinary tokens keep these defaults.
    jsonMode: bool = false
    sourceSnapshot: String = ""
    sourceSha256: String = ""
}

// A lexical failure is recorded once; callers stop at the first one.
struct Cursor {
    pos: int = 0
    line: int = 1
    column: int = 1
    lineBase: int = 0
    failed: bool = false
    code: String = ""
    message: String = ""
    failOffset: int = 0
    failEnd: int = 0
    failLine: int = 0
    failColumn: int = 0
}

struct InterpolationRange {
    expressionEnd: int = -1
    specStart: int = -1
    specLine: int = 0
    specColumn: int = 0
    close: int = -1
    closeLine: int = 0
    closeColumn: int = 0
}

// Enumerate the successfully lexed JSON-mode files, in load order. A lexical
// failure can leave partial tokens after the last Eof; those are not a file.
pub fn sourceIdentities(ts: Vec[Token]) -> Vec[SourceIdentity] {
    var sources: Vec[SourceIdentity] = []
    var i = 0
    while i < ts.len() {
        if ts[i].kind == .Eof && ts[i].jsonMode {
            sources.push(SourceIdentity{path: ts[i].text.clone(),
                bytes: ts[i].sourceSnapshot.len(), sha256: ts[i].sourceSha256.clone()})
        }
        i += 1
    }
    return sources
}

// Fatal diagnostic at a token; the path is the text of that file's Eof token.
pub fn fail(ts: Vec[Token], token: int, code: str, message: str) {
    // The token's own file ends at the next Eof token, which holds its path.
    var eof = token
    while ts[eof].kind != .Eof { eof += 1 }
    if ts[eof].jsonMode {
        let sources = sourceIdentities(ts)
        support.reportJson(sources, ts[eof].sourceSnapshot, ts[eof].text,
            ts[token].start, ts[token].end, code, message)
        return
    }
    support.report(ts[eof].text, ts[token].line, ts[token].column, code, message)
}

// The end is evaluated before borrowing the cursor mutably. Range computation
// never consumes input or changes the established first-error selection.
fn stopWithEnd(endOffset: int, cursor: inout Cursor, code: str, message: str, offset: int, line: int, column: int) {
    if cursor.failed { return }
    cursor.failed = true
    cursor.code = code.toString()
    cursor.message = message.toString()
    cursor.failOffset = offset
    cursor.failEnd = endOffset
    cursor.failLine = line
    cursor.failColumn = column
}

fn stop(cursor: inout Cursor, code: str, message: str, offset: int, line: int, column: int) {
    stopWithEnd(cursor.pos, &cursor, code, message, offset, line, column)
}

fn wordStart(c: byte) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn digit(c: byte) -> bool {
    return c >= '0' && c <= '9'
}

// Is source[start..end] a decimal mantissa followed by its first exponent
// marker? This prevents a suffix or hexadecimal E from absorbing a later sign.
fn decimalExponentPrefix(source: str, start: int, end: int) -> bool {
    var pos = start
    while pos < end && (digit(source[pos]) || source[pos] == '_') { pos += 1 }
    if pos == start { return false }
    if pos < end && source[pos] == '.' {
        pos += 1
        let fraction = pos
        while pos < end && (digit(source[pos]) || source[pos] == '_') { pos += 1 }
        if pos == fraction { return false }
    }
    return pos + 1 == end && (source[pos] == 'e' || source[pos] == 'E')
}

// Frozen lexical-candidate range, independent of how far recognition consumed.
fn numericEnd(source: str, start: int) -> int {
    var pos = start
    while pos < source.len() {
        let c = source[pos]
        if wordStart(c) || digit(c) {
            pos += 1
        } else if c == '.' && pos + 1 < source.len() && digit(source[pos + 1]) {
            pos += 1
        } else if (c == '+' || c == '-') && pos + 1 < source.len() &&
            digit(source[pos + 1]) && decimalExponentPrefix(source, start, pos) {
            pos += 1
        } else {
            break
        }
    }
    return pos
}

fn detectedScalarEnd(source: str, pos: int) -> int {
    if pos == source.len() { return pos }
    return pos + scalarWidth(source[pos])
}

fn exponentAhead(source: str, pos: int) -> bool {
    if pos + 1 >= source.len() { return false }
    let next = source[pos + 1]
    if digit(next) { return true }
    return (next == '+' || next == '-') &&
        pos + 2 < source.len() && digit(source[pos + 2])
}

fn integerLiteralFits(text: str) -> bool {
    // Rust tokens store a u128 magnitude even when contextual int checking is
    // deferred, as for unused field defaults. Leading zeroes do not consume it.
    let maximum = "340282366920938463463374607431768211455"
    var first = 0
    while first + 1 < text.len() && text[first] == '0' { first += 1 }
    let length = text.len() - first
    if length < maximum.len() { return true }
    if length > maximum.len() { return false }
    return text[first..text.len()] <= maximum
}

pub fn scalarWidth(c: byte) -> int {
    if c < 128 { return 1 }
    if c < 224 { return 2 }
    if c < 240 { return 3 }
    return 4
}

// source is valid UTF-8 (str's contract); every cursor starts at a scalar boundary.
fn bump(cursor: inout Cursor, source: str) {
    if source[cursor.pos] == '\n' {
        cursor.pos += 1
        cursor.line += 1
        cursor.column = 1
    } else {
        let width = scalarWidth(source[cursor.pos])
        cursor.pos += width
        cursor.column += 1
    }
}

fn hexDigit(c: byte) -> int {
    if c >= '0' && c <= '9' { return int(c) - int('0') }
    if c >= 'a' && c <= 'f' { return int(c) - int('a') + 10 }
    if c >= 'A' && c <= 'F' { return int(c) - int('A') + 10 }
    return -1
}

// Tokens carry decimal magnitudes, as consumed by the common integer checker.
// Non-decimal accumulation uses at most 40 decimal digits: the lexer accepts
// u128 magnitudes while contextual int/byte range checks happen later.
fn integerToken(cursor: inout Cursor, source: str, start: int, line: int, column: int, afterDot: bool) -> String {
    var radix = 10
    if source[start] == '0' && start + 1 < source.len() {
        if source[start + 1] == 'x' { radix = 16 }
        if source[start + 1] == 'b' { radix = 2 }
        if source[start + 1] == 'o' { radix = 8 }
        if radix != 10 {
            bump(&cursor, source)
            bump(&cursor, source)
        }
    }
    var text = String{}
    var magnitude: Vec[int] = [0]
    var overflow = false
    var invalid = false
    var digits = 0
    while cursor.pos < source.len() {
        let c = source[cursor.pos]
        if c == '_' { bump(&cursor, source)
            continue }
        if !wordStart(c) && !digit(c) { break }
        if radix == 10 && !invalid && (c == 'e' || c == 'E') && exponentAhead(source, cursor.pos) { break }
        let value = hexDigit(c)
        if value < 0 || value >= radix {
            invalid = true
        } else {
            digits += 1
            if radix == 10 {
                text.push(source[cursor.pos..cursor.pos + 1])
            } else if !overflow {
                var carry = value
                var i = 0
                while i < magnitude.len() {
                    let next = magnitude[i] * radix + carry
                    magnitude[i] = next % 10
                    carry = next / 10
                    i += 1
                }
                while carry > 0 {
                    magnitude.push(carry % 10)
                    carry = carry / 10
                }
                if magnitude.len() > 39 { overflow = true }
            }
        }
        bump(&cursor, source)
    }
    if radix == 10 && !afterDot && cursor.pos < source.len() {
        let next = source[cursor.pos]
        if ((next == 'e' || next == 'E') && exponentAhead(source, cursor.pos)) ||
            (next == '.' && cursor.pos + 1 < source.len() && digit(source[cursor.pos + 1])) {
            stopWithEnd(numericEnd(source, start), &cursor, "U0001", "floating-point numbers are not in the bootstrap subset", start, line, column)
            return String{}
        }
    }
    if invalid || digits == 0 {
        stop(&cursor, "E0020", "invalid integer literal", start, line, column)
        return String{}
    }
    if radix != 10 {
        var i = magnitude.len()
        while i > 0 {
            i -= 1
            text.push("0123456789"[magnitude[i]..magnitude[i] + 1])
        }
    }
    if overflow || !integerLiteralFits(text) {
        stop(&cursor, "E0003", "integer literal is too large for any integer type", start, line, column)
        return String{}
    }
    return text
}

fn scalarText(value: int) -> String {
    var bytes: Vec[byte] = []
    if value <= 127 {
        bytes.push(byte(value))
    } else if value <= 2047 {
        bytes.push(byte(192 + value / 64))
        bytes.push(byte(128 + value % 64))
    } else if value <= 65535 {
        bytes.push(byte(224 + value / 4096))
        bytes.push(byte(128 + (value / 64) % 64))
        bytes.push(byte(128 + value % 64))
    } else {
        bytes.push(byte(240 + value / 262144))
        bytes.push(byte(128 + (value / 4096) % 64))
        bytes.push(byte(128 + (value / 64) % 64))
        bytes.push(byte(128 + value % 64))
    }
    let text = String.fromUtf8(bytes) catch _ {
        eprintln("internal lexer error: invalid Unicode scalar")
        os.exit(101)
    }
    return text
}

fn unicodeEscape(cursor: inout Cursor, source: str, start: int, line: int, column: int) -> String {
    if cursor.pos >= source.len() || source[cursor.pos] != '{' {
        stopWithEnd(detectedScalarEnd(source, cursor.pos), &cursor,
            "E0020", "invalid unicode escape; expected \\u{XXXX}", start, line, column)
        return String{}
    }
    bump(&cursor, source)
    var value = 0
    var digits = 0
    while cursor.pos < source.len() && source[cursor.pos] != '}' {
        let d = hexDigit(source[cursor.pos])
        if d < 0 || digits == 6 {
            stopWithEnd(detectedScalarEnd(source, cursor.pos), &cursor,
                "E0020", "invalid unicode escape; expected \\u{XXXX}", start, line, column)
            return String{}
        }
        value = value * 16 + d
        digits += 1
        bump(&cursor, source)
    }
    if digits == 0 || cursor.pos >= source.len() || value > 1114111 || (value >= 55296 && value <= 57343) {
        stopWithEnd(detectedScalarEnd(source, cursor.pos), &cursor,
            "E0020", "invalid unicode escape; expected a Unicode scalar", start, line, column)
        return String{}
    }
    bump(&cursor, source)
    return scalarText(value)
}

// Match Rust's string boundary scan. Quoted strings and their escapes hide
// braces/colons; only braces affect interpolation depth, not parentheses.
fn stringInterpolationRange(cursor: inout Cursor, source: str, start: int, line: int, column: int) -> InterpolationRange {
    var depth = 0
    var quoted = false
    var range = InterpolationRange{}
    while cursor.pos < source.len() {
        let c = source[cursor.pos]
        if c == '\n' { break }
        if c == '"' {
            quoted = !quoted
            bump(&cursor, source)
            continue
        }
        if quoted {
            if c == '\\' { bump(&cursor, source) }
            if cursor.pos < source.len() { bump(&cursor, source) }
            continue
        }
        if c == '{' { depth += 1
        } else if c == '}' {
            if depth == 0 {
                range.close = cursor.pos
                range.closeLine = cursor.line
                range.closeColumn = cursor.column
                if range.expressionEnd < 0 { range.expressionEnd = cursor.pos }
                bump(&cursor, source)
                return range
            }
            depth -= 1
        } else if c == ':' && depth == 0 && range.specStart < 0 {
            range.expressionEnd = cursor.pos
            range.specStart = cursor.pos + 1
            range.specLine = cursor.line
            range.specColumn = cursor.column + 1
        }
        bump(&cursor, source)
    }
    stop(&cursor, "E0020", "unterminated interpolation; expected '}'", start, line, column)
    return range
}

fn stringErrorToken(cursor: Cursor) -> Token {
    return Token{lineBase: cursor.lineBase, kind: .DeferredError, text: cursor.code.clone(),
        message: cursor.message.clone(), start: cursor.failOffset, end: cursor.failEnd,
        line: cursor.failLine, column: cursor.failColumn}
}

fn stringTokens(cursor: inout Cursor, source: str, tokens: inout Vec[Token], depth: int) {
    let start = cursor.pos
    let line = cursor.line
    let column = cursor.column
    if depth >= 128 {
        stopWithEnd(start + 1, &cursor, "U0001", "selfhost interpolation nesting limit (128) exceeded", start, line, column)
        return
    }
    bump(&cursor, source)
    var partStart = cursor.pos
    var partLine = cursor.line
    var partColumn = cursor.column
    var head = -1
    var text = String{}
    while cursor.pos < source.len() {
        let c = source[cursor.pos]
        if c == '\n' {
            stop(&cursor, "E0020", "unterminated string literal", start, line, column)
            return
        }
        if c == '"' {
            let close = cursor.pos
            let closeLine = cursor.line
            let closeColumn = cursor.column
            bump(&cursor, source)
            if head < 0 {
                tokens.push(Token{lineBase: cursor.lineBase, kind: .Text, text: take(&text), start: start,
                    end: cursor.pos, line: line, column: column})
            } else {
                if text.len() > 0 {
                    tokens.push(Token{lineBase: cursor.lineBase, kind: .Text, text: take(&text), start: partStart,
                        end: close, line: partLine, column: partColumn})
                }
                tokens.push(Token{lineBase: cursor.lineBase, kind: .StringEnd, text: String{}, start: close,
                    end: cursor.pos, line: closeLine, column: closeColumn})
            }
            return
        }
        if c == '\\' {
            let escapeStart = cursor.pos
            let escapeLine = cursor.line
            let escapeColumn = cursor.column
            bump(&cursor, source)
            if cursor.pos >= source.len() {
                stop(&cursor, "E0020", "unterminated string literal", start, line, column)
                return
            }
            let e = source[cursor.pos]
            bump(&cursor, source)
            if e == 'n' { text.push("\n")
            } else if e == 't' { text.push("\t")
            } else if e == 'r' { text.push("\r")
            } else if e == '0' { text.push("\0")
            } else if e == '\\' { text.push("\\")
            } else if e == '"' { text.push("\"")
            } else if e == '\'' { text.push("'")
            } else if e == '$' { text.push("$")
            } else if e == 'u' {
                let value = unicodeEscape(&cursor, source, escapeStart, escapeLine, escapeColumn)
                if cursor.failed { return }
                text.push(value)
            } else {
                stop(&cursor, "E0020", "unknown string escape sequence", escapeStart, escapeLine, escapeColumn)
                return
            }
        } else if c == '$' && cursor.pos + 1 < source.len() && source[cursor.pos + 1] == '{' {
            let at = cursor.pos
            let atLine = cursor.line
            let atColumn = cursor.column
            if head < 0 {
                head = tokens.len()
                tokens.push(Token{lineBase: cursor.lineBase, kind: .StringStart, text: String{}, start: start,
                    end: start + 1, line: line, column: column})
            }
            if text.len() > 0 {
                tokens.push(Token{lineBase: cursor.lineBase, kind: .Text, text: take(&text), start: partStart,
                    end: at, line: partLine, column: partColumn})
            }
            bump(&cursor, source)
            bump(&cursor, source)
            let expressionStart = cursor.pos
            let expressionLine = cursor.line
            let expressionColumn = cursor.column
            let range = stringInterpolationRange(&cursor, source, at, atLine, atColumn)
            if cursor.failed { return }
            tokens.push(Token{lineBase: cursor.lineBase, kind: .InterpolationStart, text: source[expressionStart..range.expressionEnd].toString(),
                start: expressionStart, end: range.expressionEnd,
                line: expressionLine, column: expressionColumn})
            var inner = Cursor{pos: expressionStart, line: expressionLine, column: expressionColumn,
                lineBase: cursor.lineBase}
            // The prefix preserves original offsets while bounding the re-lex.
            lexTokenRange(&inner, source[0..range.expressionEnd], &tokens, false, depth + 1)
            if inner.failed {
                tokens.push(stringErrorToken(inner))
            }
            if range.specStart >= 0 {
                tokens.push(Token{lineBase: cursor.lineBase, kind: .FormatSpec, text: source[range.specStart..range.close].toString(),
                    start: range.specStart, end: range.close,
                    line: range.specLine, column: range.specColumn})
            }
            tokens.push(Token{lineBase: cursor.lineBase, kind: .InterpolationEnd, text: String{},
                start: range.close, end: range.close + 1,
                line: range.closeLine, column: range.closeColumn})
            partStart = cursor.pos
            partLine = cursor.line
            partColumn = cursor.column
        } else {
            let first = cursor.pos
            bump(&cursor, source)
            text.push(source[first..cursor.pos])
        }
    }
    stop(&cursor, "E0020", "unterminated string literal", start, line, column)
}

// Byte token text is a canonical decimal value, independent of source escapes.
fn byteToken(cursor: inout Cursor, source: str) -> String {
    let start = cursor.pos
    let line = cursor.line
    let column = cursor.column
    bump(&cursor, source)
    var value = -1
    if cursor.pos < source.len() {
        let c = source[cursor.pos]
        bump(&cursor, source)
        if c == '\\' {
            if cursor.pos < source.len() {
                let e = source[cursor.pos]
                bump(&cursor, source)
                if e == 'n' { value = 10
                } else if e == 't' { value = 9
                } else if e == 'r' { value = 13
                } else if e == '0' { value = 0
                } else if e == '\\' { value = 92
                } else if e == '\'' { value = 39
                } else if e == '"' { value = 34
                }
            }
        } else if c < 128 && c != '\'' && c != '\n' {
            value = int(c)
        }
    }
    var closed = false
    if cursor.pos < source.len() && source[cursor.pos] == '\'' {
        bump(&cursor, source)
        closed = true
    }
    if value < 0 || !closed {
        stop(&cursor, "E0020", "invalid byte literal; expected one ASCII character or a byte escape", start, line, column)
        return String{}
    }
    return support.decimal(value)
}

fn twoSymbol(a: byte, b: byte) -> bool {
    if a == '+' || a == '-' || a == '*' {
        if b == '=' || b == '%' { return true }
        return a == '-' && b == '>'
    }
    if a == '/' || a == '%' || a == '!' { return b == '=' }
    if a == '=' { return b == '=' || b == '>' }
    if a == '<' { return b == '=' || b == '<' }
    if a == '>' { return b == '=' || b == '>' }
    if a == '&' { return b == '&' }
    if a == '|' { return b == '|' }
    if a == '.' { return b == '.' }
    if a == '?' { return b == '?' }
    return false
}

fn oneSymbol(c: byte) -> bool {
    return c == '+' || c == '-' || c == '*' || c == '/' || c == '%' ||
        c == '<' || c == '>' || c == '=' || c == '!' || c == '&' ||
        c == '|' || c == '^' || c == '(' || c == ')' || c == '{' ||
        c == '}' || c == '[' || c == ']' || c == ',' || c == ':' ||
        c == '.' || c == '?'
}

fn withoutLast(values: Vec[byte]) -> Vec[byte] {
    var out: Vec[byte] = []
    var i = 0
    while i + 1 < values.len() {
        out.push(values[i])
        i += 1
    }
    return out
}

fn lexFailure(cursor: Cursor) -> Diagnostic {
    return Diagnostic{code: cursor.code.clone(),
        message: cursor.message.clone(), offset: cursor.failOffset, endOffset: cursor.failEnd,
        line: cursor.failLine, column: cursor.failColumn}
}

fn lexTokenRange(cursor: inout Cursor, source: str, tokens: inout Vec[Token], finalNewline: bool, depth: int) {
    var delimiters: Vec[byte] = []
    var endsStatement = false
    while cursor.pos < source.len() {
        let start = cursor.pos
        let line = cursor.line
        let column = cursor.column
        let c = source[start]
        if c == ' ' || c == '\t' || c == '\r' {
            bump(&cursor, source)
            continue
        }
        if c == '\n' {
            bump(&cursor, source)
            var significant = delimiters.len() == 0
            if delimiters.len() > 0 {
                significant = delimiters[delimiters.len() - 1] == '{'
            }
            if significant && endsStatement {
                tokens.push(Token{lineBase: cursor.lineBase, kind: .Newline, text: String{}, start: start, end: start + 1, line: line, column: column})
                endsStatement = false
            }
            continue
        }
        if c == '/' && start + 1 < source.len() && source[start + 1] == '/' {
            while cursor.pos < source.len() && source[cursor.pos] != '\n' {
                bump(&cursor, source)
            }
            continue
        }
        if c == '/' && start + 1 < source.len() && source[start + 1] == '*' {
            stopWithEnd(start + 2, &cursor, "E0020", "block comments are not part of Yavo; use // on each line", start, line, column)
            return
        }
        var kind: TokenKind = .Symbol
        var text = String{}
        if wordStart(c) {
            bump(&cursor, source)
            while cursor.pos < source.len() && (wordStart(source[cursor.pos]) || digit(source[cursor.pos])) {
                bump(&cursor, source)
            }
            kind = .Word
            text = source[start..cursor.pos].toString()
        } else if digit(c) {
            kind = .Number
            let afterDot = tokens.len() > 0 && tokens[tokens.len() - 1].kind == .Symbol && tokens[tokens.len() - 1].text == "."
            text = integerToken(&cursor, source, start, line, column, afterDot)
            if cursor.failed { return }
        } else if c == '"' {
            stringTokens(&cursor, source, &tokens, depth)
            if cursor.failed { return }
            endsStatement = true
            continue
        } else if c == '\'' {
            kind = .Byte
            text = byteToken(&cursor, source)
            if cursor.failed { return }
        } else if oneSymbol(c) {
            bump(&cursor, source)
            if cursor.pos < source.len() && twoSymbol(c, source[cursor.pos]) {
                bump(&cursor, source)
            }
            text = source[start..cursor.pos].toString()
        } else {
            stopWithEnd(detectedScalarEnd(source, start), &cursor, "E0020", "unexpected character", start, line, column)
            return
        }
        endsStatement = kind == .Word || kind == .Number || kind == .Text || kind == .Byte ||
            text == ")" || text == "]" || text == "}"
        if kind == .Symbol {
            if text == "(" || text == "[" { delimiters.push('(')
            } else if text == "{" { delimiters.push('{')
            } else if text == ")" || text == "]" || text == "}" {
                // Delimiter matching belongs to the parser; this mirrors Rust lexer's stack.
                if delimiters.len() > 0 { delimiters = withoutLast(delimiters) }
            }
        }
        tokens.push(Token{lineBase: cursor.lineBase, kind: kind, text: text, start: start, end: cursor.pos, line: line, column: column})
    }
    if finalNewline && endsStatement {
        tokens.push(Token{lineBase: cursor.lineBase, kind: .Newline, text: String{}, start: cursor.pos, end: cursor.pos, line: cursor.line, column: cursor.column})
    }
}

// Appends one file's tokens, ending with an Eof token whose text is the path.
// Several files share one token vector; each file's tokens end at its own Eof.
// JSON mode keeps the exact loaded bytes and their identity on that Eof only.
pub fn lexIntoMode(source: str, path: str, tokens: inout Vec[Token], jsonMode: bool) -> int ! Diagnostic {
    let firstToken = tokens.len()
    var cursor = Cursor{}
    if firstToken > 0 {
        // Generated programs number lines across files; each file starts after
        // the previous file's last line (stage0's runtime source table).
        cursor.lineBase = tokens[firstToken - 1].lineBase + tokens[firstToken - 1].line
    }
    lexTokenRange(&cursor, source, &tokens, true, 0)
    if cursor.failed {
        // Keep an earlier interpolation lexical fault when a later outer
        // lexical fault aborts the file. General multi-error recovery is not
        // part of this first-error frontend.
        var first = -1
        var i = firstToken
        while i < tokens.len() {
            if tokens[i].kind == .DeferredError && tokens[i].start < cursor.failOffset {
                if first < 0 || tokens[i].start < tokens[first].start { first = i }
            }
            i += 1
        }
        if first >= 0 {
            return err(Diagnostic{code: tokens[first].text.clone(),
                message: tokens[first].message.clone(), offset: tokens[first].start,
                endOffset: tokens[first].end,
                line: tokens[first].line, column: tokens[first].column})
        }
        return err(lexFailure(cursor))
    }
    var snapshot = String{}
    var sourceHash = String{}
    if jsonMode {
        snapshot = source.toString()
        let identity = support.identify(path, source)
        sourceHash = identity.sha256.clone()
    }
    tokens.push(Token{lineBase: cursor.lineBase, kind: .Eof, text: path.toString(),
        start: cursor.pos, end: cursor.pos, line: cursor.line, column: cursor.column,
        jsonMode: jsonMode, sourceSnapshot: snapshot, sourceSha256: sourceHash})
    return ok(tokens.len() - 1)
}

pub fn lexInto(source: str, path: str, tokens: inout Vec[Token]) -> int ! Diagnostic {
    let eof = try lexIntoMode(source, path, &tokens, false)
    return ok(eof)
}

pub fn lex(source: str, path: str) -> Vec[Token] ! Diagnostic {
    var tokens: Vec[Token] = []
    let _ = try lexInto(source, path, &tokens)
    return ok(tokens)
}
