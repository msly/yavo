// Command-line entry. The input is fully lexed, parsed, checked and lowered
// before the output file is created; any diagnostic stops the process first.

fn usage() {
    eprintln("usage: yavo-selfhost check <input.yv>")
    eprintln("       yavo-selfhost emit-c <input.yv> -o <output.c>")
    os.exit(2)
}

fn compile(source: str, path: str) -> String {
    let lexed = lex(source, path)
    if lexed.failed {
        report(path, lexed.line, lexed.column, lexed.code, lexed.message)
    }
    let program = parse(lexed.tokens)
    return generate(program, lexed.tokens, path)
}

fn main() {
    let args = os.args()
    if args.len() < 3 { usage() }
    let checkMode = args[1] == "check"
    let emitMode = args[1] == "emit-c"
    if !checkMode && !emitMode { usage() }
    if checkMode && args.len() != 3 { usage() }
    if emitMode && (args.len() != 5 || args[3] != "-o") { usage() }
    if emitMode && args[2] == args[4] {
        eprintln("refusing to overwrite the source file")
        os.exit(2)
    }
    let source = fs.readText(args[2]) catch _ {
        eprintln("cannot read input")
        os.exit(3)
    }
    let generated = compile(source, args[2])
    if emitMode {
        fs.writeNewText(args[4], generated) catch _ {
            eprintln("cannot write output")
            os.exit(3)
        }
    }
}
