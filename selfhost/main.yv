use std/{fs, os}
use support
use lexer
use model
use parser
use codegen

// Command-line entry. The input is fully lexed, parsed, checked and lowered
// before the output file is created; any diagnostic stops the process first.

fn usage() {
    eprintln("usage: yavo-selfhost check <input.yv>")
    eprintln("       yavo-selfhost emit-c <input.yv> -o <output.c>")
    os.exit(2)
}

// `a/b/c` for an import; module files are named relative to the entry directory.
fn moduleKey(ts: Vec[Token], item: ModuleImport) -> String {
    var key = String{}
    var i = 0
    while i < item.prefixCount {
        key.push(ts[item.prefixStart + 2 * i].text)
        key.push("/")
        i += 1
    }
    key.push(ts[item.alias].text)
    return key
}

// Loads the entry file and every module it reaches, breadth first. File index
// k is the k-th distinct module path; a cycle or self-import reuses its index.
fn compile(source: str, path: str) -> String ! Diagnostic {
    var tokens: Vec[Token] = []
    let _ = try lexer.lexInto(source, path, &tokens)
    var cut = -1
    var i = 0
    while i < path.len() {
        if path[i] == '/' || path[i] == '\\' { cut = i }
        i += 1
    }
    var stemEnd = path.len()
    if path.len() - cut > 3 && path.endsWith(".yv") { stemEnd = path.len() - 3 }
    var keys: Vec[String] = [path[cut + 1..stemEnd].toString()]
    var paths: Vec[String] = [path.toString()]
    var sites: Vec[int] = [-1]
    var state = parser.startParse()
    var file = 0
    while file < keys.len() {
        if file > 0 {
            let text = fs.readText(paths[file]) catch _ {
                lexer.fail(tokens, sites[file], "E0010", support.join3("cannot load module '", keys[file], "'"))
                os.exit(1)
            }
            let _ = lexer.lexInto(text, paths[file], &tokens) catch problem {
                support.report(paths[file], problem.line, problem.column, problem.code, problem.message)
                os.exit(1)
            }
        }
        parser.parseFile(&state, tokens)
        let start = state.files[file].importStart
        var j = 0
        while j < state.files[file].importCount {
            let key = moduleKey(tokens, state.imports[start + j])
            var found = -1
            var k = 0
            while k < keys.len() {
                if keys[k] == key { found = k }
                k += 1
            }
            if found < 0 {
                found = keys.len()
                var modulePath = path[0..cut + 1].toString()
                modulePath.push(key)
                modulePath.push(".yv")
                paths.push(modulePath)
                sites.push(state.imports[start + j].alias)
                keys.push(key)
            }
            state.imports[start + j].file = found
            j += 1
        }
        file += 1
    }
    let program = parser.finishParse(&state)
    return ok(codegen.generate(program, tokens, path))
}

fn main() {
    let args = os.args()
    if args.len() < 3 { usage() }
    let checkMode = args[1] == "check"
    let emitMode = args[1] == "emit-c"
    if !checkMode && !emitMode { usage() }
    if checkMode && args.len() != 3 { usage() }
    if emitMode && (args.len() != 5 || args[3] != "-o") { usage() }
    if emitMode && args[2] == args[4] {
        eprintln("refusing to overwrite the source file")
        os.exit(2)
    }
    let source = fs.readText(args[2]) catch _ {
        eprintln("cannot read input")
        os.exit(3)
    }
    let generated = compile(source, args[2]) catch diagnostic {
        support.report(args[2], diagnostic.line, diagnostic.column, diagnostic.code, diagnostic.message)
        os.exit(1)
    }
    if emitMode {
        fs.writeNewText(args[4], generated) catch _ {
            eprintln("cannot write output")
            os.exit(3)
        }
    }
}
