use std/{fs, os}
use support
use lexer
use model
use parser
use codegen
use driver

// Command-line entry. The input is fully lexed, parsed, checked and lowered
// before the output file is created; any diagnostic stops the process first.

fn usage() {
    eprintln("usage: yavo-selfhost check <input.yv> [--json | --json-diagnostics]")
    eprintln("       yavo-selfhost emit-c <input.yv> -o <output.c>")
    driver.usage()
}

struct Compilation {
    generated: String
    sources: Vec[String]
    identities: Vec[SourceIdentity]
}

fn jsonFlag(value: str) -> bool {
    return value == "--json" || value == "--json-diagnostics"
}

fn rootDiagnostic(jsonMode: bool, path: str, source: str, problem: Diagnostic) {
    if jsonMode {
        let identities = [support.identify(path, source)]
        support.reportJson(identities, source, path, problem.offset, problem.endOffset,
                           problem.code, problem.message)
    }
    support.report(path, problem.line, problem.column, problem.code, problem.message)
}

// `a/b/c` for an import; module files are named relative to the entry directory.
fn moduleKey(ts: Vec[Token], item: ModuleImport) -> String {
    var key = String{}
    var i = 0
    while i < item.prefixCount {
        key.push(ts[item.prefixStart + 2 * i].text)
        key.push("/")
        i += 1
    }
    key.push(ts[item.alias].text)
    return key
}

// Loads the entry file and every module it reaches, breadth first. File index
// k is the k-th distinct module path; a cycle or self-import reuses its index.
fn compile(source: str, path: str, jsonMode: bool) -> Compilation ! Diagnostic {
    var tokens: Vec[Token] = []
    let _ = try lexer.lexIntoMode(source, path, &tokens, jsonMode)
    var cut = -1
    var i = 0
    while i < path.len() {
        if path[i] == '/' || path[i] == '\\' { cut = i }
        i += 1
    }
    var stemEnd = path.len()
    if path.len() - cut > 3 && path.endsWith(".yv") { stemEnd = path.len() - 3 }
    var keys: Vec[String] = [path[cut + 1..stemEnd].toString()]
    var paths: Vec[String] = [path.toString()]
    var sites: Vec[int] = [-1]
    // Module key -> file index; keys[i] is the key of file i.
    var fileIndex: Map[String, int] = [:]
    fileIndex.set(keys[0].clone(), 0)
    var state = parser.startParse()
    var file = 0
    while file < keys.len() {
        if file > 0 {
            let text = fs.readText(paths[file]) catch _ {
                lexer.fail(tokens, sites[file], "E0010", support.join3("cannot load module '", keys[file], "'"))
                os.exit(1)
            }
            let _ = lexer.lexIntoMode(text, paths[file], &tokens, jsonMode) catch problem {
                if jsonMode {
                    var identities = lexer.sourceIdentities(tokens)
                    identities.push(support.identify(paths[file], text))
                    support.reportJson(identities, text, paths[file], problem.offset,
                                       problem.endOffset, problem.code, problem.message)
                }
                support.report(paths[file], problem.line, problem.column, problem.code, problem.message)
                os.exit(1)
            }
        }
        parser.parseFile(&state, tokens)
        let start = state.files[file].importStart
        var j = 0
        while j < state.files[file].importCount {
            let key = moduleKey(tokens, state.imports[start + j])
            var found = fileIndex.getCopy(key) ?? -1
            if found < 0 {
                found = keys.len()
                var modulePath = path[0..cut + 1].toString()
                modulePath.push(key)
                modulePath.push(".yv")
                paths.push(modulePath)
                sites.push(state.imports[start + j].alias)
                fileIndex.set(key.clone(), found)
                keys.push(key)
            }
            state.imports[start + j].file = found
            j += 1
        }
        file += 1
    }
    let program = parser.finishParse(&state)
    return ok(Compilation{generated: codegen.generate(program, tokens, path), sources: paths,
                          identities: lexer.sourceIdentities(tokens)})
}

fn command(args: []str) -> int {
    if args.len() < 2 {
        usage()
        return 2
    }
    if args[1] == "build" || args[1] == "run" {
        let options = driver.parse(args) catch problem {
            eprintln(problem.message)
            usage()
            return problem.status
        }
        let source = fs.readText(options.input) catch _ {
            eprintln("cannot read input")
            return 3
        }
        let compiled = compile(source, options.input, false) catch diagnostic {
            support.report(options.input, diagnostic.line, diagnostic.column,
                           diagnostic.code, diagnostic.message)
            return 1
        }
        return driver.execute(options, compiled.generated, compiled.sources, args)
    }
    if args.len() < 3 {
        usage()
        return 2
    }
    let checkMode = args[1] == "check"
    let emitMode = args[1] == "emit-c"
    if !checkMode && !emitMode {
        usage()
        return 2
    }
    var input = 2
    var jsonMode = false
    if checkMode {
        if args.len() == 4 && (jsonFlag(args[2]) || jsonFlag(args[3])) {
            jsonMode = true
            if jsonFlag(args[2]) { input = 3 }
        } else if args.len() != 3 {
            usage()
            return 2
        }
        // The original three-argument text form treats its argument as a path.
        // Only the two new mode spellings are reserved; JSON forms parse flags.
        if jsonFlag(args[input]) || (jsonMode && args[input].startsWith("-")) {
            usage()
            return 2
        }
    }
    if emitMode && (args.len() != 5 || args[3] != "-o") {
        usage()
        return 2
    }
    if emitMode && args[2] == args[4] {
        eprintln("refusing to overwrite the source file")
        return 2
    }
    let source = fs.readText(args[input]) catch _ {
        eprintln("cannot read input")
        return 3
    }
    let compiled = compile(source, args[input], jsonMode) catch diagnostic {
        rootDiagnostic(jsonMode, args[input], source, diagnostic)
        return 1
    }
    if emitMode {
        fs.writeNewText(args[4], compiled.generated) catch _ {
            eprintln("cannot write output")
            return 3
        }
    }
    if checkMode && jsonMode { support.successJson(compiled.identities) }
    return 0
}

fn main() {
    // The command frame drops its owned source/options/generated text before
    // forwarding a program status. All ordinary back-end paths have cleaned up.
    let status = command(os.args())
    if status != 0 { os.exit(status) }
}
