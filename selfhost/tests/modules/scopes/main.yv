use geom
use other

struct Rect {
    z: int
}

fn area(r: Rect) -> int {
    return r.z * 100
}

fn main() {
    let mine = Rect{z: 2}
    let theirs = geom.Rect{w: 1, h: 2}
    println(area(mine))
    println(geom.area(theirs))
    println(other.area(other.Rect{side: 3}))
    println(other.main())
    let geom = 7
    println(geom)
}
