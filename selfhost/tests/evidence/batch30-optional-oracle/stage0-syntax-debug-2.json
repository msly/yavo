      "id": "vec_pop_rewind",
      "kind": "run",
      "file": "run/vec_pop_rewind.yv",
      "source": "struct Slot {\n    index: int\n    active: bool\n}\nfn rewind(values: inout Vec[Slot], count: int) {\n    while values.len() > count { let _ = values.pop() }\n}\nfn main() {\n    var values: Vec[Slot] = []\n    var index = 0\n    while index < 40 {\n        values.push(Slot{index: index, active: true})\n        index += 1\n    }\n    rewind(&values, 5)\n    println(values.len())\n    println((values.pop() ?? Slot{index: -1, active: false}).index)\n    rewind(&values, 2)\n    values.push(Slot{index: 99, active: false})\n    println((values.pop() ?? Slot{index: -1, active: false}).index)\n    rewind(&values, 0)\n    println(values.pop().isNone())\n    index = 0\n    while index < 40 {\n        let _ = values.pop()\n        index += 1\n    }\n    println(values.len())\n}\n",
