fn bytes(value: (byte, byte)) -> (byte, byte) { return value }
fn main() {
 let hinted = bytes((65, 66))
 println("${int(hinted.0)} ${int(hinted.1)}")
 let fallback: (byte, byte) = none ?? (67, 68)
 println("${int(fallback.0)} ${int(fallback.1)}")
 let wrapped: ?(byte, byte) = some((69, 70))
 let present = wrapped ?? (0, 0)
 println("${int(present.0)} ${int(present.1)}")
 let choice: (byte, byte) = some((71, 72)) ?? (73, 74)
 println("${int(choice.0)} ${int(choice.1)}")
}
