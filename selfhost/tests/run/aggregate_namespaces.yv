struct Item { auto: int, union: bool }
fn Item() -> int { return 3 }
enum Kind { A, B }
struct Holder { A: int }
fn main() {
    println(Item())
    let Item = 7
    let value = Item{auto: Item, union: true}
    println(value.auto)
    println(value.union)
    let Kind = Holder{A: 9}
    println(Kind.A)
}
