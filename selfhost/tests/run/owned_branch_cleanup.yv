fn branch(flag: bool) {
    let text = "branch".toString()
    if flag {
        let moved = text
        println(moved)
    } else {
        let local = "other".toString()
        println(local)
    }
}
fn main() {
    branch(true)
    branch(false)
    let value = "condition".toString()
    if value.clone() == "condition" {
        let inner = "inside".toString()
        println(inner)
    }
}
