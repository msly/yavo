struct Row {
    text: String
}
fn main() {
    let owner = "owner".toString()
    let values = ["value".toString()]
    println("${owner}:${owner[0..2]}:${Row{text: "own".toString()}.text}:${values[0]}:${"汉🙂".toString()[0..3]}")
    let staticView = "static"[0..3][1..2]
    println("${owner[0..2][0..1]}:${staticView}")
}
