fn main() {
    var numbers = [1, 2]
    println(numbers.pop() ?? -1)
    println(numbers.pop() ?? -1)
    println(numbers.pop() ?? -1)
    var flags = [false]
    println(flags.pop() ?? true)
    println(flags.pop() ?? true)
    var bytes: Vec[byte] = ['a', 'z']
    println(int(bytes.pop() ?? '!'))
    println(int(bytes.pop() ?? '!'))
    println(int(bytes.pop() ?? '!'))
    println(numbers.pop().isNone())
}
