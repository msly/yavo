fn squares(n: int) -> Vec[int] {
    var values: Vec[int] = []
    var i = 0
    while i < n {
        values.push(i * i)
        i += 1
    }
    return values
}
fn total(values: Vec[int]) -> int {
    var sum = 0
    var i = 0
    while i < values.len() {
        sum += values[i]
        i += 1
    }
    return sum
}
fn main() {
    let values = squares(5)
    println(total(values))
    println(values.len())
    println(total([8, 9]))
}
