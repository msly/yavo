fn show(text: str) {
    println(text)
}

fn make(text: str) -> String {
    return text.toString()
}

fn main() {
    let literal = "hello world"
    println(literal[0..5])
    show(literal[6..11])
    let owned = "汉字🙂ok".toString()
    println(owned[0..3])
    println(owned[3..6])
    println(owned[6..10])
    println(owned[10..owned.len()])
    println(owned[0..0].len())
    var built = String{}
    built.push(owned[6..10])
    built.push(literal[5..6])
    built.push(make("abc")[1..3])
    println(built)
    let copy = owned[3..6].toString()
    println(copy)
    println(literal[0..5] == "hello")
    println(owned[10..12] < "ol")
    println(make("xyz")[0..1] == "x")
    var i = 0
    var digits = String{}
    while i < 10 {
        digits.push("0123456789"[9 - i..10 - i])
        i += 2
    }
    println(digits)
}
