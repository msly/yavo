fn swap(pair: inout (int, int)) { let before = pair
 pair = (before.1, before.0) }
fn set(value: inout ?(int, int)) { value = some((5, 6)) }
fn main() {
 var pair = (1, 2)
 let original = pair
 swap(&pair)
 println("${original.0} ${original.1} ${pair.0} ${pair.1}")
 pair = (pair.1, pair.0)
 println("${pair.0} ${pair.1}")
 var optional: ?(int, int) = none
 set(&optional)
 if let value = optional { println("${value.0} ${value.1}") }
}
