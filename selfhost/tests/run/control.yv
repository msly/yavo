fn classify(n: int) -> int {
    if n < 0 { return -1 } else if n == 0 { return 0 } else { return 1 }
}
fn main() {
    var i = 0
    var total = 0
    while i < 8 {
        i += 1
        if i == 3 { continue }
        if i == 7 { break }
        total += i
    }
    println(total)
    var j = 0
    loop {
        j += 1
        if j == 3 { break }
    }
    println(j)
    println(classify(-1))
    println(classify(0))
    println(classify(4))
}
