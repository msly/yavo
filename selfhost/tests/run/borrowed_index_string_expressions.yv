fn size(text: str) -> int { return text.len() }
fn same(left: String, right: String) -> bool { return left == right }
fn main() {
    var words = ["alpha".toString(), "beta".toString(), String{}]
    println(words[0])
    println(words[1].len())
    println(words[2] == "")
    println(words[0] < words[1])
    println("alpha" == words[0])
    println(same(words[0], words[0]))
    println(size(words[1]))
    let _ = words[0]
    words.push("last".toString())
    println(words[3])
}
