struct Group {
    title: String
    words: Vec[String]
}
fn piece(tag: str) -> String {
    print(tag)
    return tag.toString()
}
fn stop() -> String ! String {
    print("E")
    return err("stop".toString())
}
fn build() -> Vec[Group] ! String {
    return [Group{title: piece("A"), words: [piece("B")]}, Group{title: piece("C"), words: [piece("D"), try stop()]}, Group{title: piece("Z"), words: []}]
}
fn main() {
    let values = build() catch error {
        println(error)
        return
    }
    println(values.len())
}
