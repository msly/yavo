fn main() {
    var m: Map[String, int] = [:]
    var i = 0
    while i < 100 {
        m.set(format("k${i % 10}"), i)
        i += 1
    }
    println(m.len())
    println(m.getCopy("k3") ?? -1)
    var j = 0
    while j < 10 {
        let _ = m.remove(format("k${j}"))
        j += 2
    }
    println(m.len())
    m.set("k0".toString(), 1)
    println(m.getCopy("k0") ?? -1)
}
