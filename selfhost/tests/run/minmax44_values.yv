fn main() {
 println("${min(3, 7)} ${max(3, 7)}")
 println("${min(-8, -3)} ${max(-8, -3)}")
 println("${min(5, 5)} ${max(0, 0)}")
 println(min(9223372036854775807, -9223372036854775808))
 println(max(-9223372036854775808, 9223372036854775807))
 var low = 100
 var high = -100
 for value in [-2, 7, 0] { low = min(low, value)
  high = max(high, value) }
 println("${low} ${high}")
}
