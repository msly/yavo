fn pick(first: bool) -> int {
    var values = [3, 1, 2]
    let _ = values.sort()
    if first { return values[0] }
    return values[2]
}
fn main() {
    assert(pick(true) == 1 && pick(false) == 3)
    var total = 0
    for i in 0..4 {
        var values = [i + 1, i, 0]
        let _ = values.sort()
        if i == 1 { continue }
        if i == 3 { break }
        total += values[2]
    }
    assert(total == 4)
    println("sort flow ok")
}
