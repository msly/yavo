fn step(index: int) -> String ! String {
    if index == 2 { return err("stop".toString()) }
    return "ok".toString()
}
fn work() -> int ! String {
    let outer = ["outside".toString()]
    var index = 0
    while index < 4 {
        let inner = ["inside".toString()]
        let value = try step(index)
        println(index)
        index += 1
    }
    return index
}
fn main() {
    let value = work() catch error {
        println(error)
        return
    }
    println(value)
}
