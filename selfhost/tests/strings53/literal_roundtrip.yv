// Every ASCII byte, C escape boundaries, C17 trigraphs and UTF-8 round-trip.
fn main() {
    print("\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f} !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\u{7f}")
    print("|octal:\u{1}0123456789\u{7}777\u{0}09\u{7f}9|")
    print("|trigraphs:??= ??/ ??' ??( ??) ??! ??< ??> ??-|")
    print("|quotes:\"\" backslashes:\\\\\\ end:\\|")
    print("|unicode:é漢🙂|\u{a}")
}
