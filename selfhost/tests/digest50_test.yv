use digest

fn repeated(unit: str, count: int, suffix: str) -> String {
    var text = String{}
    for _item in 0..count { text.push(unit) }
    text.push(suffix)
    return text
}

fn main() {
    print("empty\t")
    println(digest.sha256(repeated("", 1, "")))
    print("abc\t")
    println(digest.sha256(repeated("abc", 1, "")))
    print("nist-56\t")
    println(digest.sha256(repeated("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", 1, "")))
    print("nist-112\t")
    println(digest.sha256(repeated("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", 1, "")))
    print("quick-fox\t")
    println(digest.sha256(repeated("The quick brown fox jumps over the lazy dog", 1, "")))
    print("quick-fox-dot\t")
    println(digest.sha256(repeated("The quick brown fox jumps over the lazy dog.", 1, "")))
    print("ascii-0\t")
    println(digest.sha256(repeated("a", 0, "")))
    print("ascii-1\t")
    println(digest.sha256(repeated("a", 1, "")))
    print("ascii-2\t")
    println(digest.sha256(repeated("a", 2, "")))
    print("ascii-3\t")
    println(digest.sha256(repeated("a", 3, "")))
    print("ascii-7\t")
    println(digest.sha256(repeated("a", 7, "")))
    print("ascii-15\t")
    println(digest.sha256(repeated("a", 15, "")))
    print("ascii-31\t")
    println(digest.sha256(repeated("a", 31, "")))
    print("ascii-54\t")
    println(digest.sha256(repeated("a", 54, "")))
    print("ascii-55\t")
    println(digest.sha256(repeated("a", 55, "")))
    print("ascii-56\t")
    println(digest.sha256(repeated("a", 56, "")))
    print("ascii-57\t")
    println(digest.sha256(repeated("a", 57, "")))
    print("ascii-62\t")
    println(digest.sha256(repeated("a", 62, "")))
    print("ascii-63\t")
    println(digest.sha256(repeated("a", 63, "")))
    print("ascii-64\t")
    println(digest.sha256(repeated("a", 64, "")))
    print("ascii-65\t")
    println(digest.sha256(repeated("a", 65, "")))
    print("ascii-66\t")
    println(digest.sha256(repeated("a", 66, "")))
    print("ascii-95\t")
    println(digest.sha256(repeated("a", 95, "")))
    print("ascii-111\t")
    println(digest.sha256(repeated("a", 111, "")))
    print("ascii-112\t")
    println(digest.sha256(repeated("a", 112, "")))
    print("ascii-113\t")
    println(digest.sha256(repeated("a", 113, "")))
    print("ascii-127\t")
    println(digest.sha256(repeated("a", 127, "")))
    print("ascii-128\t")
    println(digest.sha256(repeated("a", 128, "")))
    print("ascii-129\t")
    println(digest.sha256(repeated("a", 129, "")))
    print("ascii-255\t")
    println(digest.sha256(repeated("a", 255, "")))
    print("ascii-256\t")
    println(digest.sha256(repeated("a", 256, "")))
    print("ascii-257\t")
    println(digest.sha256(repeated("a", 257, "")))
    print("ascii-511\t")
    println(digest.sha256(repeated("a", 511, "")))
    print("ascii-512\t")
    println(digest.sha256(repeated("a", 512, "")))
    print("ascii-513\t")
    println(digest.sha256(repeated("a", 513, "")))
    print("ascii-1024\t")
    println(digest.sha256(repeated("a", 1024, "")))
    print("ascii-4096\t")
    println(digest.sha256(repeated("a", 4096, "")))
    print("unicode-nul\t")
    println(digest.sha256(repeated("A\0é中😀\r\n尾\0", 1, "")))
    print("unicode-55\t")
    println(digest.sha256(repeated("é", 27, "a")))
    print("unicode-56\t")
    println(digest.sha256(repeated("é", 28, "")))
    print("unicode-63\t")
    println(digest.sha256(repeated("汉", 21, "")))
    print("unicode-64\t")
    println(digest.sha256(repeated("🙂", 16, "")))
    print("ascii-controls\t")
    println(digest.sha256(repeated("\0\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\t\n\u{b}\u{c}\r\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f} !\"#\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\u{7f}", 1, "")))
    print("unicode-scalars\t")
    println(digest.sha256(repeated("\u{7f}߿ࠀ￿𐀀􏿿", 1, "")))
    print("multiblock-unicode\t")
    println(digest.sha256(repeated("首行\r\n第二行\0🙂\t", 179, "")))
    print("million-a\t")
    println(digest.sha256(repeated("a", 1000000, "")))
}
