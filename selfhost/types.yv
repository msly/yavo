use support
use lexer
use model

// Resolved aggregates for the bootstrap compiler. Type identity is a
// registry index for named types, and a collision-free structural code for flat
// Copy tuples; source names remain lexer token indices throughout checking.

pub struct Type {
    kind: BasicType
    decl: int = -1
    elementKind: BasicType
    elementDecl: int = -1
}

pub struct Field {
    name: int
    ty: Type
    initial: int = -1
}

// fieldStart/fieldCount index Registry.fields; variants index Registry.variants.
pub struct Info {
    kind: AggregateKind
    name: int
    fieldStart: int = 0
    fieldCount: int = 0
    variantStart: int = 0
    variantCount: int = 0
    owned: bool = false
    file: int = 0
    public: bool = false
}

pub struct ResultInfo {
    ok: Type
    error: Type
}

pub struct Registry {
    entries: Vec[Info] = []
    fields: Vec[Field] = []
    variants: Vec[int] = []
    order: Vec[int] = []
    results: Vec[ResultInfo] = []
    resultRefs: Vec[int] = []
    tupleAtoms: Vec[TypeRef] = []
    files: Vec[SourceFile] = []
    imports: Vec[ModuleImport] = []
}

pub fn primitive(kind: BasicType) -> Type {
    return Type{elementKind: .Unknown, kind: kind}
}

pub fn element(ty: Type) -> Type {
    return Type{kind: ty.elementKind, decl: ty.elementDecl, elementKind: .Unknown}
}

pub fn resultOk(reg: Registry, ty: Type) -> Type {
    return reg.results[ty.decl].ok
}

pub fn resultError(reg: Registry, ty: Type) -> Type {
    return reg.results[ty.decl].error
}

pub fn same(a: Type, b: Type) -> bool {
    // os.args() is a static []str.
    if (a.kind == .Args && b.kind == .Slice && b.elementKind == .Str) ||
        (b.kind == .Args && a.kind == .Slice && a.elementKind == .Str) {
        return true
    }
    if a.kind != b.kind { return false }
    if a.kind == .Named || a.kind == .Result || a.kind == .Tuple { return a.decl == b.decl }
    if a.kind == .Vec || a.kind == .Optional || a.kind == .Slice || a.kind == .Map || a.kind == .Set {
        return a.elementKind == b.elementKind &&
            ((a.elementKind != .Named && a.elementKind != .Tuple) || a.elementDecl == b.elementDecl)
    }
    return true
}

pub fn owned(reg: Registry, ty: Type) -> bool {
    if ty.kind == .String || ty.kind == .Vec || ty.kind == .Map || ty.kind == .Set { return true }
    // optional() admits only Copy payloads after named ownership is known.
    if ty.kind == .Optional { return false }
    if ty.kind == .Result {
        return owned(reg, resultOk(reg, ty)) || owned(reg, resultError(reg, ty))
    }
    return ty.kind == .Named && reg.entries[ty.decl].owned
}

// Values that point into data they do not own: str, Vec[str] and []T in this subset.
pub fn carriesBorrow(ty: Type) -> bool {
    return ty.kind == .Str || ty.kind == .Slice || (ty.kind == .Vec && ty.elementKind == .Str)
}

pub fn fieldOf(reg: Registry, decl: int, index: int) -> Field {
    return reg.fields[reg.entries[decl].fieldStart + index]
}

pub fn cType(t: Type) -> String {
    if t.kind == .Int { return "int64_t".toString() }
    if t.kind == .Byte { return "uint8_t".toString() }
    if t.kind == .Bool { return "bool".toString() }
    if t.kind == .Str { return "yv_str".toString() }
    if t.kind == .String { return "yv_string".toString() }
    if t.kind == .Vec || t.kind == .Args || t.kind == .Slice { return "yv_vec".toString() }
    if t.kind == .Map || t.kind == .Set { return "yv_map".toString() }
    if t.kind == .Named { return support.join2("sh_type_", support.decimal(t.decl)) }
    if t.kind == .Result { return support.join2("sh_result_", support.decimal(t.decl)) }
    if t.kind == .Tuple { return support.join2("sh_tuple_", support.decimal(t.decl)) }
    if t.kind == .Optional {
        if t.elementKind == .Int { return "sh_optional_int".toString() }
        if t.elementKind == .Byte { return "sh_optional_byte".toString() }
        if t.elementKind == .Bool { return "sh_optional_bool".toString() }
        if t.elementKind == .Named { return support.join2("sh_optional_", support.decimal(t.elementDecl)) }
        if t.elementKind == .Tuple { return support.join2("sh_optional_tuple_", support.decimal(t.elementDecl)) }
    }
    return "void".toString()
}

// A tuple signature is a radix representation with a leading 1 sentinel.
// Atomic digits are nonzero and less than radix: int=1, byte=2, bool=3,
// named type k=k+4. Registry names are complete before any tuple is resolved,
// so the radix is stable. Overflow is unsupported, never truncation or hashing.
pub fn tuple(reg: Registry, ts: Vec[Token], token: int, items: []Type) -> Type {
    if items.len() == 0 {
        lexer.fail(ts, token, "U0001", "empty tuples use the unit value in this subset")
    }
    let radix = reg.entries.len() + 4
    var signature = 1
    for item in items {
        var digit = 0
        if item.kind == .Int { digit = 1
        } else if item.kind == .Byte { digit = 2
        } else if item.kind == .Bool { digit = 3
        } else if item.kind == .Named && !owned(reg, item) {
            digit = item.decl + 4
        } else {
            lexer.fail(ts, token, "U0001", "tuples require flat Copy int, byte, bool or named elements in this subset")
        }
        if signature > (9223372036854775807 - digit) / radix {
            lexer.fail(ts, token, "U0001", "tuple type exceeds the selfhost structural signature limit")
        }
        signature = signature * radix + digit
    }
    return Type{kind: .Tuple, decl: signature, elementKind: .Unknown}
}

pub fn tupleCount(reg: Registry, ty: Type) -> int {
    let radix = reg.entries.len() + 4
    var signature = ty.decl
    var count = 0
    while signature > 1 {
        signature /= radix
        count += 1
    }
    return count
}

pub fn tupleElement(reg: Registry, ty: Type, index: int) -> Type {
    let count = tupleCount(reg, ty)
    assert(index >= 0 && index < count)
    let radix = reg.entries.len() + 4
    var signature = ty.decl
    var rest = count - index - 1
    while rest > 0 {
        signature /= radix
        rest -= 1
    }
    let digit = signature % radix
    if digit == 1 { return primitive(.Int) }
    if digit == 2 { return primitive(.Byte) }
    if digit == 3 { return primitive(.Bool) }
    return Type{kind: .Named, decl: digit - 4, elementKind: .Unknown}
}

pub fn describe(reg: Registry, ts: Vec[Token], t: Type) -> String {
    if t.kind == .Int { return "int".toString() }
    if t.kind == .Byte { return "byte".toString() }
    if t.kind == .Bool { return "bool".toString() }
    if t.kind == .Str { return "str".toString() }
    if t.kind == .String { return "String".toString() }
    if t.kind == .Vec { return support.join3("Vec[", describe(reg, ts, element(t)), "]") }
    if t.kind == .Optional { return support.join2("?", describe(reg, ts, element(t))) }
    if t.kind == .Map { return support.join3("Map[String, ", describe(reg, ts, element(t)), "]") }
    if t.kind == .Set { return "Set[String]".toString() }
    if t.kind == .Args { return "[]str".toString() }
    if t.kind == .Slice { return support.join2("[]", describe(reg, ts, element(t))) }
    if t.kind == .Unit { return "()".toString() }
    if t.kind == .Tuple {
        var text = "(".toString()
        let count = tupleCount(reg, t)
        for index in 0..count {
            if index > 0 { text.push(", ") }
            text.push(describe(reg, ts, tupleElement(reg, t, index)))
        }
        if count == 1 { text.push(",") }
        text.push(")")
        return text
    }
    if t.kind == .Named { return ts[reg.entries[t.decl].name].text.clone() }
    if t.kind == .Result {
        return support.join3(describe(reg, ts, resultOk(reg, t)), " ! ", describe(reg, ts, resultError(reg, t)))
    }
    return "<unknown>".toString()
}

// The source file containing a token; files are contiguous token runs.
pub fn fileOf(reg: Registry, token: int) -> int {
    var file = reg.files.len() - 1
    while file > 0 && reg.files[file].firstToken > token { file -= 1 }
    return file
}

// The module file imported under `alias` by the alias token's own file, or -1.
pub fn importedFile(reg: Registry, ts: Vec[Token], alias: int) -> ?int {
    let from = reg.files[fileOf(reg, alias)]
    var i = 0
    while i < from.importCount {
        let item = reg.imports[from.importStart + i]
        if ts[item.alias].text == ts[alias].text { return some(item.file) }
        i += 1
    }
    return none
}

fn declaredIn(reg: Registry, ts: Vec[Token], file: int, nameToken: int) -> int {
    for i, entry in reg.entries {
        if entry.file == file && ts[entry.name].text == ts[nameToken].text { return i }
    }
    return -1
}

// An unqualified type name: the token's own file first, then public types of
// the modules that file imports. Two different imported candidates are
// ambiguous (E0010), as in stage0.
pub fn lookup(reg: Registry, ts: Vec[Token], nameToken: int) -> int {
    let file = fileOf(reg, nameToken)
    let own = declaredIn(reg, ts, file, nameToken)
    if own >= 0 { return own }
    var found = -1
    var i = 0
    while i < reg.files[file].importCount {
        let module = reg.imports[reg.files[file].importStart + i].file
        let decl = declaredIn(reg, ts, module, nameToken)
        if decl >= 0 && reg.entries[decl].public && decl != found {
            if found >= 0 {
                lexer.fail(ts, nameToken, "E0010", support.join3("type '", ts[nameToken].text, "' is ambiguous; qualify it with its module name"))
            }
            found = decl
        }
        i += 1
    }
    return found
}

// `module.Name` where module is an import of the alias token's file. Returns
// -1 when the alias is not a module; a missing or private name is E0010.
pub fn qualifiedType(reg: Registry, ts: Vec[Token], alias: int, nameToken: int) -> int {
    if let module = importedFile(reg, ts, alias) {
        let decl = declaredIn(reg, ts, module, nameToken)
        if decl < 0 || !reg.entries[decl].public {
            lexer.fail(ts, nameToken, "E0010", support.join5("module '", ts[alias].text, "' has no exported type '", ts[nameToken].text, "'"))
        }
        return decl
    }
    return -1
}

pub fn fieldIndex(reg: Registry, ts: Vec[Token], decl: int, nameToken: int) -> int {
    let start = reg.entries[decl].fieldStart
    var i = 0
    while i < reg.entries[decl].fieldCount {
        if ts[reg.fields[start + i].name].text == ts[nameToken].text { return i }
        i += 1
    }
    return -1
}

pub fn variantIndex(reg: Registry, ts: Vec[Token], decl: int, nameToken: int) -> int {
    let start = reg.entries[decl].variantStart
    var i = 0
    while i < reg.entries[decl].variantCount {
        if ts[reg.variants[start + i]].text == ts[nameToken].text { return i }
        i += 1
    }
    return -1
}

// Keep this list aligned with check_declaration_names in the Rust checker.
// Some collection names are special only in annotations, not declarations.
fn reservedType(name: str) -> bool {
    return name == "int" || name == "i8" || name == "i16" || name == "i32" ||
        name == "i64" || name == "u8" || name == "byte" || name == "u16" ||
        name == "u32" || name == "u64" || name == "f32" || name == "f64" ||
        name == "bool" || name == "str" || name == "String" || name == "Vec" ||
        name == "Box" || name == "Set" || name == "Arena" || name == "Id" ||
        name == "Atomic" || name == "SendError" || name == "Join" ||
        name == "Ordering" || name == "Utf8Error"
}

fn unsupportedType(name: str) -> bool {
    return reservedType(name) || name == "Map" || name == "Rc" || name == "Arc" ||
        name == "Mutex" || name == "Guard" || name == "Channel" ||
        name == "Heap" || name == "Deque"
}

pub fn vector(ts: Vec[Token], token: int, elem: Type) -> Type {
    if elem.kind == .Unknown {
        lexer.fail(ts, token, "E0001", "cannot infer the vector element type")
    }
    if elem.kind != .Int && elem.kind != .Byte && elem.kind != .Bool && elem.kind != .String &&
        elem.kind != .Str && elem.kind != .Named {
        lexer.fail(ts, token, "U0001", "this vector element type is outside the selfhost subset")
    }
    return Type{kind: .Vec, elementKind: elem.kind, elementDecl: elem.decl}
}

pub fn optional(reg: Registry, ts: Vec[Token], token: int, elem: Type) -> Type {
    if elem.kind == .Unknown {
        lexer.fail(ts, token, "E0001", "cannot infer the Optional payload type")
    }
    if elem.kind != .Int && elem.kind != .Byte && elem.kind != .Bool && elem.kind != .Named && elem.kind != .Tuple {
        lexer.fail(ts, token, "U0001", "this Optional payload type is outside the selfhost subset")
    }
    if owned(reg, elem) {
        lexer.fail(ts, token, "U0001", "owned Optional payloads are outside the selfhost subset")
    }
    return Type{kind: .Optional, elementKind: elem.kind, elementDecl: elem.decl}
}

pub fn resolve(reg: Registry, ts: Vec[Token], syn: TypeRef) -> Type {
    if syn.kind == .Result {
        return Type{kind: .Result, decl: reg.resultRefs[syn.result], elementKind: .Unknown}
    }
    if syn.kind == .Tuple {
        var items: Vec[Type] = []
        for index in 0..syn.tupleCount {
            let part = reg.tupleAtoms[syn.tupleStart + index]
            if part.kind == .Tuple || part.kind == .Optional || part.kind == .Result ||
                part.kind == .Vec || part.kind == .Slice || part.kind == .Map || part.kind == .Set {
                lexer.fail(ts, syn.name, "U0001", "nested tuples and tuple container payloads are outside the selfhost subset")
            }
            items.push(resolve(reg, ts, part))
        }
        return tuple(reg, ts, syn.name, items)
    }
    if syn.kind == .Optional {
        let elem = resolve(reg, ts, TypeRef{kind: syn.elementKind,
            name: syn.elementName, elementKind: .Unknown,
            tupleStart: syn.tupleStart, tupleCount: syn.tupleCount})
        return optional(reg, ts, syn.name, elem)
    }
    if syn.kind == .Vec {
        let elem = resolve(reg, ts, TypeRef{kind: syn.elementKind,
            name: syn.elementName, elementKind: .Unknown})
        return vector(ts, syn.elementName, elem)
    }
    if syn.kind == .Map {
        // mapType() admitted only scalar values.
        return Type{kind: .Map, elementKind: syn.elementKind}
    }
    if syn.kind == .Set { return Type{kind: .Set, elementKind: .String} }
    if syn.kind == .Slice {
        let elem = resolve(reg, ts, TypeRef{kind: syn.elementKind,
            name: syn.elementName, elementKind: .Unknown})
        if (elem.kind != .Int && elem.kind != .Byte && elem.kind != .Bool && elem.kind != .Str &&
            elem.kind != .Named) || owned(reg, elem) {
            lexer.fail(ts, syn.elementName, "U0001", "slices of this element type are outside the selfhost subset")
        }
        return Type{kind: .Slice, elementKind: elem.kind, elementDecl: elem.decl}
    }
    if syn.kind != .Named { return primitive(syn.kind) }
    if ts[syn.name].text == "String" { return primitive(.String) }
    if ts[syn.name].text == "Vec" {
        lexer.fail(ts, syn.name, "E0001", "Vec takes exactly one type argument")
    }
    if unsupportedType(ts[syn.name].text) {
        lexer.fail(ts, syn.name, "U0001", support.join3("type '", ts[syn.name].text, "' is outside the selfhost subset"))
    }
    if ts[syn.name + 1].kind == .Symbol && ts[syn.name + 1].text == "." {
        // Type positions spell a module-qualified type as module.Name.
        let qualified = qualifiedType(reg, ts, syn.name, syn.name + 2)
        if qualified < 0 {
            lexer.fail(ts, syn.name, "E0010", support.join3("module '", ts[syn.name].text, "' is not in scope"))
        }
        return Type{elementKind: .Unknown, kind: .Named, decl: qualified}
    }
    let decl = lookup(reg, ts, syn.name)
    if decl < 0 {
        lexer.fail(ts, syn.name, "E0010", support.join3("unknown type '", ts[syn.name].text, "'"))
    }
    return Type{elementKind: .Unknown, kind: .Named, decl: decl}
}

fn collectResults(p: Program, ts: Vec[Token], reg: inout Registry) {
    var i = 0
    while i < p.resultTypes.len() {
        let syntax = p.resultTypes[i]
        // Result annotations are collected before named ownership is propagated.
        // Reject the combination before resolving any Optional payload here.
        if syntax.ok.kind == .Optional || syntax.error.kind == .Optional {
            lexer.fail(ts, syntax.errorToken, "U0001", "Optional/Result combinations are outside the selfhost subset")
        }
        if syntax.ok.kind == .Tuple || syntax.error.kind == .Tuple {
            lexer.fail(ts, syntax.errorToken, "U0001", "Tuple/Result combinations are outside the selfhost subset")
        }
        let ok = resolve(reg, ts, syntax.ok)
        let error = resolve(reg, ts, syntax.error)
        if ok.kind == .Result || error.kind == .Result || error.kind == .Unit {
            lexer.fail(ts, syntax.errorToken, "E0001", "a result needs a non-Result success type and a non-unit error type")
        }
        if carriesBorrow(error) {
            lexer.fail(ts, syntax.errorToken, "E0301", "an error value cannot hold a borrowed view; use String")
        }
        var found = -1
        var j = 0
        while j < reg.results.len() {
            if same(reg.results[j].ok, ok) && same(reg.results[j].error, error) { found = j }
            j += 1
        }
        if found < 0 {
            found = reg.results.len()
            reg.results.push(ResultInfo{ok: ok, error: error})
        }
        reg.resultRefs.push(found)
        i += 1
    }
}

fn checkDefault(p: Program, reg: Registry, ts: Vec[Token], item: Field) {
    if item.initial < 0 { return }
    var id = item.initial
    while p.expressions[id].kind == .Paren { id = p.expressions[id].left }
    let e = p.expressions[id]
    var actual = primitive(.Unknown)
    if e.kind == .Number {
        if item.ty.kind == .Byte { actual = primitive(.Byte) } else {
            actual = primitive(.Int)
        }
    } else if e.kind == .Byte {
        // Stage0 permits any integer field declaration here. Instantiating a
        // default still checks its fixed byte type against the field type.
        if item.ty.kind == .Int { actual = primitive(.Int) } else {
            actual = primitive(.Byte)
        }
    } else if e.kind == .Boolean {
        actual = primitive(.Bool)
    } else if e.kind == .Text {
        if item.ty.kind == .String { actual = primitive(.String) } else {
            actual = primitive(.Str)
        }
    } else if e.kind == .Vector && e.argCount == 0 && e.elementKind == .Unknown {
        if item.ty.kind == .Vec || item.ty.kind == .Set { actual = item.ty }
    } else if e.kind == .EmptyMap {
        // Stage0 permits [:] for a Set local, but its constant field-default
        // checker accepts only [] for Set fields.
        if item.ty.kind == .Map { actual = item.ty }
    } else if e.kind == .Unary && ts[e.token].text == "-" && p.expressions[e.left].kind == .Number {
        // FieldDefault::of accepts a directly negated numeric token only.
        // Integer range is checked when a constructor instantiates the default.
        if item.ty.kind == .Byte { actual = primitive(.Byte) } else {
            actual = primitive(.Int)
        }
    } else {
        lexer.fail(ts, p.expressions[item.initial].token, "E0001",
            "a field default must be a constant literal")
    }
    if !same(item.ty, actual) {
        var message = support.join3("default for field '", ts[item.name].text, "' does not have type '")
        message.push(describe(reg, ts, item.ty))
        message.push("'")
        lexer.fail(ts, p.expressions[item.initial].token, "E0001", message)
    }
}

pub fn collect(p: Program, ts: Vec[Token]) -> Registry {
    var reg = Registry{}
    for atom in p.tupleAtoms { reg.tupleAtoms.push(atom) }
    var i = 0
    while i < p.files.len() {
        reg.files.push(p.files[i])
        i += 1
    }
    i = 0
    while i < p.imports.len() {
        reg.imports.push(p.imports[i])
        i += 1
    }
    i = 0
    // Register all names before resolving fields to support forward references.
    while i < p.types.len() {
        let d = p.types[i]
        if reservedType(ts[d.name].text) {
            lexer.fail(ts, d.name, "E0011", support.join3("'", ts[d.name].text, "' is a built-in name and cannot be redefined"))
        }
        if declaredIn(reg, ts, d.file, d.name) >= 0 {
            lexer.fail(ts, d.name, "E0011", support.join3("type '", ts[d.name].text, "' is already declared"))
        }
        reg.entries.push(Info{kind: d.kind, name: d.name, file: d.file, public: d.public})
        i += 1
    }
    // Every annotation was pooled by the parser; intern before any signature or
    // expression is lowered so C result layouts are complete and stable.
    collectResults(p, ts, &reg)
    i = 0
    while i < p.types.len() {
        let d = p.types[i]
        let fieldStart = reg.fields.len()
        var j = 0
        while j < d.fieldCount {
            let f = p.fields[d.fieldStart + j]
            if f.ty.kind == .Optional {
                lexer.fail(ts, f.name, "U0001", "Optional fields are outside the selfhost subset")
            }
            if f.ty.kind == .Tuple {
                lexer.fail(ts, f.name, "U0001", "tuple fields are outside the selfhost subset")
            }
            var k = fieldStart
            while k < reg.fields.len() {
                if ts[reg.fields[k].name].text == ts[f.name].text {
                    lexer.fail(ts, f.name, "E0011", support.join3("field '", ts[f.name].text, "' is already declared"))
                }
                k += 1
            }
            let ty = resolve(reg, ts, f.ty)
            if carriesBorrow(ty) {
                lexer.fail(ts, f.name, "E0301", "a struct field cannot store a borrowed view; use an owned value")
            }
            if ty.kind == .Unit {
                lexer.fail(ts, f.name, "U0001", "unit fields are outside the selfhost subset")
            }
            if ty.kind == .Result {
                lexer.fail(ts, f.name, "U0001", "Result fields are outside the selfhost subset")
            }
            let item = Field{name: f.name, ty: ty, initial: f.initial}
            checkDefault(p, reg, ts, item)
            reg.fields.push(item)
            j += 1
        }
        reg.entries[i].fieldStart = fieldStart
        reg.entries[i].fieldCount = d.fieldCount
        let variantStart = reg.variants.len()
        j = 0
        while j < d.variantCount {
            let name = p.lists[d.variantStart + j]
            var k = variantStart
            while k < reg.variants.len() {
                if ts[reg.variants[k]].text == ts[name].text {
                    lexer.fail(ts, name, "E0011", support.join3("enum case '", ts[name].text, "' is already declared"))
                }
                k += 1
            }
            reg.variants.push(name)
            j += 1
        }
        reg.entries[i].variantStart = variantStart
        reg.entries[i].variantCount = d.variantCount
        i += 1
    }

    // A stable topological order gives C complete by-value field definitions.
    // Vec buffers are indirect; their element types do not add by-value layout edges.
    var done: Vec[bool] = []
    i = 0
    while i < reg.entries.len() {
        done.push(false)
        i += 1
    }
    while reg.order.len() < reg.entries.len() {
        var progressed = false
        i = 0
        while i < reg.entries.len() {
            if !done[i] {
                var ready = true
                var j = 0
                while j < reg.entries[i].fieldCount {
                    let ty = fieldOf(reg, i, j).ty
                    if ty.kind == .Named && !done[ty.decl] { ready = false }
                    j += 1
                }
                if ready {
                    done[i] = true
                    reg.order.push(i)
                    progressed = true
                }
            }
            i += 1
        }
        if !progressed {
            i = 0
            while done[i] { i += 1 }
            let name = reg.entries[i].name
            lexer.fail(ts, name, "E0017", support.join3("type '", ts[name].text, "' has a recursive by-value dependency"))
        }
    }
    // Layout order is sufficient for by-value ownership propagation.
    // Vec is owned independently of its element, including recursive Vec edges.
    i = 0
    while i < reg.order.len() {
        let index = reg.order[i]
        var hasOwned = false
        var j = 0
        while j < reg.entries[index].fieldCount {
            if owned(reg, fieldOf(reg, index, j).ty) { hasOwned = true }
            j += 1
        }
        reg.entries[index].owned = hasOwned
        i += 1
    }
    return reg
}
