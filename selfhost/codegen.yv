// Typed C lowering. Every value is materialized in source order.
// Owned values have one owner; borrowed reads and statement temporaries are explicit.
use diagnostic
use lexer
use model
use types


struct Local {
    token: int
    ty: Type
    mutable: bool
    borrowed: bool = false
    moved: bool = false
}

struct Value {
    ty: Type
    name: String
    local: int = -1
    root: int = -1
    field: bool = false
    indexedBorrow: bool = false
    temporary: bool = false
}

struct Place {
    ty: Type
    name: String
    mutable: bool
    root: int
    whole: bool = true
    indexed: bool = false
}

struct Temporary {
    ty: Type
    name: String
}

struct LoopState {
    localCount: int
    tempCount: int
    breaks: Vec[bool] = []
    continues: Vec[bool] = []
    hasBreak: bool = false
}

struct Flow {
    falls: bool = true
    breaks: bool = false
}

struct Generator {
    out: String = ""
    counter: int = 0
    locals: Vec[Local] = []
    temps: Vec[Temporary] = []
    locks: Vec[int] = []
    binaryLocks: Vec[int] = []
    accessLocks: Vec[int] = []
    reservations: Vec[int] = []
    loopStates: Vec[LoopState] = []
    result: Type
    loops: int = 0
    nesting: int = 0
    outputRoot: int = -1
    loopCondition: bool = false
}

fn problem(ts: Vec[Token], token: int, code: str, message: str) -> Failure {
    let t = ts[token]
    return diagnostic.make(code, message, t.start, t.line, t.column)
}

fn require(reg: Registry, ts: Vec[Token], token: int, actual: Type, expected: Type) -> () ! Failure {
    if !types.same(actual, expected) {
        return err(problem(ts, token, "E0001",
            format("expected ${types.describe(reg, ts, expected)}, found ${types.describe(reg, ts, actual)}")))
    }
}

fn basic(reg: Registry, ts: Vec[Token], token: int, actual: Type, expected: BasicType) -> () ! Failure {
    try require(reg, ts, token, actual, types.primitive(expected))
}

// Three octal digits per byte preserve UTF-8/NUL without C escape ambiguity.
pub fn cString(text: str) -> String {
    var out = "\"".toString()
    for i in 0..text.len() {
        let b = int(text[i])
        out.push(format("\\${b / 64}${(b / 8) % 8}${b % 8}"))
    }
    out.push("\"")
    return out
}

fn line(g: inout Generator, text: str) {
    g.out.push(text)
    g.out.push("\n")
}

fn typedValue(g: inout Generator, reg: Registry, ty: Type, expression: str) -> Value {
    let n = g.counter
    g.counter += 1
    let name = format("t_${n}")
    line(&g, format("${types.cType(ty)} ${name} = ${expression};"))
    let owner = types.owned(reg, ty)
    if owner { g.temps.push(Temporary{ty: ty, name: name.clone()}) }
    return Value{ty: ty, name: name, temporary: owner}
}

fn value(g: inout Generator, ty: BasicType, expression: str) -> Value {
    let n = g.counter
    g.counter += 1
    let name = format("t_${n}")
    let resolved = types.primitive(ty)
    line(&g, format("${types.cType(resolved)} ${name} = ${expression};"))
    return Value{ty: resolved, name: name}
}

fn vectorHelper(ty: Type) -> String {
    if ty.elementKind == .String { return "string".toString() }
    return format("type_${ty.elementDecl}")
}

fn dropName(reg: Registry, ty: Type) -> String {
    if ty.kind == .String { return "yv_string_drop".toString() }
    if ty.kind == .Vec {
        if types.owned(reg, types.element(ty)) {
            return format("sh_vec_drop_${vectorHelper(ty)}")
        }
        return "yv_vec_free".toString()
    }
    return format("sh_drop_${ty.decl}")
}

// Struct cloning is internal to collection cloning, not a new user struct method.
// Copy fields retain their values; each owned field receives a distinct owner.
fn cloneExpression(reg: Registry, ty: Type, source: str, lineText: str, columnText: str) -> String {
    if ty.kind == .String {
        return format("yv_string_from(yv_string_view(&(${source})), ${lineText}, ${columnText})")
    }
    if ty.kind == .Vec {
        let elem = types.element(ty)
        if types.owned(reg, elem) {
            return format("sh_vec_clone_${vectorHelper(ty)}(&(${source}), ${lineText}, ${columnText})")
        }
        return format("sh_vec_clone_copy(&(${source}), (int64_t)sizeof(${types.cType(elem)}), ${lineText}, ${columnText})")
    }
    if types.owned(reg, ty) {
        return format("sh_clone_${ty.decl}(&(${source}), ${lineText}, ${columnText})")
    }
    return source.toString()
}

fn dropValue(g: inout Generator, reg: Registry, ty: Type, name: str) {
    if types.owned(reg, ty) { line(&g, format("${dropName(reg, ty)}(&(${name}));")) }
}

fn zeroValue(g: inout Generator, reg: Registry, v: Value) {
    if types.owned(reg, v.ty) {
        line(&g, format("${v.name} = (${types.cType(v.ty)}){0};"))
    }
}

fn cleanTemps(g: inout Generator, reg: Registry, start: int) {
    var i = g.temps.len()
    while i > start {
        i -= 1
        let ty = g.temps[i].ty
        let name = g.temps[i].name.clone()
        dropValue(&g, reg, ty, name)
    }
}

fn discardTemps(g: inout Generator, reg: Registry, start: int) {
    cleanTemps(&g, reg, start)
    while g.temps.len() > start { let _removed = g.temps.pop() }
}

fn cleanLocals(g: inout Generator, reg: Registry, start: int) {
    var i = g.locals.len()
    while i > start {
        i -= 1
        let local = g.locals[i]
        if !local.borrowed {
            let name = format("v_${local.token}")
            dropValue(&g, reg, local.ty, name)
        }
    }
}

fn movedState(g: Generator) -> Vec[bool] {
    var state: Vec[bool] = []
    for local in g.locals { state.push(local.moved) }
    return state
}

fn restoreState(g: inout Generator, state: Vec[bool]) {
    for i in 0..state.len() { g.locals[i].moved = state[i] }
}

fn joinStates(a: Vec[bool], b: Vec[bool]) -> Vec[bool] {
    var out = a.clone()
    for i in 0..out.len() { if i < b.len() { out[i] = out[i] || b[i] } }
    return out
}

fn readable(g: Generator, ts: Vec[Token], root: int, token: int) -> () ! Failure {
    if root >= 0 && g.locals[root].moved {
        return err(problem(ts, token, "E0402", "use of a moved value"))
    }
}

fn writable(g: Generator, ts: Vec[Token], root: int, token: int) -> () ! Failure {
    for reserved in g.reservations {
        if reserved == root { return err(problem(ts, token, "E0403", "mutation conflicts with a reserved receiver")) }
    }
    for locked in g.locks {
        if locked == root { return err(problem(ts, token, "E0102", "an earlier expression still borrows this value")) }
    }
    for locked in g.binaryLocks {
        if locked == root {
            return err(problem(ts, token, "U0001", "transferring a comparison operand while it is borrowed is outside this subset"))
        }
    }
    for locked in g.accessLocks {
        if locked == root {
            return err(problem(ts, token, "U0001", "moving or modifying an active index/reserve receiver is outside this subset"))
        }
    }
}

fn copyValue(v: Value) -> Value {
    return Value{ty: v.ty, name: v.name.clone(), local: v.local,
        root: v.root, field: v.field, indexedBorrow: v.indexedBorrow, temporary: v.temporary}
}

fn takeValue(g: inout Generator, reg: Registry, ts: Vec[Token], token: int, v: Value) -> Value ! Failure {
    if !types.owned(reg, v.ty) { return copyValue(v) }
    if v.indexedBorrow && !v.field {
        return err(problem(ts, token, "E0404", "an indexed element is borrowed; clone it to obtain an owned value"))
    }
    if v.field {
        return err(problem(ts, token, "E0401", "cannot move an owned value out of a field; clone it"))
    }
    if v.local >= 0 {
        try readable(g, ts, v.local, token)
        if g.locals[v.local].borrowed {
            return err(problem(ts, token, "E0401", "cannot move out of a read-only parameter; clone it"))
        }
        try writable(g, ts, v.local, token)
        if g.loopCondition {
            return err(problem(ts, token, "U0001", "moving an existing owned value in a loop condition is outside this subset"))
        }
        let taken = typedValue(&g, reg, v.ty, v.name)
        zeroValue(&g, reg, v)
        g.locals[v.local].moved = true
        return taken
    }
    if !v.temporary {
        return err(problem(ts, token, "E0401", "cannot move an owned borrowed value"))
    }
    return copyValue(v)
}

fn stringLike(ty: Type) -> bool { return ty.kind == .Str || ty.kind == .String }

fn view(v: Value) -> String {
    if v.ty.kind == .String { return format("yv_string_view(&(${v.name}))") }
    return v.name.clone()
}

fn releaseLocks(g: inout Generator, start: int) {
    while g.locks.len() > start { let _removed = g.locks.pop() }
}

fn localIndex(g: Generator, ts: Vec[Token], token: int) -> int {
    var i = g.locals.len()
    while i > 0 {
        i -= 1
        if ts[g.locals[i].token].text == ts[token].text && ts[token].text != "_" { return i }
    }
    return -1
}

fn declare(g: inout Generator, ts: Vec[Token], token: int, ty: Type, mutable: bool, borrowed: bool) -> () ! Failure {
    if localIndex(g, ts, token) >= 0 {
        return err(problem(ts, token, "E0011", "Yavo does not allow shadowing an active local"))
    }
    if ty.kind == .Unit || ty.kind == .Unknown {
        return err(problem(ts, token, "U0001", "unit-valued bindings are outside the selfhost subset"))
    }
    g.locals.push(Local{token: token, ty: ty, mutable: mutable, borrowed: borrowed})
}

fn functionIndex(p: Program, ts: Vec[Token], token: int) -> int {
    for i in 0..p.functions.len() {
        if ts[p.functions[i].name].text == ts[token].text { return i }
    }
    return -1
}

fn builtin(name: str) -> bool {
    return name == "print" || name == "println" || name == "eprintln" || name == "assert"
}

fn reservedFunction(name: str) -> bool {
    return name == "print" || name == "println" || name == "eprintln" ||
        name == "i8" || name == "i16" || name == "i32" || name == "i64" ||
        name == "int" || name == "u8" || name == "byte" || name == "u16" ||
        name == "u32" || name == "u64" || name == "f32" || name == "f64" ||
        name == "bool" || name == "str" || name == "String" ||
        name == "Vec" || name == "Box" || name == "Set"
}

fn integerOperation(ts: Vec[Token], token: int, op: str, left: str, right: str) -> String {
    let t = ts[token]
    var stem = "".toString()
    if op == "+" || op == "+=" { stem = "add".toString() }
    if op == "-" || op == "-=" { stem = "sub".toString() }
    if op == "*" || op == "*=" { stem = "mul".toString() }
    if op == "/" || op == "/=" { stem = "div".toString() }
    if op == "%" || op == "%=" { stem = "rem".toString() }
    if op == "<<" { stem = "shl".toString() }
    if op == ">>" { stem = "shr".toString() }
    if stem.len() > 0 {
        return format("yv_${stem}_i64(${left}, ${right}, ${t.line}, ${t.column})")
    }
    if op == "+%" { stem = "addw".toString() }
    if op == "-%" { stem = "subw".toString() }
    if op == "*%" { stem = "mulw".toString() }
    if stem.len() > 0 { return format("yv_${stem}_i64(${left}, ${right})") }
    return format("(${left} ${op} ${right})")
}

fn printValue(g: inout Generator, reg: Registry, ts: Vec[Token], token: int, arg: Value, output: int) -> () ! Failure {
    if arg.ty.kind == .Int { line(&g, format("yv_out_i64(&o_${output}, ${arg.name});"))
    } else if arg.ty.kind == .Bool { line(&g, format("yv_out_bool(&o_${output}, ${arg.name});"))
    } else if stringLike(arg.ty) { line(&g, format("yv_out_str(&o_${output}, ${view(arg)});"))
    } else if arg.ty.kind == .Named && reg.entries[arg.ty.decl].kind == .Enum {
        line(&g, format("switch (${arg.name}) {"))
        let variants = reg.entries[arg.ty.decl].variants.clone()
        for i in 0..variants.len() {
            let text = ts[variants[i]].text.clone()
            let quoted = cString(text)
            line(&g, format("case ${i}: yv_out_bytes(&o_${output}, ${quoted}, ${text.len()}); break;"))
        }
        line(&g, "}")
    } else {
        return err(problem(ts, token, "E0001", "this type cannot be printed"))
    }
}

fn call(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, id: int) -> Value ! Failure {
    let name = ts[e.token].text.clone()
    if localIndex(g, ts, e.token) >= 0 {
        return err(problem(ts, e.token, "E0001", "a local value cannot be called as a function"))
    }
    let index = functionIndex(p, ts, e.token)
    if index < 0 && builtin(name) {
        if name != "assert" && g.outputRoot != id {
            return err(problem(ts, e.token, "E0001", "output calls must be direct statements"))
        }
        if e.args.len() != 1 {
            return err(problem(ts, e.token, "E0012", "selfhost output/assert calls require one argument"))
        }
        var expected = types.primitive(.Unknown)
        if name == "assert" { expected = types.primitive(.Bool) }
        let arg = try emitExpected(&g, p, ts, reg, e.args[0], expected)
        let t = ts[e.token]
        if name == "assert" {
            try basic(reg, ts, e.token, arg.ty, .Bool)
            line(&g, format("if (!${arg.name}) yv_panic(\"P-ASSERT\", \"assertion failed\", ${t.line}, ${t.column});"))
        } else {
            var fd = 1
            if name == "eprintln" { fd = 2 }
            let outputIndex = g.counter
            g.counter += 1
            line(&g, format("yv_out o_${outputIndex} = {${fd}, NULL, ${t.line}, ${t.column}};"))
            line(&g, format("yv_output_at(${t.line}, ${t.column});"))
            try printValue(&g, reg, ts, e.token, arg, outputIndex)
            if name != "print" { line(&g, format("yv_out_bytes(&o_${outputIndex}, \"\\n\", 1);")) }
        }
        return Value{ty: types.primitive(.Unit), name: "".toString()}
    }
    if index < 0 {
        if name == "format" || name == "int" || name == "bool" || name == "panic" ||
            name == "some" || name == "take" || name == "replace" || name == "swap" {
            return err(problem(ts, e.token, "U0001", "builtin is outside the selfhost subset"))
        }
        return err(problem(ts, e.token, "E0010", format("unknown function '${name}'")))
    }
    let f = p.functions[index]
    if f.params.len() != e.args.len() {
        return err(problem(ts, e.token, "E0012", "wrong number of function arguments"))
    }
    let locks = g.locks.len()
    var args: Vec[String] = []
    for i in 0..e.args.len() {
        let expected = try types.resolve(reg, ts, f.params[i].ty)
        let arg = try emitExpected(&g, p, ts, reg, e.args[i], expected)
        if expected.kind == .Str && arg.ty.kind == .String {
            args.push(view(arg))
        } else {
            try require(reg, ts, p.expressions[e.args[i]].token, arg.ty, expected)
            args.push(arg.name.clone())
        }
        if arg.root >= 0 { g.locks.push(arg.root) }
    }
    let expression = format("sh_fn_${index}(${args.join(", ")})")
    let result = try types.resolve(reg, ts, f.result)
    releaseLocks(&g, locks)
    if result.kind == .Unit {
        line(&g, format("${expression};"))
        return Value{ty: result, name: "".toString()}
    }
    return typedValue(&g, reg, result, expression)
}

fn method(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value ! Failure {
    let name = ts[e.token].text.clone()
    let receiver = p.expressions[e.left]
    if receiver.kind == .Name && localIndex(g, ts, receiver.token) < 0 {
        let declared = types.lookup(reg, ts, receiver.token)
        if declared >= 0 && reg.entries[declared].kind == .Enum {
            return err(problem(ts, e.token, "U0001", "enum payload construction is outside this subset"))
        }
    }
    if name == "push" || name == "reserve" {
        let target = try place(&g, p, ts, reg, e.left, 0)
        try readable(g, ts, target.root, e.token)
        if target.ty.kind != .Vec && (name != "push" || target.ty.kind != .String) {
            return err(problem(ts, e.token, "U0001", "this modifying method is outside the selfhost subset"))
        }
        if !target.mutable { return err(problem(ts, e.token, "E0014", "cannot modify a read-only value")) }
        if e.args.len() != 1 { return err(problem(ts, e.token, "E0012", "this modifying method requires one argument")) }
        try writable(g, ts, target.root, e.token)
        let t = ts[e.token]
        if name == "reserve" {
            // Stage0 accepts receiver consumption here but then reallocates a moved-from
            // descriptor. Keep that unresolved behavior outside this supported subset.
            let mark = g.accessLocks.len()
            g.accessLocks.push(target.root)
            let count = try emitExpected(&g, p, ts, reg, e.args[0], types.primitive(.Int))
            try basic(reg, ts, e.token, count.ty, .Int)
            while g.accessLocks.len() > mark { let _removed = g.accessLocks.pop() }
            let elem = types.element(target.ty)
            line(&g, format("yv_vec_reserve(&(${target.name}), (int64_t)sizeof(${types.cType(elem)}), ${count.name}, ${t.line}, ${t.column});"))
        } else {
            g.reservations.push(target.root)
            if target.ty.kind == .String {
                let arg = try emitExpr(&g, p, ts, reg, e.args[0])
                if !stringLike(arg.ty) { return err(problem(ts, e.token, "E0001", "String.push requires str or String")) }
                if arg.root == target.root {
                    return err(problem(ts, e.token, "E0403", "push argument still borrows the receiver's root"))
                }
                let _removed = g.reservations.pop()
                line(&g, format("yv_string_push(&(${target.name}), ${view(arg)}, ${t.line}, ${t.column});"))
            } else {
                let elem = types.element(target.ty)
                let arg = try emitExpected(&g, p, ts, reg, e.args[0], elem)
                try require(reg, ts, p.expressions[e.args[0]].token, arg.ty, elem)
                // Keep the receiver reserved until consuming the argument has checked
                // its source root; storing the value transfers ownership to the slot.
                let taken = try takeValue(&g, reg, ts, p.expressions[e.args[0]].token, arg)
                let _removed = g.reservations.pop()
                let et = types.cType(elem)
                line(&g, format("*(${et} *)yv_vec_push_slot(&(${target.name}), (int64_t)sizeof(${et}), ${t.line}, ${t.column}) = ${taken.name};"))
                zeroValue(&g, reg, taken)
            }
        }
        return Value{ty: types.primitive(.Unit), name: "".toString()}
    }
    let base = try emitExpr(&g, p, ts, reg, e.left)
    if stringLike(base.ty) {
        if name == "len" || (name == "toString" && base.ty.kind == .Str) ||
            (name == "clone" && base.ty.kind == .String) {
            if e.args.len() != 0 { return err(problem(ts, e.token, "E0012", "this string method takes no arguments")) }
            if name == "len" {
                return value(&g, .Int, format("(${view(base)}).len"))
            }
            let t = ts[e.token]
            return typedValue(&g, reg, types.primitive(.String),
                format("yv_string_from(${view(base)}, ${t.line}, ${t.column})"))
        }
        return err(problem(ts, e.token, "U0001", "string method is outside the selfhost subset"))
    }
    if base.ty.kind == .Vec {
        if name == "len" || name == "clone" {
            if e.args.len() != 0 { return err(problem(ts, e.token, "E0012", "this vector method takes no arguments")) }
            if name == "len" { return value(&g, .Int, format("(${base.name}).len")) }
            let t = ts[e.token]
            let cloned = cloneExpression(reg, base.ty, base.name,
                format("${t.line}"), format("${t.column}"))
            return typedValue(&g, reg, base.ty, cloned)
        }
        return err(problem(ts, e.token, "U0001", "vector method is outside the selfhost subset"))
    }
    if base.ty.kind == .Named && reg.entries[base.ty.decl].kind == .Struct {
        return err(problem(ts, e.token, "E0010", "unknown struct method"))
    }
    return err(problem(ts, e.token, "U0001", "method is outside the selfhost subset"))
}

fn binary(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value ! Failure {
    let op = ts[e.token].text.clone()
    let lhs = try emitExpr(&g, p, ts, reg, e.left)
    if op == "&&" || op == "||" {
        try basic(reg, ts, e.token, lhs.ty, .Bool)
        let output = value(&g, .Bool, lhs.name)
        let before = movedState(g)
        let temps = g.temps.len()
        if op == "&&" { line(&g, format("if (${output.name}) {")) } else {
            line(&g, format("if (!${output.name}) {"))
        }
        let rhs = try emitExpected(&g, p, ts, reg, e.right, types.primitive(.Bool))
        try basic(reg, ts, e.token, rhs.ty, .Bool)
        line(&g, format("${output.name} = ${rhs.name};"))
        discardTemps(&g, reg, temps)
        let after = movedState(g)
        let joined = joinStates(before, after)
        restoreState(&g, joined)
        line(&g, "}")
        return output
    }
    let locks = g.binaryLocks.len()
    if lhs.root >= 0 { g.binaryLocks.push(lhs.root) }
    let rhs = try emitExpected(&g, p, ts, reg, e.right, lhs.ty)
    while g.binaryLocks.len() > locks { let _removed = g.binaryLocks.pop() }
    let equality = op == "==" || op == "!="
    let comparison = equality || op == "<" || op == "<=" || op == ">" || op == ">="
    if comparison && stringLike(lhs.ty) && stringLike(rhs.ty) {
        return value(&g, .Bool, format("(yv_str_cmp(${view(lhs)}, ${view(rhs)}) ${op} 0)"))
    }
    try require(reg, ts, e.token, rhs.ty, lhs.ty)
    if comparison {
        if lhs.ty.kind == .Unit || (lhs.ty.kind == .Bool && !equality) {
            return err(problem(ts, e.token, "E0001", "operator is not defined for this type"))
        }
        if lhs.ty.kind == .Vec || (lhs.ty.kind == .Named && (reg.entries[lhs.ty.decl].kind == .Struct || !equality)) {
            return err(problem(ts, e.token, "E0501", "this aggregate does not implement the required comparison"))
        }
        return value(&g, .Bool, format("(${lhs.name} ${op} ${rhs.name})"))
    }
    try basic(reg, ts, e.token, lhs.ty, .Int)
    let code = integerOperation(ts, e.token, op, lhs.name, rhs.name)
    return value(&g, .Int, code)
}

fn emitExpr(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int) -> Value ! Failure {
    return emitExpected(&g, p, ts, reg, id, types.primitive(.Unknown))
}

fn emitExpected(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, expected: Type) -> Value ! Failure {
    if g.nesting >= 256 {
        return err(problem(ts, p.expressions[id].token, "U0001", "selfhost lowering nesting limit (256) exceeded"))
    }
    g.nesting += 1
    let result = try expression(&g, p, ts, reg, id, expected)
    g.nesting -= 1
    return result
}

fn minimumMagnitude(text: str) -> bool {
    var start = 0
    while start + 1 < text.len() && text[start] == '0' { start += 1 }
    return text[start..text.len()] == "9223372036854775808"
}

fn unparenthesized(p: Program, id: int) -> int {
    var current = id
    while p.expressions[current].kind == .Paren { current = p.expressions[current].left }
    return current
}

fn enumValue(g: inout Generator, reg: Registry, ts: Vec[Token], token: int, expected: Type) -> Value ! Failure {
    if expected.kind != .Named || reg.entries[expected.decl].kind != .Enum {
        return err(problem(ts, token, "E0001", "an enum case requires an expected enum type"))
    }
    let which = types.variant(reg, ts, expected.decl, token)
    if which < 0 { return err(problem(ts, token, "E0010", "unknown enum case")) }
    return typedValue(&g, reg, expected, format("${which}"))
}

fn construct(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value ! Failure {
    if ts[e.token].text == "String" {
        if e.names.len() > 0 { return err(problem(ts, e.names[0], "E0010", "String has no constructor fields")) }
        return typedValue(&g, reg, types.primitive(.String), "(yv_string){0}")
    }
    let index = types.lookup(reg, ts, e.token)
    if index < 0 {
        if ts[e.token].text == "Vec" {
            return err(problem(ts, e.token, "E0001", "Vec takes exactly one type argument"))
        }
        if ts[e.token].text == "Map" || ts[e.token].text == "Set" {
            return err(problem(ts, e.token, "U0001", "collection construction is outside the selfhost subset"))
        }
        return err(problem(ts, e.token, "E0010", "unknown struct type"))
    }
    let info = reg.entries[index]
    if info.kind != .Struct { return err(problem(ts, e.token, "E0001", "struct construction requires a struct type")) }
    var values: Vec[Value] = []
    for _i in 0..info.fields.len() { values.push(Value{ty: types.primitive(.Unknown), name: String{}}) }
    for i in 0..e.names.len() {
        let f = types.field(reg, ts, index, e.names[i])
        if f < 0 { return err(problem(ts, e.names[i], "E0010", "unknown struct field")) }
        if values[f].name.len() > 0 { return err(problem(ts, e.names[i], "E0011", "duplicate constructor field")) }
        let result = try emitExpected(&g, p, ts, reg, e.args[i], info.fields[f].ty)
        try require(reg, ts, p.expressions[e.args[i]].token, result.ty, info.fields[f].ty)
        values[f] = try takeValue(&g, reg, ts, p.expressions[e.args[i]].token, result)
    }
    for i in 0..info.fields.len() {
        if values[i].name.len() == 0 {
            let f = info.fields[i]
            if f.initial < 0 { return err(problem(ts, e.token, "E0018", "missing struct field without a default")) }
            var initial = try emitExpected(&g, p, ts, reg, f.initial, f.ty)
            if f.ty.kind == .String && initial.ty.kind == .Str {
                let t = ts[p.expressions[f.initial].token]
                initial = typedValue(&g, reg, f.ty, format("yv_string_from(${initial.name}, ${t.line}, ${t.column})"))
            }
            try require(reg, ts, p.expressions[f.initial].token, initial.ty, f.ty)
            values[i] = try takeValue(&g, reg, ts, p.expressions[f.initial].token, initial)
        }
    }
    var fields: Vec[String] = []
    for i in 0..values.len() { fields.push(format(".f_${i} = ${values[i].name}")) }
    if values.len() == 0 { fields.push(".sh_empty = 0".toString()) }
    let ty = Type{kind: .Named, decl: index, elementKind: .Unknown}
    let result = typedValue(&g, reg, ty, format("(${types.cType(ty)}){${fields.join(", ")}}"))
    for item in values { zeroValue(&g, reg, item) }
    return result
}

fn fieldValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value ! Failure {
    let baseExpr = p.expressions[e.left]
    if baseExpr.kind == .Name && localIndex(g, ts, baseExpr.token) < 0 {
        let declared = types.lookup(reg, ts, baseExpr.token)
        if declared >= 0 && reg.entries[declared].kind == .Enum {
            return enumValue(&g, reg, ts, e.token, Type{kind: .Named, decl: declared, elementKind: .Unknown})
        }
    }
    let base = try emitExpr(&g, p, ts, reg, e.left)
    if base.ty.kind != .Named || reg.entries[base.ty.decl].kind != .Struct {
        return err(problem(ts, e.token, "U0001", "member access on this type is outside the selfhost subset"))
    }
    let fieldIndex = types.field(reg, ts, base.ty.decl, e.token)
    if fieldIndex < 0 { return err(problem(ts, e.token, "E0010", "unknown struct field")) }
    let ty = reg.entries[base.ty.decl].fields[fieldIndex].ty
    let name = format("(${base.name}).f_${fieldIndex}")
    if types.owned(reg, ty) {
        return Value{ty: ty, name: name, root: base.root, field: true, indexedBorrow: base.indexedBorrow}
    }
    return typedValue(&g, reg, ty, name)
}

fn vectorValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, expected: Type) -> Value ! Failure {
    var elem = types.primitive(.Unknown)
    if expected.kind == .Vec { elem = types.element(expected) }
    if e.elementKind != .Unknown {
        let annotation = TypeRef{kind: .Vec, name: e.token,
            elementKind: e.elementKind, elementName: e.elementName}
        let explicit = try types.resolve(reg, ts, annotation)
        elem = types.element(explicit)
    }
    if elem.kind == .Unknown && e.args.len() == 0 {
        return err(problem(ts, e.token, "E0001", "cannot infer the element type of an empty vector"))
    }
    let n = g.counter
    g.counter += 1
    let name = format("t_${n}")
    // Register the outer owner before lowering its elements. Prefixing the resulting
    // C with the allocation also preserves allocation-before-element evaluation when
    // the element type is inferred from the first expression.
    let temporary = g.temps.len()
    g.temps.push(Temporary{ty: types.primitive(.Vec), name: name.clone()})
    let before = take(&g.out)
    var ty = types.primitive(.Unknown)
    if elem.kind != .Unknown { ty = try types.vector(reg, ts, e.token, elem) }
    let t = ts[e.token]
    for arg in e.args {
        let item = try emitExpected(&g, p, ts, reg, arg, elem)
        if elem.kind == .Unknown {
            if item.indexedBorrow && !item.field {
                return err(problem(ts, p.expressions[arg].token, "U0001", "vectors of borrowed elements are outside this subset"))
            }
            if item.ty.kind == .Unit {
                return err(problem(ts, p.expressions[arg].token, "E0001", "a unit-valued call cannot be a vector element"))
            }
            elem = item.ty
            ty = try types.vector(reg, ts, p.expressions[arg].token, elem)
        }
        try require(reg, ts, p.expressions[arg].token, item.ty, elem)
        let taken = try takeValue(&g, reg, ts, p.expressions[arg].token, item)
        let et = types.cType(elem)
        line(&g, format("*(${et} *)yv_vec_push_slot(&${name}, (int64_t)sizeof(${et}), ${t.line}, ${t.column}) = ${taken.name};"))
        zeroValue(&g, reg, taken)
    }
    // Inferred literals now know their element destructor. Keeping the placeholder
    // type would free only the buffer and leak every owned element.
    g.temps[temporary].ty = ty
    let body = take(&g.out)
    g.out = before
    let et = types.cType(elem)
    line(&g, format("yv_vec ${name} = yv_vec_with_cap((int64_t)sizeof(${et}), ${e.args.len()}, ${t.line}, ${t.column});"))
    g.out.push(body)
    return Value{ty: ty, name: name, temporary: true}
}

fn indexValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value ! Failure {
    let receiver = p.expressions[e.left]
    if receiver.kind == .Name && localIndex(g, ts, receiver.token) < 0 {
        let name = ts[receiver.token].text.clone()
        if name == "Vec" || name == "String" || name == "str" || name == "int" ||
            name == "bool" || types.lookup(reg, ts, receiver.token) >= 0 {
            return err(problem(ts, e.token, "U0001", "type arguments without construction are outside this subset"))
        }
    }
    let base = try emitExpr(&g, p, ts, reg, e.left)
    if stringLike(base.ty) {
        return err(problem(ts, e.token, "U0001", "text indexing returns byte, which is outside this subset"))
    }
    if base.ty.kind != .Vec {
        return err(problem(ts, e.token, "E0001", "this value cannot be indexed"))
    }
    let elem = types.element(base.ty)
    let mark = g.accessLocks.len()
    if base.root >= 0 { g.accessLocks.push(base.root) }
    let index = try emitExpected(&g, p, ts, reg, e.right, types.primitive(.Int))
    try basic(reg, ts, e.token, index.ty, .Int)
    while g.accessLocks.len() > mark { let _removed = g.accessLocks.pop() }
    let et = types.cType(elem)
    let t = ts[e.token]
    if types.owned(reg, elem) {
        // Materialize the checked address once. This is a borrowed slot, never a
        // new owner; a temporary receiver stays alive in g.temps for the statement.
        let n = g.counter
        g.counter += 1
        line(&g, format("const ${et} *borrow_${n} = (const ${et} *)yv_vec_at(&(${base.name}), (int64_t)sizeof(${et}), ${index.name}, ${t.line}, ${t.column});"))
        return Value{ty: elem, name: format("(*borrow_${n})"), root: base.root, indexedBorrow: true}
    }
    // Copy reads immediately detach from the source container.
    return typedValue(&g, reg, elem,
        format("*(${et} *)yv_vec_at(&(${base.name}), (int64_t)sizeof(${et}), ${index.name}, ${t.line}, ${t.column})"))
}

fn expression(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, expected: Type) -> Value ! Failure {
    let e = p.expressions[id]
    let t = ts[e.token]
    if e.kind == .Unit { return Value{ty: types.primitive(.Unit), name: "".toString()} }
    if e.kind == .Paren { return emitExpected(&g, p, ts, reg, e.left, expected) }
    if e.kind == .Number {
        let number = t.text.parseInt() ?? return err(problem(ts, e.token, "E0003", "integer literal is outside int range"))
        return value(&g, .Int, format("INT64_C(${number})"))
    }
    if e.kind == .Boolean { return value(&g, .Bool, t.text) }
    if e.kind == .Text {
        let quoted = cString(t.text)
        return value(&g, .Str, format("(yv_str){${quoted}, ${t.text.len()}}"))
    }
    if e.kind == .Name {
        let index = localIndex(g, ts, e.token)
        if index < 0 {
            if types.lookup(reg, ts, e.token) >= 0 {
                return err(problem(ts, e.token, "E0001", "a type name is not a value"))
            }
            return err(problem(ts, e.token, "E0010", format("unknown local '${t.text}'")))
        }
        try readable(g, ts, index, e.token)
        let local = g.locals[index]
        let name = format("v_${local.token}")
        if types.owned(reg, local.ty) { return Value{ty: local.ty, name: name, local: index, root: index} }
        return typedValue(&g, reg, local.ty, name)
    }
    if e.kind == .Unary {
        let child = p.expressions[unparenthesized(p, e.left)]
        if t.text == "-" && child.kind == .Number && minimumMagnitude(ts[child.token].text) {
            return value(&g, .Int, "INT64_MIN")
        }
        let arg = try emitExpr(&g, p, ts, reg, e.left)
        if t.text == "!" {
            try basic(reg, ts, e.token, arg.ty, .Bool)
            return value(&g, .Bool, format("(!${arg.name})"))
        }
        try basic(reg, ts, e.token, arg.ty, .Int)
        return value(&g, .Int, format("yv_neg_i64(${arg.name}, ${t.line}, ${t.column})"))
    }
    if e.kind == .Binary { return binary(&g, p, ts, reg, e) }
    if e.kind == .Variant { return enumValue(&g, reg, ts, e.token, expected) }
    if e.kind == .Construct { return construct(&g, p, ts, reg, e) }
    if e.kind == .Vector { return vectorValue(&g, p, ts, reg, e, expected) }
    if e.kind == .Index { return indexValue(&g, p, ts, reg, e) }
    if e.kind == .Field { return fieldValue(&g, p, ts, reg, e) }
    if e.kind == .Method { return method(&g, p, ts, reg, e) }
    return call(&g, p, ts, reg, e, id)
}

fn placeRoot(p: Program, id: int) -> int {
    var current = id
    loop {
        let e = p.expressions[current]
        if e.kind == .Name { return e.token }
        if e.kind != .Paren && e.kind != .Field && e.kind != .Index { return -1 }
        current = e.left
    }
}

// Determine assignment context without evaluating the receiver or index. Indexed
// assignment evaluates the RHS before locating its slot, including compound writes.
fn placeType(g: Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, depth: int) -> Place ! Failure {
    let e = p.expressions[id]
    if depth >= 256 { return err(problem(ts, e.token, "U0001", "selfhost place nesting limit (256) exceeded")) }
    if e.kind == .Paren { return placeType(g, p, ts, reg, e.left, depth + 1) }
    if e.kind == .Name {
        let index = localIndex(g, ts, e.token)
        if index < 0 { return err(problem(ts, e.token, "E0010", "assignment to an unknown local")) }
        let local = g.locals[index]
        return Place{ty: local.ty, name: format("v_${local.token}"), mutable: local.mutable, root: index}
    }
    if e.kind == .Field {
        let base = try placeType(g, p, ts, reg, e.left, depth + 1)
        if base.ty.kind != .Named || reg.entries[base.ty.decl].kind != .Struct {
            return err(problem(ts, e.token, "E0001", "field assignment requires a struct"))
        }
        let fieldIndex = types.field(reg, ts, base.ty.decl, e.token)
        if fieldIndex < 0 { return err(problem(ts, e.token, "E0010", "unknown struct field")) }
        let ty = reg.entries[base.ty.decl].fields[fieldIndex].ty
        return Place{ty: ty, name: format("(${base.name}).f_${fieldIndex}"),
            mutable: base.mutable, root: base.root, whole: false, indexed: base.indexed}
    }
    if e.kind == .Index {
        if placeRoot(p, e.left) < 0 {
            return err(problem(ts, e.token, "E0014", "cannot assign through a temporary container"))
        }
        let base = try placeType(g, p, ts, reg, e.left, depth + 1)
        if stringLike(base.ty) { return err(problem(ts, e.token, "U0001", "text indexing is outside this subset")) }
        if base.ty.kind != .Vec { return err(problem(ts, e.token, "E0001", "indexed assignment requires a vector")) }
        if types.owned(reg, types.element(base.ty)) {
            return err(problem(ts, e.token, "U0001", "indexed places for owned vector elements are outside this subset"))
        }
        return Place{ty: types.element(base.ty), name: String{},
            mutable: base.mutable, root: base.root, whole: false, indexed: true}
    }
    return err(problem(ts, e.token, "U0001", "assignment to this form is outside the supported place syntax"))
}

fn place(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, depth: int) -> Place ! Failure {
    let e = p.expressions[id]
    if depth >= 256 { return err(problem(ts, e.token, "U0001", "selfhost place nesting limit (256) exceeded")) }
    if e.kind == .Paren { return place(&g, p, ts, reg, e.left, depth + 1) }
    if e.kind == .Field {
        let base = try place(&g, p, ts, reg, e.left, depth + 1)
        try readable(g, ts, base.root, e.token)
        if base.ty.kind != .Named || reg.entries[base.ty.decl].kind != .Struct {
            return err(problem(ts, e.token, "E0001", "field assignment requires a struct"))
        }
        let fieldIndex = types.field(reg, ts, base.ty.decl, e.token)
        if fieldIndex < 0 { return err(problem(ts, e.token, "E0010", "unknown struct field")) }
        let ty = reg.entries[base.ty.decl].fields[fieldIndex].ty
        return Place{ty: ty, name: format("(${base.name}).f_${fieldIndex}"),
            mutable: base.mutable, root: base.root, whole: false, indexed: base.indexed}
    }
    if e.kind == .Index {
        let shape = try placeType(g, p, ts, reg, id, depth)
        if !shape.mutable { return err(problem(ts, e.token, "E0014", "cannot modify a read-only container")) }
        let base = try place(&g, p, ts, reg, e.left, depth + 1)
        try readable(g, ts, base.root, e.token)
        try writable(g, ts, base.root, e.token)
        g.reservations.push(base.root)
        let index = try emitExpected(&g, p, ts, reg, e.right, types.primitive(.Int))
        try basic(reg, ts, e.token, index.ty, .Int)
        let _removed = g.reservations.pop()
        let n = g.counter
        g.counter += 1
        let et = types.cType(shape.ty)
        let t = ts[e.token]
        line(&g, format("${et} *slot_${n} = (${et} *)yv_vec_at(&(${base.name}), (int64_t)sizeof(${et}), ${index.name}, ${t.line}, ${t.column});"))
        return Place{ty: shape.ty, name: format("(*slot_${n})"),
            mutable: base.mutable, root: base.root, whole: false, indexed: true}
    }
    return placeType(g, p, ts, reg, id, depth)
}


fn popLoop(g: inout Generator) -> LoopState {
    assert(g.loopStates.len() > 0)
    let i = g.loopStates.len() - 1
    let frame = LoopState{localCount: g.loopStates[i].localCount,
        tempCount: g.loopStates[i].tempCount,
        breaks: g.loopStates[i].breaks.clone(),
        continues: g.loopStates[i].continues.clone(),
        hasBreak: g.loopStates[i].hasBreak}
    let _removed = g.loopStates.pop()
    return frame
}

fn block(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, body: Vec[int]) -> Flow ! Failure {
    let localCount = g.locals.len()
    var flow = Flow{}
    line(&g, "{")
    for id in body {
        let tempCount = g.temps.len()
        let next = try statement(&g, p, ts, reg, id)
        discardTemps(&g, reg, tempCount)
        // Stage0 counts syntactic breaks, including after a terminating statement.
        flow.breaks = flow.breaks || next.breaks
        if flow.falls { flow.falls = next.falls }
    }
    cleanLocals(&g, reg, localCount)
    while g.locals.len() > localCount { let _removed = g.locals.pop() }
    line(&g, "}")
    return flow
}

fn recordExit(g: inout Generator, breaking: bool) {
    let index = g.loopStates.len() - 1
    let count = g.loopStates[index].localCount
    var state: Vec[bool] = []
    for i in 0..count { state.push(g.locals[i].moved) }
    if breaking {
        if g.loopStates[index].hasBreak {
            let previous = g.loopStates[index].breaks.clone()
            state = joinStates(previous, state)
        }
        g.loopStates[index].breaks = state
        g.loopStates[index].hasBreak = true
    } else {
        let previous = g.loopStates[index].continues.clone()
        if previous.len() > 0 { state = joinStates(previous, state) }
        g.loopStates[index].continues = state
    }
}

// Recheck only the body, as stage0 does. Only newly exposed move errors escape;
// generated C and transient analysis state belong to this disposable generator.
fn replayBody(parent: Generator, p: Program, ts: Vec[Token], reg: Registry, s: Statement, next: Vec[bool]) -> Vec[bool] ! Failure {
    var probe = Generator{
        counter: parent.counter,
        locals: parent.locals.clone(),
        temps: parent.temps.clone(),
        locks: parent.locks.clone(),
        binaryLocks: parent.binaryLocks.clone(),
        accessLocks: parent.accessLocks.clone(),
        reservations: parent.reservations.clone(),
        loopStates: parent.loopStates.clone(),
        result: parent.result,
        loops: parent.loops + 1
    }
    restoreState(&probe, next)
    let count = probe.locals.len()
    let tempCount = probe.temps.len()
    probe.loopStates.push(LoopState{localCount: count, tempCount: tempCount})
    let _flow = block(&probe, p, ts, reg, s.body) catch failure {
        if failure.code == "E0402" { return err(failure) }
        let empty: Vec[bool] = []
        return empty
    }
    let frame = popLoop(&probe)
    return frame.breaks.clone()
}

fn loopStatement(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, s: Statement) -> Flow ! Failure {
    line(&g, "for (;;) {")
    if s.kind == .While {
        let tempCount = g.temps.len()
        g.loopCondition = true
        let condition = try emitExpected(&g, p, ts, reg, s.expr, types.primitive(.Bool))
        g.loopCondition = false
        try basic(reg, ts, s.token, condition.ty, .Bool)
        discardTemps(&g, reg, tempCount)
        line(&g, format("if (!${condition.name}) break;"))
    }
    let before = movedState(g)
    let count = g.locals.len()
    let tempCount = g.temps.len()
    g.loopStates.push(LoopState{localCount: count, tempCount: tempCount})
    g.loops += 1
    let inner = try block(&g, p, ts, reg, s.body)
    g.loops -= 1
    let frame = popLoop(&g)
    let ended = movedState(g)
    let end = joinStates(ended, frame.continues)
    let next = joinStates(before, end)
    var exits = frame.breaks.clone()
    var grew = false
    for i in 0..before.len() {
        if next[i] && !before[i] { grew = true }
    }
    if grew {
        let repeated = try replayBody(g, p, ts, reg, s, next)
        if exits.len() == 0 { exits = repeated } else { exits = joinStates(exits, repeated) }
    }
    if s.kind == .Loop && frame.hasBreak {
        restoreState(&g, exits)
    } else {
        let after = joinStates(next, exits)
        restoreState(&g, after)
    }
    line(&g, "}")
    return Flow{falls: s.kind == .While || inner.breaks}
}

fn statement(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int) -> Flow ! Failure {
    let s = p.statements[id]
    if s.kind == .Bind {
        var ty = try types.resolve(reg, ts, s.annotation)
        let initial = try emitExpected(&g, p, ts, reg, s.expr, ty)
        if ty.kind == .Unknown && initial.indexedBorrow && !initial.field {
            if ts[s.name].text == "_" { return Flow{} }
            return err(problem(ts, s.token, "U0001", "persistent indexed-element borrows are outside this subset"))
        }
        if ty.kind == .Unknown { ty = initial.ty }
        try require(reg, ts, s.token, initial.ty, ty)
        let taken = try takeValue(&g, reg, ts, s.token, initial)
        if ts[s.name].text != "_" {
            try declare(&g, ts, s.name, ty, s.mutable, false)
            line(&g, format("${types.cType(ty)} v_${s.name} = ${taken.name};"))
            zeroValue(&g, reg, taken)
        }
        return Flow{}
    }
    if s.kind == .Assign {
        var target = try placeType(g, p, ts, reg, s.target, 0)
        if !target.indexed {
            if !target.mutable { return err(problem(ts, s.token, "E0014", "cannot assign through an immutable local or parameter")) }
            if !target.whole { try readable(g, ts, target.root, s.token) }
            try writable(g, ts, target.root, s.token)
        }
        let rhs = try emitExpected(&g, p, ts, reg, s.expr, target.ty)
        try require(reg, ts, s.token, rhs.ty, target.ty)
        if ts[s.token].text == "=" {
            let taken = try takeValue(&g, reg, ts, s.token, rhs)
            if target.indexed { target = try place(&g, p, ts, reg, s.target, 0) }
            if !target.whole { try readable(g, ts, target.root, s.token) }
            dropValue(&g, reg, target.ty, target.name)
            line(&g, format("${target.name} = ${taken.name};"))
            zeroValue(&g, reg, taken)
            if target.whole { g.locals[target.root].moved = false }
        } else {
            if target.indexed { target = try place(&g, p, ts, reg, s.target, 0) }
            try readable(g, ts, target.root, s.token)
            try basic(reg, ts, s.token, target.ty, .Int)
            let code = integerOperation(ts, s.token, ts[s.token].text, target.name, rhs.name)
            line(&g, format("${target.name} = ${code};"))
        }
        return Flow{}
    }
    if s.kind == .Expr {
        let kind = p.expressions[s.expr].kind
        if kind != .Call && kind != .Method {
            return err(problem(ts, s.token, "E0001", "only a direct call may stand alone as a statement"))
        }
        g.outputRoot = s.expr
        let _ignored = try emitExpr(&g, p, ts, reg, s.expr)
        g.outputRoot = -1
        return Flow{}
    }
    if s.kind == .Return {
        if s.expr < 0 {
            try require(reg, ts, s.token, types.primitive(.Unit), g.result)
            cleanTemps(&g, reg, 0)
            cleanLocals(&g, reg, 0)
            line(&g, "return;")
        } else {
            if g.result.kind == .Unit && p.expressions[s.expr].kind != .Unit {
                return err(problem(ts, s.token, "E0001", "a unit-returning function cannot return a value"))
            }
            let resultType = g.result
            let returned = try emitExpected(&g, p, ts, reg, s.expr, resultType)
            try require(reg, ts, s.token, returned.ty, resultType)
            if returned.ty.kind == .Unit {
                cleanTemps(&g, reg, 0)
                cleanLocals(&g, reg, 0)
                line(&g, "return;")
            } else {
                let taken = try takeValue(&g, reg, ts, s.token, returned)
                let n = g.counter
                g.counter += 1
                line(&g, format("${types.cType(taken.ty)} return_${n} = ${taken.name};"))
                zeroValue(&g, reg, taken)
                cleanTemps(&g, reg, 0)
                cleanLocals(&g, reg, 0)
                line(&g, format("return return_${n};"))
            }
        }
        return Flow{falls: false}
    }
    if s.kind == .If {
        let tempCount = g.temps.len()
        let condition = try emitExpected(&g, p, ts, reg, s.expr, types.primitive(.Bool))
        try basic(reg, ts, s.token, condition.ty, .Bool)
        discardTemps(&g, reg, tempCount)
        let before = movedState(g)
        line(&g, format("if (${condition.name})"))
        let yes = try block(&g, p, ts, reg, s.body)
        let yesState = movedState(g)
        restoreState(&g, before)
        var no = Flow{}
        if s.otherwise.len() > 0 {
            line(&g, "else")
            no = try block(&g, p, ts, reg, s.otherwise)
        }
        let noState = movedState(g)
        if yes.falls && !no.falls { restoreState(&g, yesState)
        } else if !yes.falls && no.falls { restoreState(&g, noState)
        } else {
            let merged = joinStates(yesState, noState)
            restoreState(&g, merged)
        }
        return Flow{falls: yes.falls || no.falls, breaks: yes.breaks || no.breaks}
    }
    if s.kind == .While || s.kind == .Loop { return loopStatement(&g, p, ts, reg, s) }
    if g.loops == 0 { return err(problem(ts, s.token, "E0015", "break/continue requires an enclosing loop")) }
    let index = g.loopStates.len() - 1
    let localCount = g.loopStates[index].localCount
    let tempCount = g.loopStates[index].tempCount
    recordExit(&g, s.kind == .Break)
    cleanTemps(&g, reg, tempCount)
    cleanLocals(&g, reg, localCount)
    if s.kind == .Break {
        line(&g, "break;")
        return Flow{falls: false, breaks: true}
    }
    line(&g, "continue;")
    return Flow{falls: false}
}

fn signature(p: Program, ts: Vec[Token], reg: Registry, index: int) -> String ! Failure {
    let f = p.functions[index]
    var params: Vec[String] = []
    for param in f.params {
        let ty = try types.resolve(reg, ts, param.ty)
        if ty.kind == .Unit { return err(problem(ts, param.name, "U0001", "unit parameters are outside the selfhost subset")) }
        params.push(format("${types.cType(ty)} v_${param.name}"))
    }
    var args = params.join(", ")
    if params.len() == 0 { args = "void".toString() }
    let result = try types.resolve(reg, ts, f.result)
    return format("static ${types.cType(result)} sh_fn_${index}(${args})")
}

fn vectorLifecycle(g: inout Generator, reg: Registry, elem: Type) {
    let ty = Type{kind: .Vec, elementKind: elem.kind, elementDecl: elem.decl}
    let et = types.cType(elem)
    let stem = vectorHelper(ty)
    line(&g, format("static void sh_vec_drop_${stem}(yv_vec *p) {"))
    line(&g, format("${et} *items = (${et} *)p->ptr;"))
    line(&g, "for (int64_t i = 0; i < p->len; ++i) {")
    line(&g, format("${dropName(reg, elem)}(&items[i]);"))
    line(&g, "}")
    line(&g, "yv_vec_free(p);")
    line(&g, "}")
    line(&g, format("static yv_vec sh_vec_clone_${stem}(const yv_vec *p, uint32_t line, uint32_t col) {"))
    line(&g, format("const ${et} *items = (const ${et} *)p->ptr;"))
    line(&g, format("yv_vec out = yv_vec_with_cap((int64_t)sizeof(${et}), p->len, line, col);"))
    line(&g, "for (int64_t i = 0; i < p->len; ++i) {")
    let cloned = cloneExpression(reg, elem, "items[i]", "line", "col")
    line(&g, format("((${et} *)out.ptr)[i] = ${cloned};"))
    line(&g, "out.len = i + 1;")
    line(&g, "}")
    line(&g, "return out;")
    line(&g, "}")
}

fn declarations(g: inout Generator, reg: Registry) {
    for i in 0..reg.entries.len() {
        if reg.entries[i].kind == .Enum { line(&g, format("typedef int64_t sh_type_${i};")) }
    }
    for i in reg.order {
        let item = reg.entries[i]
        if item.kind == .Struct {
            line(&g, format("typedef struct sh_type_${i} {"))
            if item.fields.len() == 0 { line(&g, "char sh_empty;") }
            for j in 0..item.fields.len() { line(&g, format("${types.cType(item.fields[j].ty)} f_${j};")) }
            line(&g, format("} sh_type_${i};"))
        }
    }

    // Every named C layout is complete. Lifecycle prototypes break indirect
    // dependency cycles such as Node -> Vec[Node] without recursive discovery.
    line(&g, "static void sh_vec_drop_string(yv_vec *p);")
    line(&g, "static yv_vec sh_vec_clone_string(const yv_vec *p, uint32_t line, uint32_t col);")
    for i in reg.order {
        if reg.entries[i].owned {
            line(&g, format("static void sh_drop_${i}(sh_type_${i} *p);"))
            line(&g, format("static sh_type_${i} sh_clone_${i}(const sh_type_${i} *p, uint32_t line, uint32_t col);"))
            line(&g, format("static void sh_vec_drop_type_${i}(yv_vec *p);"))
            line(&g, format("static yv_vec sh_vec_clone_type_${i}(const yv_vec *p, uint32_t line, uint32_t col);"))
        }
    }
    line(&g, "static yv_vec sh_vec_clone_copy(const yv_vec *p, int64_t elem, uint32_t line, uint32_t col) {")
    line(&g, "yv_vec out = yv_vec_with_cap(elem, p->len, line, col);")
    line(&g, "if (p->len > 0) memcpy(out.ptr, p->ptr, (size_t)p->len * (size_t)elem);")
    line(&g, "out.len = p->len;")
    line(&g, "return out;")
    line(&g, "}")
    vectorLifecycle(&g, reg, types.primitive(.String))
    for i in reg.order {
        if reg.entries[i].owned {
            vectorLifecycle(&g, reg, Type{kind: .Named, decl: i, elementKind: .Unknown})
        }
    }
    for i in reg.order {
        if reg.entries[i].owned {
            line(&g, format("static void sh_drop_${i}(sh_type_${i} *p) {"))
            let item = reg.entries[i]
            var j = item.fields.len()
            while j > 0 {
                j -= 1
                let ty = item.fields[j].ty
                if types.owned(reg, ty) { line(&g, format("${dropName(reg, ty)}(&p->f_${j});")) }
            }
            line(&g, format("*p = (sh_type_${i}){0};"))
            line(&g, "}")
            line(&g, format("static sh_type_${i} sh_clone_${i}(const sh_type_${i} *p, uint32_t line, uint32_t col) {"))
            line(&g, format("sh_type_${i} out = *p;"))
            for field in 0..item.fields.len() {
                let ty = item.fields[field].ty
                if types.owned(reg, ty) {
                    let cloned = cloneExpression(reg, ty, format("p->f_${field}"), "line", "col")
                    line(&g, format("out.f_${field} = ${cloned};"))
                }
            }
            line(&g, "return out;")
            line(&g, "}")
        }
    }
}

pub fn generate(p: Program, ts: Vec[Token], filename: str) -> String ! Failure {
    let reg = try types.collect(p, ts)
    var entry = -1
    for i in 0..p.functions.len() {
        let f = p.functions[i]
        let name = ts[f.name].text.clone()
        if reservedFunction(name) { return err(problem(ts, f.name, "E0011", "cannot redefine a builtin")) }
        for j in 0..i {
            if ts[p.functions[j].name].text == name {
                return err(problem(ts, f.name, "E0011", "duplicate function"))
            }
        }
        if name == "main" {
            if f.params.len() != 0 || f.result.kind != .Unit {
                return err(problem(ts, f.name, "E0016", "entry point must be fn main()"))
            }
            entry = i
        }
    }
    if entry < 0 { return err(problem(ts, 0, "E0016", "no fn main() entry point")) }
    var g = Generator{result: types.primitive(.Unit)}
    line(&g, "/* Generated by Yavo selfhost (read-only indexed element subset). */")
    line(&g, "#include \"yavo_rt.h\"")
    declarations(&g, reg)
    for i in 0..p.functions.len() {
        let header = try signature(p, ts, reg, i)
        line(&g, format("${header};"))
    }
    for i in 0..p.functions.len() {
        let f = p.functions[i]
        g.result = try types.resolve(reg, ts, f.result)
        for param in f.params {
            let ty = try types.resolve(reg, ts, param.ty)
            try declare(&g, ts, param.name, ty, false, types.owned(reg, ty))
        }
        let header = try signature(p, ts, reg, i)
        line(&g, header)
        let flow = try block(&g, p, ts, reg, f.body)
        if g.result.kind != .Unit && flow.falls {
            return err(problem(ts, f.name, "E0013", "not every path returns a value"))
        }
        while g.locals.len() > 0 { let _removed = g.locals.pop() }
    }
    let file = cString(filename)
    line(&g, "int main(int argc, char **argv) {")
    line(&g, format("yv_rt_init(${file});"))
    line(&g, "yv_rt_args(argc, argv);")
    line(&g, format("sh_fn_${entry}();"))
    line(&g, "return yv_rt_exit();")
    line(&g, "}")
    return take(&g.out)
}
