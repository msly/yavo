use support
use lexer
use model
use types

// Typed C lowering. Every value is materialized in source order.
// Owned values have one owner; borrowed reads and statement temporaries are explicit.

// sources: for a str local, the parameters its text may point into (bit k
// is parameter k; static data has no bit). Persistent str values never point
// into owned locals in this subset, so parameters are the only lifetimes.
struct Local {
    token: int
    ty: Type
    mutable: bool
    borrowed: bool = false
    moved: bool = false
    byRef: bool = false
    sources: int = 0
    // A read-only view of an owned element of the vector a for loop iterates.
    element: bool = false
}

// transient: a str view into an owned String; it may not outlive its statement.
// sources: as for Local, for a non-transient str value.
struct Value {
    ty: Type
    name: String
    local: int = -1
    root: int = -1
    field: bool = false
    indexedBorrow: bool = false
    temporary: bool = false
    transient: bool = false
    sources: int = 0
}

// Expected types can acquire extra Optional layers while checking ??, even
// when the actual expression independently infers a supported Copy value.
// These layers are hints only: symbolic values never reach C materialization.
struct Hint {
    ty: Type
    extra: int = 0
}

struct HintedValue {
    value: Value
    extra: int = 0
}

struct Place {
    ty: Type
    name: String
    mutable: bool
    root: int
    whole: bool = true
    indexed: bool = false
}

// Statement temporaries are always named t_<id>.
struct Temporary {
    ty: Type
    id: int
}

// Exit states live in Generator.exits: localCount break flags, then localCount
// continue flags, starting at exitBase.
struct LoopState {
    localCount: int
    tempCount: int
    exitBase: int
    hasBreak: bool = false
    hasContinue: bool = false
}

struct LoopExit {
    breaks: Vec[bool]
    continues: Vec[bool]
    hasBreak: bool
    breakSources: Vec[int]
    continueSources: Vec[int]
}

// A replayed loop body: its break states and the source state that reaches
// the next iteration (the end of the body joined with its continue paths).
struct Replay {
    breaks: Vec[bool]
    breakSources: Vec[int]
    nextSources: Vec[int]
}

struct Flow {
    falls: bool = true
    breaks: bool = false
}

struct Generator {
    out: String = ""
    counter: int = 0
    locals: Vec[Local] = []
    temps: Vec[Temporary] = []
    locks: Vec[int] = []
    binaryLocks: Vec[int] = []
    accessLocks: Vec[int] = []
    iterationLocks: Vec[int] = []
    reservations: Vec[int] = []
    inoutLocks: Vec[int] = []
    loopStates: Vec[LoopState] = []
    exits: Vec[bool] = []
    sourceExits: Vec[int] = []
    result: Type
    allowed: int = 0
    loops: int = 0
    nesting: int = 0
    outputRoot: int = -1
    jumpExpr: int = -1
    loopCondition: bool = false
    file: int = 0
    // Map[String, V] instances whose helpers are spliced in at mapAt.
    maps: Vec[Type] = []
    mapAt: int = 0
}

fn require(reg: Registry, ts: Vec[Token], token: int, actual: Type, expected: Type) {
    if !types.same(actual, expected) {
        var message = support.join2("expected ", types.describe(reg, ts, expected))
        message.push(", found ")
        message.push(types.describe(reg, ts, actual))
        lexer.fail(ts, token, "E0001", message)
    }
}

fn basic(reg: Registry, ts: Vec[Token], token: int, actual: Type, expected: BasicType) {
    require(reg, ts, token, actual, types.primitive(expected))
}

fn integerType(ty: Type) -> bool { return ty.kind == .Int || ty.kind == .Byte }

fn requireInteger(ts: Vec[Token], token: int, ty: Type) {
    if !integerType(ty) {
        lexer.fail(ts, token, "E0001", "expected an integer value")
    }
}

fn pushDigit(out: inout String, d: int) {
    out.push("0123456789"[d..d + 1])
}

// Three octal digits per byte preserve UTF-8/NUL without C escape ambiguity.
pub fn cString(text: str) -> String {
    var out = "\"".toString()
    var i = 0
    while i < text.len() {
        let b = int(text[i])
        out.push("\\")
        pushDigit(&out, b / 64)
        pushDigit(&out, (b / 8) % 8)
        pushDigit(&out, b % 8)
        i += 1
    }
    out.push("\"")
    return out
}

fn put(g: inout Generator, text: str) {
    g.out.push(text)
}

fn emit(g: inout Generator, text: str) {
    g.out.push(text)
    g.out.push("\n")
}

fn temporaryName(id: int) -> String {
    return format("t_${id}")
}

fn typedValue(g: inout Generator, reg: Registry, ty: Type, expression: str) -> Value {
    let n = g.counter
    g.counter += 1
    let name = temporaryName(n)
    put(&g, types.cType(ty))
    put(&g, " ")
    put(&g, name)
    put(&g, " = ")
    put(&g, expression)
    emit(&g, ";")
    let isOwned = types.owned(reg, ty)
    if isOwned { g.temps.push(Temporary{ty: ty, id: n}) }
    return Value{ty: ty, name: name, temporary: isOwned}
}

fn scalar(g: inout Generator, ty: BasicType, expression: str) -> Value {
    let n = g.counter
    g.counter += 1
    let name = temporaryName(n)
    let resolved = types.primitive(ty)
    put(&g, types.cType(resolved))
    put(&g, " ")
    put(&g, name)
    put(&g, " = ")
    put(&g, expression)
    emit(&g, ";")
    return Value{ty: resolved, name: name}
}

fn vectorHelper(ty: Type) -> String {
    if ty.elementKind == .String { return "string".toString() }
    return support.join2("type_", support.decimal(ty.elementDecl))
}

// Built-in numeric type names, used as conversions (`u8(x)`) and constant
// namespaces (`i64.min`) by stage0; the subset has only int and byte values.
fn numericTypeName(name: str) -> bool {
    return name == "int" || name == "byte" || name == "i8" || name == "i16" || name == "i32" ||
        name == "i64" || name == "u8" || name == "u16" || name == "u32" || name == "u64" ||
        name == "f32" || name == "f64"
}

fn mapHelper(ty: Type) -> String {
    if ty.elementKind == .Int { return "int".toString() }
    if ty.elementKind == .Bool { return "bool".toString() }
    return "byte".toString()
}

fn useMap(g: inout Generator, ty: Type) {
    var i = 0
    while i < g.maps.len() {
        if g.maps[i].elementKind == ty.elementKind { return }
        i += 1
    }
    g.maps.push(ty)
}

fn dropName(reg: Registry, ty: Type) -> String {
    if ty.kind == .String { return "yv_string_drop".toString() }
    if ty.kind == .Map { return support.join2("sh_map_drop_", mapHelper(ty)) }
    if ty.kind == .Result { return support.join2("sh_result_drop_", support.decimal(ty.decl)) }
    if ty.kind == .Vec {
        if types.owned(reg, types.element(ty)) {
            return support.join2("sh_vec_drop_", vectorHelper(ty))
        }
        return "yv_vec_free".toString()
    }
    return support.join2("sh_drop_", support.decimal(ty.decl))
}

// Struct cloning is internal to collection cloning, not a new user struct method.
// Copy fields retain their values; each owned field receives a distinct owner.
fn cloneExpression(reg: Registry, ty: Type, source: str, lineText: str, columnText: str) -> String {
    var out = String{}
    if ty.kind == .String {
        out.push("yv_string_from(yv_string_view(&(")
        out.push(source)
        out.push(")), ")
    } else if ty.kind == .Vec {
        let elem = types.element(ty)
        if types.owned(reg, elem) {
            out.push("sh_vec_clone_")
            out.push(vectorHelper(ty))
            out.push("(&(")
            out.push(source)
            out.push("), ")
        } else {
            out.push("sh_vec_clone_copy(&(")
            out.push(source)
            out.push("), (int64_t)sizeof(")
            out.push(types.cType(elem))
            out.push("), ")
        }
    } else if ty.kind == .Map {
        out.push("sh_map_clone_")
        out.push(mapHelper(ty))
        out.push("(&(")
        out.push(source)
        out.push("), ")
    } else if types.owned(reg, ty) {
        out.push("sh_clone_")
        out.push(support.decimal(ty.decl))
        out.push("(&(")
        out.push(source)
        out.push("), ")
    } else {
        return source.toString()
    }
    out.push(lineText)
    out.push(", ")
    out.push(columnText)
    out.push(")")
    return out
}

fn dropValue(g: inout Generator, reg: Registry, ty: Type, name: str) {
    if ty.kind == .Map { useMap(&g, ty) }
    if types.owned(reg, ty) {
        put(&g, dropName(reg, ty))
        put(&g, "(&(")
        put(&g, name)
        emit(&g, "));")
    }
}

fn zeroValue(g: inout Generator, reg: Registry, v: Value) {
    if types.owned(reg, v.ty) {
        put(&g, v.name)
        put(&g, " = (")
        put(&g, types.cType(v.ty))
        emit(&g, "){0};")
    }
}

fn cleanTemps(g: inout Generator, reg: Registry, start: int) {
    var i = g.temps.len()
    while i > start {
        i -= 1
        let ty = g.temps[i].ty
        let id = g.temps[i].id
        dropValue(&g, reg, ty, temporaryName(id))
    }
}

fn discardTemps(g: inout Generator, reg: Registry, start: int) {
    cleanTemps(&g, reg, start)
    while g.temps.len() > start { let _ = g.temps.pop() }
}

fn localName(local: Local) -> String {
    if local.byRef { return format("(*v_${local.token})") }
    return format("v_${local.token}")
}

fn cleanLocals(g: inout Generator, reg: Registry, start: int) {
    var i = g.locals.len()
    while i > start {
        i -= 1
        let local = g.locals[i]
        if !local.borrowed {
            dropValue(&g, reg, local.ty, localName(local))
        }
    }
}

fn movedState(g: Generator) -> Vec[bool] {
    var state: Vec[bool] = []
    var i = 0
    while i < g.locals.len() {
        state.push(g.locals[i].moved)
        i += 1
    }
    return state
}

fn restoreState(g: inout Generator, state: []bool) {
    var i = 0
    while i < state.len() {
        g.locals[i].moved = state[i]
        i += 1
    }
}

fn joinStates(a: Vec[bool], b: Vec[bool]) -> Vec[bool] {
    var out = a.clone()
    var i = 0
    while i < out.len() {
        if i < b.len() { out[i] = out[i] || b[i] }
        i += 1
    }
    return out
}

// Source states mirror moved states: restored before each alternative path
// and joined where paths meet, so a source taken on any path reaching a use
// is kept (stage0 loans, semantics O2/O4).
fn sourceState(g: Generator) -> Vec[int] {
    var state: Vec[int] = []
    var i = 0
    while i < g.locals.len() {
        state.push(g.locals[i].sources)
        i += 1
    }
    return state
}

fn restoreSources(g: inout Generator, state: []int) {
    var i = 0
    while i < state.len() && i < g.locals.len() {
        g.locals[i].sources = state[i]
        i += 1
    }
}

fn joinSources(a: []int, b: []int) -> Vec[int] {
    var out: Vec[int] = []
    var i = 0
    while i < a.len() || i < b.len() {
        var bits = 0
        if i < a.len() { bits = a[i] }
        if i < b.len() { bits = bits | b[i] }
        out.push(bits)
        i += 1
    }
    return out
}

fn sourcesGrew(before: []int, after: []int) -> bool {
    var i = 0
    while i < before.len() && i < after.len() {
        if (before[i] | after[i]) != before[i] { return true }
        i += 1
    }
    return false
}

// The state entering another iteration: the previous entry state joined
// with the end of the body and every continue path, for the outer locals.
fn iterationSources(before: []int, ended: []int, continues: []int) -> Vec[int] {
    let reached = joinSources(ended, continues)
    var out = joinSources(before, reached)
    while out.len() > before.len() { let _ = out.pop() }
    return out
}

fn sourceBit(index: int) -> int { return 1 << index }

fn contains(values: []int, wanted: int) -> bool {
    var i = 0
    while i < values.len() {
        if values[i] == wanted { return true }
        i += 1
    }
    return false
}

fn readable(g: Generator, ts: Vec[Token], root: int, token: int) {
    if root >= 0 && g.locals[root].moved {
        lexer.fail(ts, token, "E0402", "use of a moved value")
    }
    if root >= 0 && contains(g.inoutLocks, root) {
        lexer.fail(ts, token, "E0102", "an earlier call argument has exclusive access to this value")
    }
}

fn writable(g: Generator, ts: Vec[Token], root: int, token: int) {
    if contains(g.reservations, root) {
        lexer.fail(ts, token, "E0403", "mutation conflicts with a reserved receiver")
    }
    if contains(g.locks, root) {
        lexer.fail(ts, token, "E0102", "an earlier expression still borrows this value")
    }
    if contains(g.iterationLocks, root) {
        lexer.fail(ts, token, "E0102", "cannot modify a collection while iterating over it")
    }
    if contains(g.binaryLocks, root) {
        lexer.fail(ts, token, "U0001", "transferring a comparison operand while it is borrowed is outside this subset")
    }
    if contains(g.accessLocks, root) {
        lexer.fail(ts, token, "U0001", "moving or modifying an active index/reserve receiver is outside this subset")
    }
    if root >= 0 && contains(g.inoutLocks, root) {
        lexer.fail(ts, token, "E0102", "an earlier call argument has exclusive access to this value")
    }
}

fn copyValue(v: Value) -> Value {
    return Value{ty: v.ty, name: v.name.clone(), local: v.local,
        root: v.root, field: v.field, indexedBorrow: v.indexedBorrow, temporary: v.temporary,
        transient: v.transient, sources: v.sources}
}

fn takeValue(g: inout Generator, reg: Registry, ts: Vec[Token], token: int, v: Value) -> Value {
    if !types.owned(reg, v.ty) { return copyValue(v) }
    if v.indexedBorrow && !v.field {
        lexer.fail(ts, token, "E0404", "an indexed element is borrowed; clone it to obtain an owned value")
    }
    if v.field {
        lexer.fail(ts, token, "E0401", "cannot move an owned value out of a field; clone it")
    }
    if v.local >= 0 {
        readable(g, ts, v.local, token)
        if g.locals[v.local].byRef {
            lexer.fail(ts, token, "E0401", "cannot move out of an inout parameter; use take or clone")
        }
        if g.locals[v.local].element {
            lexer.fail(ts, token, "E0404", "an iterated element is borrowed; clone it to obtain an owned value")
        }
        if g.locals[v.local].borrowed {
            lexer.fail(ts, token, "E0401", "cannot move out of a read-only parameter; clone it")
        }
        writable(g, ts, v.local, token)
        if g.loopCondition {
            lexer.fail(ts, token, "U0001", "moving an existing owned value in a loop condition is outside this subset")
        }
        var taken = typedValue(&g, reg, v.ty, v.name)
        taken.sources = v.sources
        zeroValue(&g, reg, v)
        g.locals[v.local].moved = true
        return taken
    }
    if !v.temporary {
        lexer.fail(ts, token, "E0401", "cannot move an owned borrowed value")
    }
    return copyValue(v)
}

fn stringLike(ty: Type) -> bool { return ty.kind == .Str || ty.kind == .String }

fn view(v: Value) -> String {
    if v.ty.kind == .String { return support.join3("yv_string_view(&(", v.name, "))") }
    return v.name.clone()
}

fn releaseLocks(g: inout Generator, start: int) {
    while g.locks.len() > start { let _ = g.locks.pop() }
}

fn localIndex(g: Generator, ts: Vec[Token], token: int) -> int {
    var i = g.locals.len()
    while i > 0 {
        i -= 1
        if ts[g.locals[i].token].text == ts[token].text && ts[token].text != "_" { return i }
    }
    return -1
}

fn declare(g: inout Generator, ts: Vec[Token], token: int, ty: Type, mutable: bool, borrowed: bool, mode: bool) {
    if localIndex(g, ts, token) >= 0 {
        lexer.fail(ts, token, "E0011", "Yavo does not allow shadowing an active local")
    }
    if ty.kind == .Unit || ty.kind == .Unknown {
        lexer.fail(ts, token, "U0001", "unit-valued bindings are outside the selfhost subset")
    }
    g.locals.push(Local{token: token, ty: ty, mutable: mutable, borrowed: borrowed, byRef: mode})
}

// Unqualified calls see only the current file's functions; other modules'
// functions are always called as module.name(...).
fn functionIndex(g: Generator, p: Program, ts: Vec[Token], token: int) -> int {
    return functionIn(p, ts, g.file, token)
}

fn functionIn(p: Program, ts: Vec[Token], file: int, token: int) -> int {
    var i = 0
    while i < p.functions.len() {
        if p.functions[i].file == file && ts[p.functions[i].name].text == ts[token].text { return i }
        i += 1
    }
    return -1
}

// A module alias names an import of the current file unless a local shadows it.
fn moduleOf(g: Generator, reg: Registry, ts: Vec[Token], receiver: Expression) -> int {
    if receiver.kind != .Name || localIndex(g, ts, receiver.token) >= 0 { return -1 }
    return types.importedFile(reg, ts, receiver.token) ?? -1
}

fn outputBuiltin(name: str) -> bool {
    return name == "print" || name == "println" || name == "eprintln" || name == "assert"
}

fn reservedFunction(name: str) -> bool {
    return name == "print" || name == "println" || name == "eprintln" ||
        name == "i8" || name == "i16" || name == "i32" || name == "i64" ||
        name == "int" || name == "u8" || name == "byte" || name == "u16" ||
        name == "u32" || name == "u64" || name == "f32" || name == "f64" ||
        name == "bool" || name == "str" || name == "String" ||
        name == "Vec" || name == "Box" || name == "Set"
}

// Runtime helper stems; empty when the operator has no helper of that kind.
fn checkedStem(op: str) -> str of static {
    if op == "+" || op == "+=" { return "add" }
    if op == "-" || op == "-=" { return "sub" }
    if op == "*" || op == "*=" { return "mul" }
    if op == "/" || op == "/=" { return "div" }
    if op == "%" || op == "%=" { return "rem" }
    if op == "<<" { return "shl" }
    if op == ">>" { return "shr" }
    return ""
}

fn wrappingStem(op: str) -> str of static {
    if op == "+%" { return "addw" }
    if op == "-%" { return "subw" }
    if op == "*%" { return "mulw" }
    return ""
}

fn integerOperation(ts: Vec[Token], token: int, kind: BasicType, op: str, left: str, right: str) -> String {
    var suffix = "i64"
    if kind == .Byte { suffix = "u8" }
    var stem = checkedStem(op)
    var wrapping = false
    if stem.len() == 0 {
        stem = wrappingStem(op)
        wrapping = true
    }
    if stem.len() == 0 { return support.join5("(", left, support.join3(" ", op, " "), right, ")") }
    var out = support.join4("yv_", stem, "_", suffix)
    out.push("(")
    out.push(left)
    out.push(", ")
    out.push(right)
    if !wrapping {
        out.push(", ")
        out.push(support.decimal(ts[token].line + ts[token].lineBase))
        out.push(", ")
        out.push(support.decimal(ts[token].column))
    }
    out.push(")")
    return out
}

// Run-time locations use program-wide line numbers; the runtime maps them back
// to a file through the source table that generate() emits for module programs.
fn lineColumn(ts: Vec[Token], token: int) -> String {
    return format("${ts[token].line + ts[token].lineBase}, ${ts[token].column}")
}

fn printValue(g: inout Generator, reg: Registry, ts: Vec[Token], token: int, arg: Value, output: int) {
    if arg.ty.kind == .Optional { lexer.fail(ts, token, "U0001", "printing an Optional is outside this subset") }
    let target = support.join3("(&o_", support.decimal(output), ", ")
    if arg.ty.kind == .Int {
        put(&g, "yv_out_i64")
        put(&g, target)
        put(&g, arg.name)
        emit(&g, ");")
    } else if arg.ty.kind == .Byte {
        put(&g, "yv_out_u64")
        put(&g, target)
        put(&g, "(uint64_t)")
        put(&g, arg.name)
        emit(&g, ");")
    } else if arg.ty.kind == .Bool {
        put(&g, "yv_out_bool")
        put(&g, target)
        put(&g, arg.name)
        emit(&g, ");")
    } else if stringLike(arg.ty) {
        put(&g, "yv_out_str")
        put(&g, target)
        put(&g, view(arg))
        emit(&g, ");")
    } else if arg.ty.kind == .Named && reg.entries[arg.ty.decl].kind == .Enum {
        emit(&g, support.join3("switch (", arg.name, ") {"))
        let start = reg.entries[arg.ty.decl].variantStart
        let count = reg.entries[arg.ty.decl].variantCount
        var i = 0
        while i < count {
            let text = ts[reg.variants[start + i]].text.clone()
            put(&g, support.join3("case ", support.decimal(i), ": yv_out_bytes(&o_"))
            put(&g, support.decimal(output))
            put(&g, ", ")
            put(&g, cString(text))
            put(&g, ", ")
            put(&g, support.decimal(text.len()))
            emit(&g, "); break;")
            i += 1
        }
        emit(&g, "}")
    } else {
        lexer.fail(ts, token, "E0001", "this type cannot be printed")
    }
}

fn interpolationSpec(ts: Vec[Token], token: int, spec: int) {
    if spec < 0 { return }
    let text = ts[spec].text.clone()
    if text.len() >= 2 && text.len() <= 3 && text[0] == '.' {
        var digits = true
        var places = 0
        var i = 1
        while i < text.len() {
            if text[i] < '0' || text[i] > '9' { digits = false } else {
                places = places * 10 + int(text[i]) - int('0')
            }
            i += 1
        }
        if digits {
            if places > 17 { lexer.fail(ts, token, "E0001", "at most 17 decimal places can be printed") }
            lexer.fail(ts, token, "E0001", "fixed-decimal formatting requires a float")
        }
    }
    lexer.fail(ts, token, "U0001", "this format specifier is not supported")
}

// Keep only the write in the returned string. Operand evaluation remains in
// g.out, so every value is evaluated before any outer message bytes are written.
fn outputValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, spec: int, output: int) -> String {
    let token = p.expressions[id].token
    let arg = emitExpr(&g, p, ts, reg, id)
    interpolationSpec(ts, token, spec)
    if stringLike(arg.ty) && arg.root >= 0 { g.locks.push(arg.root) }
    var value = copyValue(arg)
    if arg.ty.kind == .String {
        // Snapshot a borrowed descriptor, not a second String owner. The
        // original owner stays alive in locals or statement temporaries.
        value = scalar(&g, .Str, view(arg))
    }
    let before = take(&g.out)
    printValue(&g, reg, ts, token, value, output)
    let writes = take(&g.out)
    g.out = before
    return writes
}

fn messageWrites(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, output: int) -> String {
    let locks = g.locks.len()
    let e = p.expressions[id]
    var writes = String{}
    // Parentheses are not transparent here: only a direct interpolated string
    // is a message. Elsewhere emitExpr rejects it with the ordinary E0001.
    if e.kind == .Interpolated {
        var i = 0
        while i < e.argCount {
            let part = p.stringParts[e.argStart + i]
            if part.expr < 0 {
                let text = ts[part.token].text.clone()
                if text.len() > 0 {
                    writes.push(support.join5("yv_out_bytes(&o_", support.decimal(output), ", ", cString(text), ", "))
                    writes.push(support.join3(support.decimal(text.len()), ");", "\n"))
                }
            } else {
                writes.push(outputValue(&g, p, ts, reg, part.expr, part.spec, output))
            }
            i += 1
        }
    } else {
        writes = outputValue(&g, p, ts, reg, id, -1, output)
    }
    releaseLocks(&g, locks)
    return writes
}

// A borrow argument names a mutable place; its root stays unavailable until the call ends.
fn refPlace(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int) -> Place {
    let token = p.expressions[id].token
    let target = p.expressions[id].left
    var current = target
    while p.expressions[current].kind == .Paren || p.expressions[current].kind == .Field {
        current = p.expressions[current].left
    }
    if p.expressions[current].kind != .Name {
        lexer.fail(ts, token, "U0001", "only variables and their fields can be passed as inout for now")
    }
    let shape = placeType(g, p, ts, reg, target, 0)
    if !shape.mutable { lexer.fail(ts, token, "E0014", "cannot modify a read-only value") }
    let target2 = placeOf(&g, p, ts, reg, target, 0)
    readable(g, ts, target2.root, token)
    writable(g, ts, target2.root, token)
    return target2
}

fn takeCall(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    if e.argCount != 1 { lexer.fail(ts, e.token, "E0012", "take requires one argument") }
    let argId = p.lists[e.argStart]
    if p.expressions[argId].kind != .Ref {
        lexer.fail(ts, p.expressions[argId].token, "E0001", "take requires a borrowed place written as &place")
    }
    let target = refPlace(&g, p, ts, reg, argId)
    if target.ty.kind != .String && target.ty.kind != .Vec {
        lexer.fail(ts, e.token, "U0001", "take is limited to String and Vec places in this subset")
    }
    var taken = typedValue(&g, reg, target.ty, target.name)
    // Like stage0, the emptied place keeps its sources.
    taken.sources = g.locals[target.root].sources
    put(&g, target.name)
    put(&g, " = (")
    put(&g, types.cType(target.ty))
    emit(&g, "){0};")
    return taken
}

fn callValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, id: int) -> Value {
    let name = ts[e.token].text.clone()
    if localIndex(g, ts, e.token) >= 0 {
        lexer.fail(ts, e.token, "E0001", "a local value cannot be called as a function")
    }
    let index = functionIndex(g, p, ts, e.token)
    if index < 0 && (name == "int" || name == "byte") {
        if e.argCount != 1 {
            lexer.fail(ts, e.token, "E0012", "an integer conversion requires one argument")
        }
        // Conversion arguments have no destination context: byte(256) is a
        // checked run-time conversion, unlike a byte-annotated literal.
        let arg = emitExpr(&g, p, ts, reg, p.lists[e.argStart])
        requireInteger(ts, e.token, arg.ty)
        var target: BasicType = .Int
        if name == "byte" { target = .Byte }
        if arg.ty.kind == target { return copyValue(arg) }
        var helper = "yv_conv_u8_i64(".toString()
        if target == .Byte { helper = "yv_conv_i64_u8(".toString() }
        return scalar(&g, target, support.join5(helper, arg.name, ", ", lineColumn(ts, e.token), ")"))
    }
    if index < 0 && name == "take" { return takeCall(&g, p, ts, reg, e) }
    if index < 0 && name == "format" {
        if e.argCount != 1 { lexer.fail(ts, e.token, "E0012", "format requires one argument") }
        let outputIndex = g.counter
        g.counter += 1
        let writes = messageWrites(&g, p, ts, reg, p.lists[e.argStart], outputIndex)
        // Register the result only after all operands succeed: a try in a later
        // operand must not clean a result whose declaration has not been emitted.
        let result = typedValue(&g, reg, types.primitive(.String), "(yv_string){0}")
        put(&g, support.join5("yv_out o_", support.decimal(outputIndex), " = {0, &", result.name, ", "))
        emit(&g, support.join2(lineColumn(ts, e.token), "};"))
        g.out.push(writes)
        return result
    }
    if index < 0 && outputBuiltin(name) {
        if name != "assert" && g.outputRoot != id {
            lexer.fail(ts, e.token, "E0001", "output calls must be direct statements")
        }
        if e.argCount != 1 {
            if e.argCount == 0 && (name == "println" || name == "eprintln") {
                lexer.fail(ts, e.token, "U0001", "zero-argument output is outside the selfhost subset")
            }
            if e.argCount == 2 && name == "assert" {
                lexer.fail(ts, e.token, "U0001", "assert messages are outside the selfhost subset")
            }
            lexer.fail(ts, e.token, "E0012", "selfhost output/assert calls require one argument")
        }
        if name == "assert" {
            let arg = emitExpected(&g, p, ts, reg, p.lists[e.argStart], types.primitive(.Bool))
            basic(reg, ts, e.token, arg.ty, .Bool)
            put(&g, support.join3("if (!", arg.name, ") yv_panic(\"P-ASSERT\", \"assertion failed\", "))
            put(&g, lineColumn(ts, e.token))
            emit(&g, ");")
        } else {
            var fd = 1
            if name == "eprintln" { fd = 2 }
            let outputIndex = g.counter
            g.counter += 1
            let writes = messageWrites(&g, p, ts, reg, p.lists[e.argStart], outputIndex)
            put(&g, support.join3("yv_out o_", support.decimal(outputIndex), " = {"))
            put(&g, support.decimal(fd))
            put(&g, ", NULL, ")
            put(&g, lineColumn(ts, e.token))
            emit(&g, "};")
            emit(&g, support.join3("yv_output_at(", lineColumn(ts, e.token), ");"))
            g.out.push(writes)
            if name != "print" {
                emit(&g, support.join3("yv_out_bytes(&o_", support.decimal(outputIndex), ", \"\\n\", 1);"))
            }
        }
        return Value{ty: types.primitive(.Unit), name: "".toString()}
    }
    if index < 0 {
        if name == "bool" || name == "panic" ||
            name == "some" || name == "replace" || name == "swap" {
            lexer.fail(ts, e.token, "U0001", "builtin is outside the selfhost subset")
        }
        if numericTypeName(name) {
            lexer.fail(ts, e.token, "U0001", "numeric conversions are outside the selfhost subset")
        }
        lexer.fail(ts, e.token, "E0010", support.join3("unknown function '", name, "'"))
    }
    return userCall(&g, p, ts, reg, e, index)
}

// A call of user function `index`; e supplies the argument list and location.
fn userCall(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, index: int) -> Value {
    let f = p.functions[index]
    if f.paramCount != e.argCount {
        lexer.fail(ts, e.token, "E0012", "wrong number of function arguments")
    }
    let locks = g.locks.len()
    let inoutMark = g.inoutLocks.len()
    let result = types.resolve(reg, ts, f.result)
    let borrowedResult = types.carriesBorrow(result) && f.sourced
    var sources = 0
    var viewed = false
    var viewRoot = -1
    var args = String{}
    var i = 0
    while i < e.argCount {
        let argId = p.lists[e.argStart + i]
        let argToken = p.expressions[argId].token
        let param = p.params[f.paramStart + i]
        let expected = types.resolve(reg, ts, param.ty)
        let named = borrowedResult && sourceListed(p, ts, f, param.name)
        if i > 0 { args.push(", ") }
        if param.byRef {
            if p.expressions[argId].kind != .Ref {
                lexer.fail(ts, argToken, "E0001", "an inout argument must be written as &place")
            }
            if named {
                lexer.fail(ts, argToken, "U0001", "borrowed returns from inout arguments are outside this subset")
            }
            let target = refPlace(&g, p, ts, reg, argId)
            require(reg, ts, argToken, target.ty, expected)
            args.push("&(")
            args.push(target.name)
            args.push(")")
            g.inoutLocks.push(target.root)
        } else {
            if p.expressions[argId].kind == .Ref {
                lexer.fail(ts, argToken, "U0001", "borrow arguments for read-only parameters are outside this subset")
            }
            let arg = emitExpected(&g, p, ts, reg, argId, expected)
            // Built-in view parameters accept String -> str and Vec[T] -> []T.
            let sliceView = expected.kind == .Slice && arg.ty.kind == .Vec &&
                types.same(types.element(arg.ty), types.element(expected))
            if expected.kind == .Str && arg.ty.kind == .String {
                args.push(view(arg))
            } else if sliceView {
                args.push(arg.name)
            } else {
                require(reg, ts, argToken, arg.ty, expected)
                args.push(arg.name)
            }
            // The result points where its listed arguments point. A view of an
            // owned String keeps that owner as the root of a transient result.
            // A vector of Copy elements lends only its elements' sources to a str
            // result; any other owner lends its own storage (stage0 recv_loans).
            // A view of a vector's storage ([]T parameter or []T result) borrows the vector.
            let copyVector = arg.ty.kind == .Vec && !types.owned(reg, types.element(arg.ty)) &&
                !sliceView && result.kind != .Slice
            if named && (arg.transient || (types.owned(reg, arg.ty) && !copyVector)) {
                if result.kind == .Vec {
                    lexer.fail(ts, argToken, "U0001", "vectors of views into owned values are outside this subset")
                }
                if viewed && viewRoot != arg.root {
                    lexer.fail(ts, argToken, "U0001", "borrowed returns viewing several owned strings are outside this subset")
                }
                viewed = true
                viewRoot = arg.root
            } else if named {
                sources = sources | arg.sources
            }
            if arg.root >= 0 { g.locks.push(arg.root) }
        }
        i += 1
    }
    let expression = support.join5("sh_fn_", support.decimal(index), "(", args, ")")
    releaseLocks(&g, locks)
    while g.inoutLocks.len() > inoutMark { let _ = g.inoutLocks.pop() }
    if result.kind == .Unit {
        emit(&g, support.join2(expression, ";"))
        return Value{ty: result, name: "".toString()}
    }
    var value = typedValue(&g, reg, result, expression)
    value.sources = sources
    if viewed {
        value.transient = true
        value.root = viewRoot
    }
    return value
}

// Whether a parameter is named by its function's `of` clause.
fn sourceListed(p: Program, ts: Vec[Token], f: Function, param: int) -> bool {
    var i = 0
    while i < f.sourceCount {
        if ts[p.lists[f.sourceStart + i]].text == ts[param].text { return true }
        i += 1
    }
    return false
}

// O1/O2 signature rules, checked before the body as stage0 does. Returns the
// parameters a returned str may point into.
fn allowedSources(p: Program, ts: Vec[Token], reg: Registry, index: int) -> int {
    let f = p.functions[index]
    let result = types.resolve(reg, ts, f.result)
    var borrowed = types.carriesBorrow(result)
    if result.kind == .Result { borrowed = types.carriesBorrow(types.resultOk(reg, result)) }
    if !f.sourced {
        if borrowed {
            var arrow = f.name
            while ts[arrow].text != "->" { arrow += 1 }
            lexer.fail(ts, arrow + 1, "E0302", "a returned str points into other data; the signature must say where with of")
        }
        return 0
    }
    var mask = 0
    var i = 0
    while i < f.sourceCount {
        let token = p.lists[f.sourceStart + i]
        if ts[token].text != "static" {
            var found = -1
            var k = 0
            while k < f.paramCount {
                if ts[p.params[f.paramStart + k].name].text == ts[token].text { found = k }
                k += 1
            }
            if found < 0 {
                lexer.fail(ts, token, "E0010", format("of ${ts[token].text}: there is no parameter with this name"))
            }
            if found >= 62 {
                lexer.fail(ts, token, "U0001", "returned borrows of a parameter after the 62nd are outside this subset")
            }
            mask = mask | sourceBit(found)
        }
        i += 1
    }
    if result.kind == .Result && borrowed {
        lexer.fail(ts, f.name, "U0001", "results carrying a borrowed str are outside this subset")
    }
    return mask
}

// O2: a returned str may point only into parameters listed after `of`, or
// into static data. Parameters are the first locals of a function.
fn returnedSources(g: Generator, p: Program, ts: Vec[Token], id: int, returned: Value) {
    let token = p.expressions[id].token
    if returned.transient {
        let root = returned.root
        if root >= 0 && g.locals[root].element {
            lexer.fail(ts, token, "U0001", "returning a view of an iterated element is outside this subset")
        }
        if root >= 62 && (g.locals[root].borrowed || g.locals[root].byRef) {
            lexer.fail(ts, token, "U0001", "returning a view of a String parameter is outside this subset")
        }
        if root >= 0 && (g.locals[root].borrowed || g.locals[root].byRef) {
            if (g.allowed & sourceBit(root)) == 0 {
                lexer.fail(ts, token, "E0303", "the returned value points into a parameter that of does not list")
            }
            lexer.fail(ts, token, "U0001", "returning a view of a String parameter is outside this subset")
        }
        lexer.fail(ts, token, "E0303", "the returned value points into a local or temporary that is dropped here")
    }
    if (returned.sources | g.allowed) != g.allowed {
        lexer.fail(ts, token, "E0303", "the returned value points into a parameter that of does not list")
    }
}

// Store a str value with these sources into a str or Vec[str] local: a whole
// assignment replaces the local's sources, push and element stores join them.
// O4: an inout parameter may only receive static text. Stage0 also keeps a loan
// on an inout parameter while a local still points into it (E0102 if that local
// is used later); without liveness, any such local blocks the write (U0001).
fn storeSources(g: inout Generator, ts: Vec[Token], token: int, root: int, sources: int,
    replace: bool, pushing: bool) {
    let local = g.locals[root]
    if local.byRef && types.carriesBorrow(local.ty) {
        let own = sourceBit(root)
        if pushing && (sources & own) != 0 {
            lexer.fail(ts, token, "E0403", "this argument still points into the receiver")
        }
        if sources != 0 {
            lexer.fail(ts, token, "E0306", "cannot store a borrow into the caller's inout parameter")
        }
        var i = 0
        while i < g.locals.len() {
            if i != root && (g.locals[i].sources & own) != 0 {
                lexer.fail(ts, token, "U0001", "modifying an inout parameter while a local points into it is outside this subset")
            }
            i += 1
        }
    }
    if replace {
        g.locals[root].sources = sources
    } else {
        g.locals[root].sources = local.sources | sources
    }
}

fn standardModule(g: Generator, p: Program, ts: Vec[Token], receiver: Expression) -> int {
    // 1: os, 2: fs, 3: String; 0 otherwise.
    if receiver.kind != .Name || localIndex(g, ts, receiver.token) >= 0 { return 0 }
    if ts[receiver.token].text == "os" && p.files[g.file].importsOs { return 1 }
    if ts[receiver.token].text == "fs" && p.files[g.file].importsFs { return 2 }
    if ts[receiver.token].text == "String" { return 3 }
    return 0
}

fn osCall(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    if ts[e.token].text == "exit" {
        if e.argCount != 1 { lexer.fail(ts, e.token, "E0012", "os.exit requires one argument") }
        let code = emitExpected(&g, p, ts, reg, p.lists[e.argStart], types.primitive(.Int))
        basic(reg, ts, e.token, code.ty, .Int)
        emit(&g, support.join3("yv_os_exit(", code.name, ");"))
        return Value{ty: types.primitive(.Unit), name: "".toString()}
    }
    if ts[e.token].text == "args" {
        if e.argCount != 0 { lexer.fail(ts, e.token, "E0012", "os.args takes no arguments") }
        return typedValue(&g, reg, types.primitive(.Args), "yv_args")
    }
    lexer.fail(ts, e.token, "U0001", "this os function is outside the selfhost subset")
    return Value{ty: types.primitive(.Unit), name: "".toString()}
}

fn methodValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let name = ts[e.token].text.clone()
    let receiver = p.expressions[e.left]
    let userModule = moduleOf(g, reg, ts, receiver)
    if userModule >= 0 {
        let index = functionIn(p, ts, userModule, e.token)
        if index < 0 || !p.functions[index].public {
            lexer.fail(ts, e.token, "E0010", support.join5("module '", ts[receiver.token].text, "' has no exported function '", name, "'"))
        }
        return userCall(&g, p, ts, reg, e, index)
    }
    let module = standardModule(g, p, ts, receiver)
    if module == 1 { return osCall(&g, p, ts, reg, e) }
    if module == 2 || (module == 3 && name == "fromUtf8") {
        lexer.fail(ts, e.token, "U0001", "fallible standard calls require `catch _ { ... }` in this subset")
    }
    if receiver.kind == .Name && localIndex(g, ts, receiver.token) < 0 {
        let declared = types.lookup(reg, ts, receiver.token)
        if declared >= 0 && reg.entries[declared].kind == .Enum {
            lexer.fail(ts, e.token, "U0001", "enum payload construction is outside this subset")
        }
    }
    if name == "pop" {
        let target = placeOf(&g, p, ts, reg, e.left, 0)
        readable(g, ts, target.root, e.token)
        if !target.mutable { lexer.fail(ts, e.token, "E0014", "cannot modify a read-only value") }
        if e.argCount != 0 { lexer.fail(ts, e.token, "E0012", "pop takes no arguments") }
        if target.ty.kind != .Vec { lexer.fail(ts, e.token, "U0001", "pop requires a Vec in this subset") }
        writable(g, ts, target.root, e.token)
        let elem = types.element(target.ty)
        let ty = types.optional(reg, ts, e.token, elem)
        let result = typedValue(&g, reg, ty, support.join3("(", types.cType(ty), "){0}"))
        emit(&g, support.join3("if ((", target.name, ").len > 0) {"))
        emit(&g, support.join3("(", target.name, ").len--;"))
        put(&g, support.join5(result.name, ".val = ((", types.cType(elem), " *)(", target.name))
        emit(&g, support.join3(").ptr)[(", target.name, ").len];"))
        emit(&g, support.join2(result.name, ".has = true;"))
        emit(&g, "}")
        return result
    }
    if name == "set" || name == "remove" { return mapUpdate(&g, p, ts, reg, e) }
    if name == "push" || name == "reserve" {
        let target = placeOf(&g, p, ts, reg, e.left, 0)
        readable(g, ts, target.root, e.token)
        if target.ty.kind == .Slice && !target.mutable {
            lexer.fail(ts, e.token, "E0014", "cannot modify a read-only value")
        }
        if target.ty.kind != .Vec && (name != "push" || target.ty.kind != .String) {
            lexer.fail(ts, e.token, "U0001", "this modifying method is outside the selfhost subset")
        }
        if !target.mutable { lexer.fail(ts, e.token, "E0014", "cannot modify a read-only value") }
        if e.argCount != 1 { lexer.fail(ts, e.token, "E0012", "this modifying method requires one argument") }
        writable(g, ts, target.root, e.token)
        let argId = p.lists[e.argStart]
        if name == "reserve" {
            // Stage0 accepts receiver consumption here but then reallocates a moved-from
            // descriptor. Keep that unresolved behavior outside this supported subset.
            let mark = g.accessLocks.len()
            g.accessLocks.push(target.root)
            let count = emitExpected(&g, p, ts, reg, argId, types.primitive(.Int))
            basic(reg, ts, e.token, count.ty, .Int)
            while g.accessLocks.len() > mark { let _ = g.accessLocks.pop() }
            let elem = types.element(target.ty)
            put(&g, support.join3("yv_vec_reserve(&(", target.name, "), (int64_t)sizeof("))
            put(&g, types.cType(elem))
            put(&g, support.join3("), ", count.name, ", "))
            put(&g, lineColumn(ts, e.token))
            emit(&g, ");")
        } else {
            let reservations = g.reservations.len()
            g.reservations.push(target.root)
            if target.ty.kind == .String {
                let arg = emitExpr(&g, p, ts, reg, argId)
                if !stringLike(arg.ty) { lexer.fail(ts, e.token, "E0001", "String.push requires str or String") }
                if arg.root == target.root {
                    lexer.fail(ts, e.token, "E0403", "push argument still borrows the receiver's root")
                }
                while g.reservations.len() > reservations { let _ = g.reservations.pop() }
                put(&g, support.join5("yv_string_push(&(", target.name, "), ", view(arg), ", "))
                put(&g, lineColumn(ts, e.token))
                emit(&g, ");")
            } else {
                let elem = types.element(target.ty)
                let arg = emitExpected(&g, p, ts, reg, argId, elem)
                require(reg, ts, p.expressions[argId].token, arg.ty, elem)
                if elem.kind == .Str {
                    if arg.transient {
                        lexer.fail(ts, p.expressions[argId].token, "U0001", "persistent views of owned strings are outside this subset")
                    }
                    storeSources(&g, ts, p.expressions[argId].token, target.root, arg.sources, false, true)
                }
                // Keep the receiver reserved until consuming the argument has checked
                // its source root; storing the value transfers ownership to the slot.
                let taken = takeValue(&g, reg, ts, p.expressions[argId].token, arg)
                while g.reservations.len() > reservations { let _ = g.reservations.pop() }
                let et = types.cType(elem)
                put(&g, support.join5("*(", et, " *)yv_vec_push_slot(&(", target.name, "), (int64_t)sizeof("))
                put(&g, et)
                put(&g, "), ")
                put(&g, lineColumn(ts, e.token))
                emit(&g, support.join3(") = ", taken.name, ";"))
                zeroValue(&g, reg, taken)
            }
        }
        return Value{ty: types.primitive(.Unit), name: "".toString()}
    }
    let base = emitExpr(&g, p, ts, reg, e.left)
    if stringLike(base.ty) {
        if name == "startsWith" || name == "endsWith" || name == "contains" || name == "find" ||
            name == "split" || name == "parseInt" {
            return textQuery(&g, p, ts, reg, e, base)
        }
        if name == "len" || (name == "toString" && base.ty.kind == .Str) ||
            (name == "clone" && base.ty.kind == .String) {
            if e.argCount != 0 { lexer.fail(ts, e.token, "E0012", "this string method takes no arguments") }
            if name == "len" {
                return scalar(&g, .Int, support.join3("(", view(base), ").len"))
            }
            return typedValue(&g, reg, types.primitive(.String),
                support.join5("yv_string_from(", view(base), ", ", lineColumn(ts, e.token), ")"))
        }
        lexer.fail(ts, e.token, "U0001", "string method is outside the selfhost subset")
    }
    if base.ty.kind == .Vec || base.ty.kind == .Args || base.ty.kind == .Slice {
        if name == "len" || (name == "clone" && base.ty.kind == .Vec) {
            if e.argCount != 0 { lexer.fail(ts, e.token, "E0012", "this vector method takes no arguments") }
            if name == "len" { return scalar(&g, .Int, support.join3("(", base.name, ").len")) }
            let cloned = cloneExpression(reg, base.ty, base.name,
                support.decimal(ts[e.token].line + ts[e.token].lineBase), support.decimal(ts[e.token].column))
            // A cloned Vec[str] owns new storage; its elements keep their sources.
            var copied = typedValue(&g, reg, base.ty, cloned)
            copied.sources = base.sources
            return copied
        }
        lexer.fail(ts, e.token, "U0001", "vector method is outside the selfhost subset")
    }
    if base.ty.kind == .Map { return mapQuery(&g, p, ts, reg, e, base) }
    if base.ty.kind == .Optional && (name == "isSome" || name == "isNone") {
        if e.argCount != 0 { lexer.fail(ts, e.token, "E0012", "this Optional method takes no arguments") }
        var code = support.join3("(", base.name, ").has")
        if name == "isNone" { code = support.join3("(!", code, ")") }
        return scalar(&g, .Bool, code)
    }
    if base.ty.kind == .Named && reg.entries[base.ty.decl].kind == .Struct {
        lexer.fail(ts, e.token, "E0010", "unknown struct method")
    }
    lexer.fail(ts, e.token, "U0001", "method is outside the selfhost subset")
    return Value{ty: types.primitive(.Unit), name: "".toString()}
}

// Map.set consumes an owned String key and a value; Map.remove takes a text
// query. Like push, the receiver is reserved while the arguments are evaluated
// (reads are allowed, E0403 on writes), and the key is taken before the value
// is evaluated (stage0: `m.set(k, m.getCopy(k) ?? 0)` is E0402).
fn mapUpdate(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let name = ts[e.token].text.clone()
    let target = placeOf(&g, p, ts, reg, e.left, 0)
    readable(g, ts, target.root, e.token)
    if target.ty.kind != .Map {
        lexer.fail(ts, e.token, "U0001", "this modifying method is outside the selfhost subset")
    }
    if !target.mutable { lexer.fail(ts, e.token, "E0014", "cannot modify a read-only value") }
    let s = mapHelper(target.ty)
    useMap(&g, target.ty)
    if name == "set" {
        if e.argCount != 2 { lexer.fail(ts, e.token, "E0012", "set takes a key and a value") }
    } else if e.argCount != 1 {
        lexer.fail(ts, e.token, "E0012", "remove takes exactly one argument")
    }
    writable(g, ts, target.root, e.token)
    let reservations = g.reservations.len()
    g.reservations.push(target.root)
    let keyId = p.lists[e.argStart]
    if name == "remove" {
        let query = emitExpected(&g, p, ts, reg, keyId, types.primitive(.Str))
        if !stringLike(query.ty) { require(reg, ts, p.expressions[keyId].token, query.ty, types.primitive(.Str)) }
        while g.reservations.len() > reservations { let _ = g.reservations.pop() }
        let ty = types.optional(reg, ts, e.token, types.element(target.ty))
        return typedValue(&g, reg, ty, format("sh_map_remove_${s}(&(${target.name}), ${view(query)})"))
    }
    let keyType = types.primitive(.String)
    let key = emitExpected(&g, p, ts, reg, keyId, keyType)
    require(reg, ts, p.expressions[keyId].token, key.ty, keyType)
    if key.root == target.root {
        lexer.fail(ts, p.expressions[keyId].token, "E0403", "the key still borrows the receiver")
    }
    let takenKey = takeValue(&g, reg, ts, p.expressions[keyId].token, key)
    let valueId = p.lists[e.argStart + 1]
    let valueType = types.element(target.ty)
    let value = emitExpected(&g, p, ts, reg, valueId, valueType)
    require(reg, ts, p.expressions[valueId].token, value.ty, valueType)
    while g.reservations.len() > reservations { let _ = g.reservations.pop() }
    put(&g, format("sh_map_set_${s}(&(${target.name}), ${takenKey.name}, ${value.name}, "))
    put(&g, lineColumn(ts, e.token))
    emit(&g, ");")
    zeroValue(&g, reg, takenKey)
    return Value{ty: types.primitive(.Unit), name: "".toString()}
}

// Read-only Map methods. Stage0 reads the receiver after the text query, so an
// argument that modifies or moves the Map is accepted there; this subset keeps
// it out (U0001). get returns a reference into the Map, which it does not model.
fn mapQuery(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, base: Value) -> Value {
    let name = ts[e.token].text.clone()
    let s = mapHelper(base.ty)
    useMap(&g, base.ty)
    if name == "len" || name == "clone" {
        if e.argCount != 0 { lexer.fail(ts, e.token, "E0012", "this Map method takes no arguments") }
        if name == "len" { return scalar(&g, .Int, format("(${base.name}).live")) }
        let line = support.decimal(ts[e.token].line + ts[e.token].lineBase)
        return typedValue(&g, reg, base.ty, cloneExpression(reg, base.ty, base.name, line, support.decimal(ts[e.token].column)))
    }
    if name != "has" && name != "getCopy" {
        lexer.fail(ts, e.token, "U0001", "this Map method is outside the selfhost subset")
    }
    if e.argCount != 1 { lexer.fail(ts, e.token, "E0012", format("${name} takes exactly one argument")) }
    let guards = g.accessLocks.len()
    if base.root >= 0 { g.accessLocks.push(base.root) }
    let argId = p.lists[e.argStart]
    let query = emitExpected(&g, p, ts, reg, argId, types.primitive(.Str))
    if !stringLike(query.ty) { require(reg, ts, p.expressions[argId].token, query.ty, types.primitive(.Str)) }
    while g.accessLocks.len() > guards { let _ = g.accessLocks.pop() }
    if name == "has" {
        return scalar(&g, .Bool, format("(sh_map_find_${s}(&(${base.name}), ${view(query)}) >= 0)"))
    }
    let ty = types.optional(reg, ts, e.token, types.element(base.ty))
    return typedValue(&g, reg, ty, format("sh_map_get_${s}(&(${base.name}), ${view(query)})"))
}

// Text queries (stdlib contract section 2), lowered to the runtime helpers stage0
// uses. The receiver is read after the argument, so while the argument is
// evaluated an owned receiver is locked (stage0 hold_call_argument, E0102); a str
// local's own slot is guarded too, which stage0 decides by its loans (U0001 here).
fn textQuery(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, base: Value) -> Value {
    let name = ts[e.token].text.clone()
    let wantsArgument = name != "parseInt"
    var arity = 0
    if wantsArgument { arity = 1 }
    if e.argCount != arity {
        if wantsArgument {
            lexer.fail(ts, e.token, "E0012", format("${name} takes exactly one argument"))
        }
        lexer.fail(ts, e.token, "E0012", "parseInt takes no arguments")
    }
    var argument = String{}
    if wantsArgument {
        let locks = g.locks.len()
        let guards = g.accessLocks.len()
        if base.root >= 0 { g.locks.push(base.root) }
        let receiver = p.expressions[e.left]
        if receiver.kind == .Name && base.ty.kind == .Str {
            let slot = localIndex(g, ts, receiver.token)
            if slot >= 0 { g.accessLocks.push(slot) }
        }
        let argId = p.lists[e.argStart]
        let arg = emitExpected(&g, p, ts, reg, argId, types.primitive(.Str))
        if !stringLike(arg.ty) { require(reg, ts, p.expressions[argId].token, arg.ty, types.primitive(.Str)) }
        argument = view(arg)
        releaseLocks(&g, locks)
        while g.accessLocks.len() > guards { let _ = g.accessLocks.pop() }
    }
    let text = view(base)
    if name == "startsWith" {
        return scalar(&g, .Bool, format("yv_str_starts(${text}, ${argument})"))
    }
    if name == "endsWith" {
        return scalar(&g, .Bool, format("yv_str_ends(${text}, ${argument})"))
    }
    if name == "contains" {
        return scalar(&g, .Bool, format("(yv_str_find(${text}, ${argument}) >= 0)"))
    }
    if name == "split" {
        // The pieces point where the receiver points; pieces of an owned String
        // are a statement-local view of it.
        let pieces = Type{kind: .Vec, elementKind: .Str, elementDecl: -1}
        var result = typedValue(&g, reg, pieces, format("yv_str_split(${text}, ${argument}, ${lineColumn(ts, e.token)})"))
        if base.ty.kind == .String || base.transient {
            result.transient = true
            result.root = base.root
        } else {
            result.sources = base.sources
        }
        return result
    }
    let ty = types.optional(reg, ts, e.token, types.primitive(.Int))
    let result = typedValue(&g, reg, ty, format("(${types.cType(ty)}){0}"))
    let n = g.counter
    g.counter += 1
    if name == "find" {
        emit(&g, format("int64_t n_${n} = yv_str_find(${text}, ${argument});"))
        emit(&g, format("if (n_${n} >= 0) { ${result.name}.has = true; ${result.name}.val = n_${n}; }"))
    } else {
        emit(&g, format("int64_t n_${n} = 0;"))
        emit(&g, format("if (yv_str_parse_int(${text}, &n_${n})) { ${result.name}.has = true; ${result.name}.val = n_${n}; }"))
    }
    return result
}

fn wrapOptional(g: inout Generator, reg: Registry, ty: Type, value: Value) -> Value {
    return typedValue(&g, reg, ty,
        support.join5("(", types.cType(ty), "){ .has = true, .val = ", value.name, " }"))
}

fn liftHint(reg: Registry, expected: Hint) -> Hint {
    let ty = expected.ty
    if expected.extra == 0 && (ty.kind == .Int || ty.kind == .Byte || ty.kind == .Bool ||
        (ty.kind == .Named && !types.owned(reg, ty))) {
        return Hint{ty: Type{kind: .Optional, elementKind: ty.kind, elementDecl: ty.decl}}
    }
    return Hint{ty: ty, extra: expected.extra + 1}
}

fn peelHint(expected: Hint) -> Hint {
    if expected.extra > 0 { return Hint{ty: expected.ty, extra: expected.extra - 1} }
    if expected.ty.kind == .Optional { return Hint{ty: types.element(expected.ty)} }
    return Hint{ty: types.primitive(.Unknown)}
}

fn hintName(reg: Registry, ts: Vec[Token], hint: Hint) -> String {
    var name = String{}
    var i = 0
    while i < hint.extra {
        name.push("?")
        i += 1
    }
    name.push(types.describe(reg, ts, hint.ty))
    return name
}

fn requireHint(reg: Registry, ts: Vec[Token], token: int, actual: HintedValue, expected: Hint) {
    if actual.extra != expected.extra || !types.same(actual.value.ty, expected.ty) {
        let found = Hint{ty: actual.value.ty, extra: actual.extra}
        lexer.fail(ts, token, "E0001", support.join4("expected ", hintName(reg, ts, expected), ", found ", hintName(reg, ts, found)))
    }
}

fn someConstructor(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, expected: Hint) -> Value {
    if e.argCount != 1 { lexer.fail(ts, e.token, "E0012", "some requires one argument") }
    let shaped = emitHint(&g, p, ts, reg, p.lists[e.argStart], peelHint(expected))
    if shaped.extra > 0 { lexer.fail(ts, e.token, "U0001", "nested or owned Optional payloads are outside this subset") }
    let arg = copyValue(shaped.value)
    if arg.ty.kind == .Unit { lexer.fail(ts, e.token, "E0001", "some requires a value") }
    let ty = types.optional(reg, ts, e.token, arg.ty)
    return wrapOptional(&g, reg, ty, arg)
}

fn coalesceValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, e: Expression, expected: Hint) -> Value {
    // Like stage0, a jumping fallback may only end a whole let initializer or
    // assigned value, possibly through the right side of a ?? chain.
    let allowed = g.jumpExpr == id
    g.jumpExpr = -1
    let jumping = p.expressions[e.right].kind == .Jump
    if jumping && !allowed {
        lexer.fail(ts, p.expressions[e.right].token, "U0001",
            "?? return, ?? break and ?? continue are only supported as a whole let initializer or assigned value")
    }
    var context = Hint{ty: types.primitive(.Unknown)}
    if expected.extra > 0 || (expected.ty.kind != .Unknown && expected.ty.kind != .Unit) {
        context = liftHint(reg, expected)
    }
    let shaped = emitHint(&g, p, ts, reg, e.left, context)
    if shaped.extra == 0 && shaped.value.ty.kind != .Optional {
        lexer.fail(ts, e.token, "E0001", "the left side of ?? requires an Optional value")
    }
    let inner = peelHint(Hint{ty: shaped.value.ty, extra: shaped.extra})
    if jumping && shaped.extra > 0 {
        lexer.fail(ts, e.token, "U0001", "nested or owned Optional values are outside this subset")
    }
    if shaped.extra > 0 {
        // Check the exact RHS type before rejecting a symbolic Optional. This
        // preserves E0001 for `let x: ?int = none ?? 1` without admitting ??int.
        let rhs = emitHint(&g, p, ts, reg, e.right, inner)
        requireHint(reg, ts, e.token, rhs, inner)
        lexer.fail(ts, e.token, "U0001", "nested or owned Optional values are outside this subset")
    }
    let lhs = copyValue(shaped.value)
    let output = typedValue(&g, reg, inner.ty, support.join3("(", lhs.name, ").val"))
    if jumping {
        // The fallback leaves the statement; the following code sees the state
        // from before it (stage0 restores moves and loans after a jump).
        let jump = p.expressions[e.right]
        let movedBefore = movedState(g)
        let sourcesBefore = sourceState(g)
        let jumpTemps = g.temps.len()
        emit(&g, support.join3("if (!(", lhs.name, ").has) {"))
        if ts[jump.token].text == "return" {
            let _left = returnStatement(&g, p, ts, reg, jump.token, jump.left)
        } else {
            let _left = loopExit(&g, ts, reg, jump.token, ts[jump.token].text == "break")
        }
        emit(&g, "}")
        // Temporaries of the fallback are declared and cleaned inside its block,
        // which never falls through; the statement must not drop them again.
        while g.temps.len() > jumpTemps { let _ = g.temps.pop() }
        restoreState(&g, movedBefore)
        restoreSources(&g, sourcesBefore)
        return output
    }
    let before = movedState(g)
    let temps = g.temps.len()
    emit(&g, support.join3("if (!(", lhs.name, ").has) {"))
    if allowed && p.expressions[e.right].kind == .Coalesce { g.jumpExpr = e.right }
    let rhs = emitHint(&g, p, ts, reg, e.right, inner)
    g.jumpExpr = -1
    requireHint(reg, ts, e.token, rhs, inner)
    emit(&g, support.join4(output.name, " = ", rhs.value.name, ";"))
    discardTemps(&g, reg, temps)
    let after = movedState(g)
    let joined = joinStates(before, after)
    restoreState(&g, joined)
    emit(&g, "}")
    return output
}

// Moving a payload into a Result leaves the original owner empty. The inactive
// branch stays zero, and the Result destructor visits only the active branch.
fn wrapResult(g: inout Generator, reg: Registry, ts: Vec[Token], token: int, ty: Type, value: Value, success: bool) -> Value {
    if value.transient {
        lexer.fail(ts, token, "U0001", "result payloads holding views of owned strings are outside this subset; use String")
    }
    let taken = takeValue(&g, reg, ts, token, value)
    var initial = support.join3("(", types.cType(ty), "){ .ok = ")
    if success { initial.push("true") } else { initial.push("false") }
    if !success || value.ty.kind != .Unit {
        if success { initial.push(", .val = ") } else { initial.push(", .err = ") }
        initial.push(taken.name)
    }
    initial.push(" }")
    let result = typedValue(&g, reg, ty, initial)
    zeroValue(&g, reg, taken)
    return result
}

fn resultConstructor(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, expected: Type) -> Value {
    if expected.kind != .Result {
        lexer.fail(ts, e.token, "E0001", "ok/err requires an expected result type")
    }
    if e.argCount != 1 { lexer.fail(ts, e.token, "E0012", "ok/err requires one argument") }
    let success = ts[e.token].text == "ok"
    var payload = types.resultError(reg, expected)
    if success { payload = types.resultOk(reg, expected) }
    let arg = p.lists[e.argStart]
    if success && payload.kind == .Unit && p.expressions[unparenthesized(p, arg)].kind != .Unit {
        lexer.fail(ts, p.expressions[arg].token, "E0001", "this result has no success value; write ok(())")
    }
    let value = emitExpected(&g, p, ts, reg, arg, payload)
    require(reg, ts, p.expressions[arg].token, value.ty, payload)
    return wrapResult(&g, reg, ts, e.token, expected, value, success)
}

fn resultPayload(g: inout Generator, reg: Registry, value: Value) -> Value {
    let ty = types.resultOk(reg, value.ty)
    if ty.kind == .Unit {
        zeroValue(&g, reg, value)
        return Value{ty: ty, name: String{}}
    }
    let result = typedValue(&g, reg, ty, support.join3("(", value.name, ").val"))
    zeroValue(&g, reg, value)
    return result
}

fn tryValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let value = emitExpr(&g, p, ts, reg, e.left)
    if value.ty.kind != .Result { lexer.fail(ts, e.token, "E0001", "try requires a result value") }
    if g.result.kind != .Result { lexer.fail(ts, e.token, "E0001", "try requires a result-returning function") }
    require(reg, ts, e.token, types.resultError(reg, value.ty), types.resultError(reg, g.result))
    let taken = takeValue(&g, reg, ts, p.expressions[e.left].token, value)
    emit(&g, support.join3("if (!(", taken.name, ").ok) {"))
    let n = g.counter
    g.counter += 1
    let target = support.join2("return_", support.decimal(n))
    let returnedC = types.cType(g.result)
    put(&g, support.join4(returnedC, " ", target, " = ("))
    put(&g, returnedC)
    emit(&g, support.join3("){ .ok = false, .err = (", taken.name, ").err };"))
    // Transfer the error before cleaning the original Result or any enclosing
    // partially constructed value. The return slot is deliberately not a temp.
    zeroValue(&g, reg, taken)
    cleanTemps(&g, reg, 0)
    cleanLocals(&g, reg, 0)
    emit(&g, support.join3("return ", target, ";"))
    emit(&g, "}")
    return resultPayload(&g, reg, taken)
}

fn userCatchValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let value = emitExpr(&g, p, ts, reg, e.left)
    if value.ty.kind != .Result { lexer.fail(ts, e.token, "E0001", "catch requires a result value") }
    let taken = takeValue(&g, reg, ts, p.expressions[e.left].token, value)
    let errorType = types.resultError(reg, value.ty)
    let count = g.locals.len()
    let before = movedState(g)
    emit(&g, support.join3("if (!(", taken.name, ").ok) {"))
    if ts[e.extra].text == "_" {
        dropValue(&g, reg, taken.ty, taken.name)
    } else {
        declare(&g, ts, e.extra, errorType, false, false, false)
        put(&g, types.cType(errorType))
        put(&g, support.join3(" v_", support.decimal(e.extra), " = ("))
        emit(&g, support.join2(taken.name, ").err;"))
    }
    zeroValue(&g, reg, taken)
    let sourcesBefore = sourceState(g)
    let flow = emitBlock(&g, p, ts, reg, e.argStart, e.argCount)
    if flow.falls { lexer.fail(ts, e.extra, "E0601", "this catch block can reach its closing brace") }
    cleanLocals(&g, reg, count)
    while g.locals.len() > count { let _ = g.locals.pop() }
    restoreState(&g, before)
    restoreSources(&g, sourcesBefore)
    emit(&g, "}")
    return resultPayload(&g, reg, taken)
}

// Standard-library error enums retain their dedicated catch-_ path. User
// results use the same owned-payload rules for named and discarded errors.
fn catchValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let callId = e.left
    let call = p.expressions[callId]
    var op = 0
    if call.kind == .Method {
        let module = standardModule(g, p, ts, p.expressions[call.left])
        if module == 2 && ts[call.token].text == "readText" { op = 1 }
        if module == 2 && ts[call.token].text == "writeNewText" { op = 2 }
        if module == 3 && ts[call.token].text == "fromUtf8" { op = 3 }
    }
    if op == 0 { return userCatchValue(&g, p, ts, reg, e) }
    if ts[e.extra].text != "_" {
        lexer.fail(ts, e.extra, "U0001", "standard-library error bindings are outside this subset; use catch _")
    }
    var arity = 1
    if op == 2 { arity = 2 }
    if call.argCount != arity { lexer.fail(ts, call.token, "E0012", "wrong number of function arguments") }
    let n = g.counter
    g.counter += 1
    let result = temporaryName(n)
    let status = support.join2("c_", support.decimal(n))
    let locks = g.locks.len()
    var resultType = types.primitive(.String)
    if op == 3 {
        let bytesType = Type{kind: .Vec, elementKind: .Byte, elementDecl: -1}
        let argId = p.lists[call.argStart]
        let arg = emitExpected(&g, p, ts, reg, argId, bytesType)
        require(reg, ts, p.expressions[argId].token, arg.ty, bytesType)
        let taken = takeValue(&g, reg, ts, p.expressions[argId].token, arg)
        let buffer = support.join2("b_", support.decimal(n))
        emit(&g, support.join5("yv_vec ", buffer, " = ", taken.name, ";"))
        zeroValue(&g, reg, taken)
        put(&g, support.join5("int64_t ", status, " = yv_utf8_check(", buffer, ".ptr ? (const char *)"))
        emit(&g, support.join5(buffer, ".ptr : \"\", (size_t)", buffer, ".len);", ""))
        emit(&g, support.join3("yv_string ", result, " = {0};"))
        emit(&g, support.join3("if (", status, " >= 0) {"))
        emit(&g, support.join3("yv_vec_free(&", buffer, ");"))
        let before = movedState(g)
        let sourcesBefore = sourceState(g)
        let flow = emitBlock(&g, p, ts, reg, e.argStart, e.argCount)
        restoreState(&g, before)
        restoreSources(&g, sourcesBefore)
        if flow.falls { lexer.fail(ts, e.token, "E0601", "this catch block can reach its closing brace") }
        emit(&g, "}")
        emit(&g, support.join5(result, " = (yv_string){ (char *)", buffer, ".ptr, ", support.join5(buffer, ".len, ", buffer, ".cap };", "")))
    } else {
        var args = String{}
        var i = 0
        while i < arity {
            let argId = p.lists[call.argStart + i]
            let arg = emitExpected(&g, p, ts, reg, argId, types.primitive(.Str))
            if !stringLike(arg.ty) { require(reg, ts, p.expressions[argId].token, arg.ty, types.primitive(.Str)) }
            args.push(view(arg))
            args.push(", ")
            if arg.root >= 0 { g.locks.push(arg.root) }
            i += 1
        }
        releaseLocks(&g, locks)
        emit(&g, support.join3("int64_t ", status, " = 0;"))
        if op == 1 {
            emit(&g, support.join3("yv_string ", result, " = {0};"))
            put(&g, support.join5("if (yv_fs_read_text(", args, "&", result, ", &"))
        } else {
            resultType = types.primitive(.Unit)
            put(&g, support.join2("if (yv_fs_write_new_text(", args))
            put(&g, "&")
        }
        put(&g, support.join3(status, ", ", lineColumn(ts, call.token)))
        emit(&g, ") != 0) {")
        if op == 1 {
            emit(&g, support.join3("yv_string_drop(&", result, ");"))
            emit(&g, support.join2(result, " = (yv_string){0};"))
        }
        let before = movedState(g)
        let sourcesBefore = sourceState(g)
        let flow = emitBlock(&g, p, ts, reg, e.argStart, e.argCount)
        restoreState(&g, before)
        restoreSources(&g, sourcesBefore)
        if flow.falls { lexer.fail(ts, e.token, "E0601", "this catch block can reach its closing brace") }
        emit(&g, "}")
    }
    if resultType.kind == .Unit { return Value{ty: resultType, name: "".toString()} }
    g.temps.push(Temporary{ty: resultType, id: n})
    return Value{ty: resultType, name: result, temporary: true}
}

// Match stage0's contextual integer expression set. These expressions have no
// owners or side effects, but their checked arithmetic can still panic.
fn untypedInteger(p: Program, ts: Vec[Token], id: int) -> bool {
    let e = p.expressions[id]
    if e.kind == .Number { return true }
    if e.kind == .Paren { return untypedInteger(p, ts, e.left) }
    if e.kind == .Unary && ts[e.token].text == "-" {
        return untypedInteger(p, ts, e.left)
    }
    if e.kind != .Binary { return false }
    let op = ts[e.token].text.clone()
    if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" &&
        op != "+%" && op != "-%" && op != "*%" { return false }
    return untypedInteger(p, ts, e.left) && untypedInteger(p, ts, e.right)
}

fn operandHint(reg: Registry, ty: Type, fallback: Type) -> Type {
    if integerType(ty) || (ty.kind == .Named && reg.entries[ty.decl].kind == .Enum) {
        return ty
    }
    return fallback
}

fn binaryValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, expected: Type) -> Value {
    let op = ts[e.token].text.clone()
    if op == "&&" || op == "||" {
        let lhs = emitContext(&g, p, ts, reg, e.left, types.primitive(.Bool))
        basic(reg, ts, e.token, lhs.ty, .Bool)
        let output = scalar(&g, .Bool, lhs.name)
        let before = movedState(g)
        let temps = g.temps.len()
        if op == "&&" { emit(&g, support.join3("if (", output.name, ") {")) } else {
            emit(&g, support.join3("if (!", output.name, ") {"))
        }
        let rhs = emitContext(&g, p, ts, reg, e.right, types.primitive(.Bool))
        basic(reg, ts, e.token, rhs.ty, .Bool)
        emit(&g, support.join4(output.name, " = ", rhs.name, ";"))
        discardTemps(&g, reg, temps)
        let after = movedState(g)
        let joined = joinStates(before, after)
        restoreState(&g, joined)
        emit(&g, "}")
        return output
    }
    let equality = op == "==" || op == "!="
    let comparison = equality || op == "<" || op == "<=" || op == ">" || op == ">="
    let shift = op == "<<" || op == ">>"
    var context = expected
    if comparison { context = types.primitive(.Unknown) }
    var lhs = Value{ty: types.primitive(.Unknown), name: String{}}
    var rhs = Value{ty: types.primitive(.Unknown), name: String{}}
    if !shift && untypedInteger(p, ts, e.left) && !untypedInteger(p, ts, e.right) {
        // Resolve the typed operand once, then place its C after the literal's
        // C. Type inference is bidirectional; run-time evaluation stays left
        // to right, including a literal-expression panic before RHS effects.
        let before = take(&g.out)
        rhs = emitContext(&g, p, ts, reg, e.right, context)
        let rightCode = take(&g.out)
        g.out = before
        let hint = operandHint(reg, rhs.ty, context)
        lhs = emitContext(&g, p, ts, reg, e.left, hint)
        g.out.push(rightCode)
    } else {
        lhs = emitContext(&g, p, ts, reg, e.left, context)
        let locks = g.binaryLocks.len()
        if lhs.root >= 0 { g.binaryLocks.push(lhs.root) }
        var hint = operandHint(reg, lhs.ty, context)
        if shift { hint = types.primitive(.Unknown) }
        rhs = emitContext(&g, p, ts, reg, e.right, hint)
        while g.binaryLocks.len() > locks { let _ = g.binaryLocks.pop() }
    }
    if shift {
        requireInteger(ts, e.token, lhs.ty)
        requireInteger(ts, e.token, rhs.ty)
        let code = integerOperation(ts, e.token, lhs.ty.kind, op, lhs.name, rhs.name)
        return scalar(&g, lhs.ty.kind, code)
    }
    if comparison && stringLike(lhs.ty) && stringLike(rhs.ty) {
        return scalar(&g, .Bool, support.join5("(yv_str_cmp(", view(lhs), ", ", view(rhs), support.join3(") ", op, " 0)")))
    }
    require(reg, ts, e.token, rhs.ty, lhs.ty)
    if comparison {
        if lhs.ty.kind == .Optional {
            lexer.fail(ts, e.token, "U0001", "Optional comparison is outside this subset")
        }
        if lhs.ty.kind == .Unit || (lhs.ty.kind == .Bool && !equality) {
            lexer.fail(ts, e.token, "E0001", "operator is not defined for this type")
        }
        if lhs.ty.kind == .Vec || lhs.ty.kind == .Args || lhs.ty.kind == .Slice || lhs.ty.kind == .Result ||
            lhs.ty.kind == .Map ||
            (lhs.ty.kind == .Named && (reg.entries[lhs.ty.decl].kind == .Struct || !equality)) {
            lexer.fail(ts, e.token, "E0501", "this aggregate does not implement the required comparison")
        }
        return scalar(&g, .Bool, support.join5("(", lhs.name, support.join3(" ", op, " "), rhs.name, ")"))
    }
    requireInteger(ts, e.token, lhs.ty)
    let code = integerOperation(ts, e.token, lhs.ty.kind, op, lhs.name, rhs.name)
    return scalar(&g, lhs.ty.kind, code)
}

fn emitExpr(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int) -> Value {
    return emitExpected(&g, p, ts, reg, id, types.primitive(.Unknown))
}

// Context guides literals and constructors. Wrapping is applied only at the
// assignment/argument/return boundary, not inside some, parentheses or ?? RHS.
fn emitHint(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, expected: Hint) -> HintedValue {
    if g.nesting >= 256 {
        lexer.fail(ts, p.expressions[id].token, "U0001", "selfhost lowering nesting limit (256) exceeded")
    }
    g.nesting += 1
    let result = hintedExpression(&g, p, ts, reg, id, expected)
    g.nesting -= 1
    return result
}

fn hintedExpression(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, expected: Hint) -> HintedValue {
    let e = p.expressions[id]
    if e.kind == .Paren { return emitHint(&g, p, ts, reg, e.left, expected) }
    if e.kind == .None {
        if expected.extra > 0 {
            return HintedValue{value: Value{ty: expected.ty, name: String{}}, extra: expected.extra}
        }
        if expected.ty.kind != .Optional { lexer.fail(ts, e.token, "E0001", "none requires an Optional context") }
        let value = typedValue(&g, reg, expected.ty, support.join3("(", types.cType(expected.ty), "){0}"))
        return HintedValue{value: value}
    }
    if e.kind == .Call && ts[e.token].text == "some" &&
        functionIndex(g, p, ts, e.token) < 0 && localIndex(g, ts, e.token) < 0 {
        return HintedValue{value: someConstructor(&g, p, ts, reg, e, expected)}
    }
    if e.kind == .Coalesce {
        return HintedValue{value: coalesceValue(&g, p, ts, reg, id, e, expected)}
    }
    var context = expected.ty
    if expected.extra > 0 { context = types.primitive(.Unknown) }
    return HintedValue{value: expressionValue(&g, p, ts, reg, id, context)}
}

fn emitContext(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, expected: Type) -> Value {
    let result = emitHint(&g, p, ts, reg, id, Hint{ty: expected})
    if result.extra > 0 { lexer.fail(ts, p.expressions[id].token, "U0001", "this Optional value is outside the selfhost subset") }
    return copyValue(result.value)
}

fn emitExpected(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, expected: Type) -> Value {
    let result = emitContext(&g, p, ts, reg, id, expected)
    if expected.kind == .Optional && types.same(result.ty, types.element(expected)) {
        return wrapOptional(&g, reg, expected, result)
    }
    if expected.kind == .Result && !types.same(result.ty, expected) {
        let ok = types.resultOk(reg, expected)
        if ok.kind != .Unit && types.same(result.ty, ok) {
            return wrapResult(&g, reg, ts, p.expressions[id].token, expected, result, true)
        }
    }
    return result
}

fn minimumMagnitude(text: str) -> bool {
    var start = 0
    while start + 1 < text.len() && text[start] == '0' { start += 1 }
    return text[start..text.len()] == "9223372036854775808"
}

fn unparenthesized(p: Program, id: int) -> int {
    var current = id
    while p.expressions[current].kind == .Paren { current = p.expressions[current].left }
    return current
}

fn enumValue(g: inout Generator, reg: Registry, ts: Vec[Token], token: int, expected: Type) -> Value {
    if expected.kind != .Named || reg.entries[expected.decl].kind != .Enum {
        lexer.fail(ts, token, "E0001", "an enum case requires an expected enum type")
    }
    let which = types.variantIndex(reg, ts, expected.decl, token)
    if which < 0 { lexer.fail(ts, token, "E0010", "unknown enum case") }
    return typedValue(&g, reg, expected, support.decimal(which))
}

fn constructValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    if ts[e.token].text == "String" {
        if e.nameCount > 0 { lexer.fail(ts, p.lists[e.nameStart], "E0010", "String has no constructor fields") }
        return typedValue(&g, reg, types.primitive(.String), "(yv_string){0}")
    }
    var index = -1
    if e.extra >= 0 {
        index = types.qualifiedType(reg, ts, e.extra, e.token)
        if index < 0 {
            lexer.fail(ts, e.extra, "E0010", support.join3("module '", ts[e.extra].text, "' is not in scope"))
        }
    } else {
        index = types.lookup(reg, ts, e.token)
    }
    if index < 0 {
        if ts[e.token].text == "Vec" {
            lexer.fail(ts, e.token, "E0001", "Vec takes exactly one type argument")
        }
        if ts[e.token].text == "Map" || ts[e.token].text == "Set" {
            lexer.fail(ts, e.token, "U0001", "collection construction is outside the selfhost subset")
        }
        lexer.fail(ts, e.token, "E0010", "unknown struct type")
    }
    let info = reg.entries[index]
    if info.kind != .Struct { lexer.fail(ts, e.token, "E0001", "struct construction requires a struct type") }
    // Field values are evaluated in source order; slots records each value's field.
    var slots: Vec[int] = []
    var taken: Vec[Value] = []
    var i = 0
    while i < e.nameCount {
        let nameToken = p.lists[e.nameStart + i]
        let argId = p.lists[e.argStart + i]
        let f = types.fieldIndex(reg, ts, index, nameToken)
        if f < 0 { lexer.fail(ts, nameToken, "E0010", "unknown struct field") }
        if contains(slots, f) { lexer.fail(ts, nameToken, "E0011", "duplicate constructor field") }
        let fieldType = types.fieldOf(reg, index, f).ty
        let result = emitExpected(&g, p, ts, reg, argId, fieldType)
        require(reg, ts, p.expressions[argId].token, result.ty, fieldType)
        taken.push(takeValue(&g, reg, ts, p.expressions[argId].token, result))
        slots.push(f)
        i += 1
    }
    i = 0
    while i < info.fieldCount {
        if !contains(slots, i) {
            let f = types.fieldOf(reg, index, i)
            if f.initial < 0 { lexer.fail(ts, e.token, "E0018", "missing struct field without a default") }
            let initialToken = p.expressions[f.initial].token
            var initial = emitExpected(&g, p, ts, reg, f.initial, f.ty)
            if f.ty.kind == .String && initial.ty.kind == .Str {
                initial = typedValue(&g, reg, f.ty, support.join5("yv_string_from(", initial.name, ", ", lineColumn(ts, initialToken), ")"))
            }
            require(reg, ts, initialToken, initial.ty, f.ty)
            taken.push(takeValue(&g, reg, ts, initialToken, initial))
            slots.push(i)
        }
        i += 1
    }
    var fields = String{}
    i = 0
    while i < info.fieldCount {
        var k = 0
        while slots[k] != i { k += 1 }
        if i > 0 { fields.push(", ") }
        fields.push(support.join3(".f_", support.decimal(i), " = "))
        fields.push(taken[k].name)
        i += 1
    }
    if info.fieldCount == 0 { fields.push(".sh_empty = 0") }
    let ty = Type{kind: .Named, decl: index, elementKind: .Unknown}
    let result = typedValue(&g, reg, ty, support.join5("(", types.cType(ty), "){", fields, "}"))
    i = 0
    while i < taken.len() {
        zeroValue(&g, reg, taken[i])
        i += 1
    }
    return result
}

fn fieldValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let baseExpr = p.expressions[e.left]
    if moduleOf(g, reg, ts, baseExpr) >= 0 {
        // module.Name as a value: only types are exported in this subset.
        let _ = types.qualifiedType(reg, ts, baseExpr.token, e.token)
        lexer.fail(ts, e.token, "E0001", "a type name is not a value")
    }
    if baseExpr.kind == .Field && moduleOf(g, reg, ts, p.expressions[baseExpr.left]) >= 0 {
        // module.Enum.Case
        let declared = types.qualifiedType(reg, ts, p.expressions[baseExpr.left].token, baseExpr.token)
        if reg.entries[declared].kind == .Enum {
            return enumValue(&g, reg, ts, e.token, Type{kind: .Named, decl: declared, elementKind: .Unknown})
        }
        lexer.fail(ts, e.token, "U0001", "member access on this type is outside the selfhost subset")
    }
    if baseExpr.kind == .Name && localIndex(g, ts, baseExpr.token) < 0 {
        let declared = types.lookup(reg, ts, baseExpr.token)
        if declared >= 0 && reg.entries[declared].kind == .Enum {
            return enumValue(&g, reg, ts, e.token, Type{kind: .Named, decl: declared, elementKind: .Unknown})
        }
    }
    let base = emitExpr(&g, p, ts, reg, e.left)
    if base.ty.kind != .Named || reg.entries[base.ty.decl].kind != .Struct {
        lexer.fail(ts, e.token, "U0001", "member access on this type is outside the selfhost subset")
    }
    let index = types.fieldIndex(reg, ts, base.ty.decl, e.token)
    if index < 0 { lexer.fail(ts, e.token, "E0010", "unknown struct field") }
    let ty = types.fieldOf(reg, base.ty.decl, index).ty
    let name = support.join4("(", base.name, ").f_", support.decimal(index))
    if types.owned(reg, ty) {
        return Value{ty: ty, name: name, root: base.root, field: true, indexedBorrow: base.indexedBorrow}
    }
    return typedValue(&g, reg, ty, name)
}

fn vectorValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression, expected: Type) -> Value {
    var elem = types.primitive(.Unknown)
    if expected.kind == .Vec { elem = types.element(expected) }
    if e.elementKind != .Unknown {
        let annotation = TypeRef{kind: .Vec, name: e.token,
            elementKind: e.elementKind, elementName: e.elementName}
        let explicit = types.resolve(reg, ts, annotation)
        elem = types.element(explicit)
    }
    if elem.kind == .Unknown && e.argCount == 0 {
        lexer.fail(ts, e.token, "E0001", "cannot infer the element type of an empty vector")
    }
    let n = g.counter
    g.counter += 1
    let name = temporaryName(n)
    // Register the outer owner before lowering its elements. Prefixing the resulting
    // C with the allocation also preserves allocation-before-element evaluation when
    // the element type is inferred from the first expression.
    var ty = types.primitive(.Unknown)
    if elem.kind != .Unknown { ty = types.vector(ts, e.token, elem) }
    let temporary = g.temps.len()
    var registered = types.primitive(.Vec)
    if ty.kind != .Unknown { registered = ty }
    g.temps.push(Temporary{ty: registered, id: n})
    var sources = 0
    let before = take(&g.out)
    var i = 0
    while i < e.argCount {
        let arg = p.lists[e.argStart + i]
        let argToken = p.expressions[arg].token
        let item = emitExpected(&g, p, ts, reg, arg, elem)
        if elem.kind == .Unknown {
            if item.indexedBorrow && !item.field {
                lexer.fail(ts, argToken, "U0001", "vectors of borrowed elements are outside this subset")
            }
            if item.ty.kind == .Unit {
                lexer.fail(ts, argToken, "E0001", "a unit-valued call cannot be a vector element")
            }
            elem = item.ty
            ty = types.vector(ts, argToken, elem)
            // A later element may try-return. Once the first element's type
            // is known, every following error edge needs its real destructor.
            g.temps[temporary].ty = ty
        }
        require(reg, ts, argToken, item.ty, elem)
        if item.transient {
            lexer.fail(ts, argToken, "U0001", "persistent views of owned strings are outside this subset")
        }
        sources = sources | item.sources
        let taken = takeValue(&g, reg, ts, argToken, item)
        let et = types.cType(elem)
        put(&g, support.join5("*(", et, " *)yv_vec_push_slot(&", name, ", (int64_t)sizeof("))
        put(&g, et)
        put(&g, "), ")
        put(&g, lineColumn(ts, e.token))
        emit(&g, support.join3(") = ", taken.name, ";"))
        zeroValue(&g, reg, taken)
        i += 1
    }
    // Inferred literals now know their element destructor. Keeping the placeholder
    // type would free only the buffer and leak every owned element.
    g.temps[temporary].ty = ty
    let body = take(&g.out)
    g.out = before
    put(&g, support.join5("yv_vec ", name, " = yv_vec_with_cap((int64_t)sizeof(", types.cType(elem), "), "))
    put(&g, support.decimal(e.argCount))
    put(&g, ", ")
    put(&g, lineColumn(ts, e.token))
    emit(&g, ");")
    g.out.push(body)
    return Value{ty: ty, name: name, temporary: true, sources: sources}
}

fn indexValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let receiver = p.expressions[e.left]
    if receiver.kind == .Name && localIndex(g, ts, receiver.token) < 0 {
        let name = ts[receiver.token].text.clone()
        if name == "Vec" || name == "String" || name == "str" || name == "int" || name == "byte" ||
            name == "bool" || types.lookup(reg, ts, receiver.token) >= 0 {
            lexer.fail(ts, e.token, "U0001", "type arguments without construction are outside this subset")
        }
    }
    let base = emitExpr(&g, p, ts, reg, e.left)
    if base.ty.kind != .Vec && base.ty.kind != .Args && base.ty.kind != .Slice && !stringLike(base.ty) {
        lexer.fail(ts, e.token, "E0001", "this value cannot be indexed")
    }
    let mark = g.accessLocks.len()
    if base.root >= 0 { g.accessLocks.push(base.root) }
    let index = emitExpected(&g, p, ts, reg, e.right, types.primitive(.Int))
    requireInteger(ts, e.token, index.ty)
    while g.accessLocks.len() > mark { let _ = g.accessLocks.pop() }
    let at = support.join5(", ", index.name, ", ", lineColumn(ts, e.token), ")")
    if stringLike(base.ty) {
        // A text read is a checked UTF-8 byte read, immediately copied away
        // from its receiver. Temporary strings live through this statement.
        return scalar(&g, .Byte, support.join5("yv_str_at(", view(base), ", (int64_t)", index.name,
            support.join3(", ", lineColumn(ts, e.token), ")")))
    }
    if base.ty.kind == .Args {
        // Command-line arguments are static str values.
        return scalar(&g, .Str, support.join4("*(yv_str *)yv_vec_at(&(", base.name, "), (int64_t)sizeof(yv_str)", at))
    }
    let elem = types.element(base.ty)
    let et = types.cType(elem)
    if types.owned(reg, elem) {
        // Materialize the checked address once. This is a borrowed slot, never a
        // new owner; a temporary receiver stays alive in g.temps for the statement.
        let n = g.counter
        g.counter += 1
        put(&g, support.join5("const ", et, " *borrow_", support.decimal(n), " = (const "))
        put(&g, support.join5(et, " *)yv_vec_at(&(", base.name, "), (int64_t)sizeof(", et))
        emit(&g, support.join3(")", at, ";"))
        return Value{ty: elem, name: support.join3("(*borrow_", support.decimal(n), ")"), root: base.root, indexedBorrow: true}
    }
    // Copy reads immediately detach from the source container.
    // A str element keeps the sources of the text it points into.
    var element = typedValue(&g, reg, elem,
        support.join5("*(", et, " *)yv_vec_at(&(", base.name, support.join4("), (int64_t)sizeof(", et, ")", at)))
    element.sources = base.sources
    return element
}

// An expression-local text slice. A view of an owned String keeps its root
// borrowed and may not be stored in a binding.
fn sliceValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, e: Expression) -> Value {
    let base = emitExpr(&g, p, ts, reg, e.left)
    if base.ty.kind == .Vec || base.ty.kind == .Slice || base.ty.kind == .Args {
        lexer.fail(ts, e.token, "U0001", "vector slices are outside the selfhost subset")
    }
    if !stringLike(base.ty) { lexer.fail(ts, e.token, "E0001", "this value cannot be sliced") }
    let mark = g.accessLocks.len()
    if base.root >= 0 { g.accessLocks.push(base.root) }
    let start = emitExpected(&g, p, ts, reg, e.right, types.primitive(.Int))
    basic(reg, ts, e.token, start.ty, .Int)
    let end = emitExpected(&g, p, ts, reg, e.extra, types.primitive(.Int))
    basic(reg, ts, e.token, end.ty, .Int)
    while g.accessLocks.len() > mark { let _ = g.accessLocks.pop() }
    var code = support.join5("yv_str_slice(", view(base), ", ", start.name, ", ")
    code.push(end.name)
    code.push(", ")
    code.push(lineColumn(ts, e.token))
    code.push(")")
    var result = scalar(&g, .Str, code)
    if base.ty.kind == .String || base.transient {
        result.transient = true
        result.root = base.root
    } else {
        result.sources = base.sources
    }
    return result
}

fn expressionValue(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, expected: Type) -> Value {
    let e = p.expressions[id]
    if e.kind == .Jump {
        lexer.fail(ts, e.token, "U0001", "?? return, ?? break and ?? continue are only supported as a whole let initializer or assigned value")
    }
    if e.kind == .Interpolated {
        lexer.fail(ts, e.token, "E0001", "interpolation must be a direct output or format argument")
    }
    if e.kind == .Unit { return Value{ty: types.primitive(.Unit), name: "".toString()} }
    if e.kind == .EmptyMap {
        if expected.kind != .Map { lexer.fail(ts, e.token, "E0001", "cannot infer the type of [:]; annotate it as a Map") }
        return typedValue(&g, reg, expected, "(yv_map){0}")
    }
    if e.kind == .Number {
        let number = support.parseDecimal(ts[e.token].text)
        if number < 0 { lexer.fail(ts, e.token, "E0003", "integer literal is outside int range") }
        if expected.kind == .Byte {
            if number > 255 {
                lexer.fail(ts, e.token, "E0003", "integer literal is outside byte range")
            }
            return scalar(&g, .Byte, support.join3("UINT8_C(", support.decimal(number), ")"))
        }
        return scalar(&g, .Int, support.join3("INT64_C(", support.decimal(number), ")"))
    }
    if e.kind == .Byte { return scalar(&g, .Byte, support.join3("UINT8_C(", ts[e.token].text, ")")) }
    if e.kind == .Boolean { return scalar(&g, .Bool, ts[e.token].text) }
    if e.kind == .Text {
        return scalar(&g, .Str, support.join5("(yv_str){", cString(ts[e.token].text), ", ", support.decimal(ts[e.token].text.len()), "}"))
    }
    if e.kind == .Name {
        let index = localIndex(g, ts, e.token)
        if index < 0 {
            if types.lookup(reg, ts, e.token) >= 0 {
                lexer.fail(ts, e.token, "E0001", "a type name is not a value")
            }
            if numericTypeName(ts[e.token].text) {
                lexer.fail(ts, e.token, "U0001", "numeric type constants are outside the selfhost subset")
            }
            lexer.fail(ts, e.token, "E0010", support.join3("unknown local '", ts[e.token].text, "'"))
        }
        readable(g, ts, index, e.token)
        let local = g.locals[index]
        let name = localName(local)
        if types.owned(reg, local.ty) {
            return Value{ty: local.ty, name: name, local: index, root: index, sources: local.sources}
        }
        var value = typedValue(&g, reg, local.ty, name)
        value.sources = local.sources
        return value
    }
    if e.kind == .Unary {
        let child = p.expressions[unparenthesized(p, e.left)]
        let minus = ts[e.token].text == "-"
        if minus && child.kind == .Number && expected.kind == .Byte {
            let number = support.parseDecimal(ts[child.token].text)
            if number != 0 {
                lexer.fail(ts, e.token, "E0003", "negative literal is outside byte range")
            }
            return scalar(&g, .Byte, "UINT8_C(0)")
        }
        if minus && child.kind == .Number && minimumMagnitude(ts[child.token].text) {
            return scalar(&g, .Int, "INT64_MIN")
        }
        var context = expected
        if !minus { context = types.primitive(.Bool) }
        let arg = emitContext(&g, p, ts, reg, e.left, context)
        if !minus {
            basic(reg, ts, e.token, arg.ty, .Bool)
            return scalar(&g, .Bool, support.join3("(!", arg.name, ")"))
        }
        basic(reg, ts, e.token, arg.ty, .Int)
        return scalar(&g, .Int, support.join5("yv_neg_i64(", arg.name, ", ", lineColumn(ts, e.token), ")"))
    }
    if e.kind == .Binary { return binaryValue(&g, p, ts, reg, e, expected) }
    if e.kind == .Variant {
        var hint = expected
        if hint.kind == .Result { hint = types.resultOk(reg, hint) } else if hint.kind == .Optional {
            hint = types.element(hint)
        }
        return enumValue(&g, reg, ts, e.token, hint)
    }
    if e.kind == .Construct { return constructValue(&g, p, ts, reg, e) }
    if e.kind == .Vector { return vectorValue(&g, p, ts, reg, e, expected) }
    if e.kind == .Index { return indexValue(&g, p, ts, reg, e) }
    if e.kind == .Slice { return sliceValue(&g, p, ts, reg, e) }
    if e.kind == .Field { return fieldValue(&g, p, ts, reg, e) }
    if e.kind == .Method { return methodValue(&g, p, ts, reg, e) }
    if e.kind == .Catch { return catchValue(&g, p, ts, reg, e) }
    if e.kind == .Try { return tryValue(&g, p, ts, reg, e) }
    if e.kind == .Ref {
        lexer.fail(ts, e.token, "U0001", "borrow expressions outside inout and take arguments are outside this subset")
    }
    if (ts[e.token].text == "ok" || ts[e.token].text == "err") &&
        functionIndex(g, p, ts, e.token) < 0 && localIndex(g, ts, e.token) < 0 {
        return resultConstructor(&g, p, ts, reg, e, expected)
    }
    return callValue(&g, p, ts, reg, e, id)
}

fn placeRoot(p: Program, id: int) -> int {
    var current = id
    loop {
        let e = p.expressions[current]
        if e.kind == .Name { return e.token }
        if e.kind != .Paren && e.kind != .Field && e.kind != .Index { return -1 }
        current = e.left
    }
}

fn fieldPlace(reg: Registry, ts: Vec[Token], e: Expression, base: Place) -> Place {
    if base.ty.kind != .Named || reg.entries[base.ty.decl].kind != .Struct {
        lexer.fail(ts, e.token, "E0001", "field assignment requires a struct")
    }
    let index = types.fieldIndex(reg, ts, base.ty.decl, e.token)
    if index < 0 { lexer.fail(ts, e.token, "E0010", "unknown struct field") }
    let ty = types.fieldOf(reg, base.ty.decl, index).ty
    return Place{ty: ty, name: support.join4("(", base.name, ").f_", support.decimal(index)),
        mutable: base.mutable, root: base.root, whole: false, indexed: base.indexed}
}

// Determine assignment context without evaluating the receiver or index. Indexed
// assignment evaluates the RHS before locating its slot, including compound writes.
fn placeType(g: Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, depth: int) -> Place {
    let e = p.expressions[id]
    if depth >= 256 { lexer.fail(ts, e.token, "U0001", "selfhost place nesting limit (256) exceeded") }
    if e.kind == .Paren { return placeType(g, p, ts, reg, e.left, depth + 1) }
    if e.kind == .Name {
        let index = localIndex(g, ts, e.token)
        if index < 0 { lexer.fail(ts, e.token, "E0010", "assignment to an unknown local") }
        let local = g.locals[index]
        return Place{ty: local.ty, name: localName(local), mutable: local.mutable, root: index}
    }
    if e.kind == .Field {
        let base = placeType(g, p, ts, reg, e.left, depth + 1)
        return fieldPlace(reg, ts, e, base)
    }
    if e.kind == .Index {
        if placeRoot(p, e.left) < 0 {
            lexer.fail(ts, e.token, "E0014", "cannot assign through a temporary container")
        }
        let base = placeType(g, p, ts, reg, e.left, depth + 1)
        if stringLike(base.ty) { lexer.fail(ts, e.token, "E0101", "text elements are read-only") }
        if base.ty.kind == .Slice {
            if !base.mutable { lexer.fail(ts, e.token, "E0014", "cannot modify a read-only value") }
            lexer.fail(ts, e.token, "E0101", "a slice is read-only; its elements cannot be modified")
        }
        if base.ty.kind != .Vec { lexer.fail(ts, e.token, "E0001", "indexed assignment requires a vector") }
        if types.owned(reg, types.element(base.ty)) {
            lexer.fail(ts, e.token, "U0001", "indexed places for owned vector elements are outside this subset")
        }
        return Place{ty: types.element(base.ty), name: String{},
            mutable: base.mutable, root: base.root, whole: false, indexed: true}
    }
    lexer.fail(ts, e.token, "U0001", "assignment to this form is outside the supported place syntax")
    return Place{ty: types.primitive(.Unknown), name: String{}, mutable: false, root: -1}
}

fn placeOf(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int, depth: int) -> Place {
    let e = p.expressions[id]
    if depth >= 256 { lexer.fail(ts, e.token, "U0001", "selfhost place nesting limit (256) exceeded") }
    if e.kind == .Paren { return placeOf(&g, p, ts, reg, e.left, depth + 1) }
    if e.kind == .Field {
        let base = placeOf(&g, p, ts, reg, e.left, depth + 1)
        readable(g, ts, base.root, e.token)
        return fieldPlace(reg, ts, e, base)
    }
    if e.kind == .Index {
        let shape = placeType(g, p, ts, reg, id, depth)
        if !shape.mutable { lexer.fail(ts, e.token, "E0014", "cannot modify a read-only container") }
        let base = placeOf(&g, p, ts, reg, e.left, depth + 1)
        readable(g, ts, base.root, e.token)
        writable(g, ts, base.root, e.token)
        let reservations = g.reservations.len()
        g.reservations.push(base.root)
        let index = emitExpected(&g, p, ts, reg, e.right, types.primitive(.Int))
        requireInteger(ts, e.token, index.ty)
        while g.reservations.len() > reservations { let _ = g.reservations.pop() }
        let n = g.counter
        g.counter += 1
        let et = types.cType(shape.ty)
        put(&g, support.join5(et, " *slot_", support.decimal(n), " = (", et))
        put(&g, support.join3(" *)yv_vec_at(&(", base.name, "), (int64_t)sizeof("))
        put(&g, support.join4(et, "), ", index.name, ", "))
        put(&g, lineColumn(ts, e.token))
        emit(&g, ");")
        return Place{ty: shape.ty, name: support.join3("(*slot_", support.decimal(n), ")"),
            mutable: base.mutable, root: base.root, whole: false, indexed: true}
    }
    return placeType(g, p, ts, reg, id, depth)
}

fn pushLoop(g: inout Generator, localCount: int, tempCount: int) {
    let base = g.exits.len()
    var i = 0
    while i < localCount * 2 {
        g.exits.push(false)
        g.sourceExits.push(0)
        i += 1
    }
    g.loopStates.push(LoopState{localCount: localCount, tempCount: tempCount, exitBase: base})
}

fn popLoop(g: inout Generator) -> LoopExit {
    assert(g.loopStates.len() > 0)
    let index = g.loopStates.len() - 1
    let frame = g.loopStates[index]
    var breaks: Vec[bool] = []
    var continues: Vec[bool] = []
    var breakSources: Vec[int] = []
    var continueSources: Vec[int] = []
    var i = 0
    while frame.hasBreak && i < frame.localCount {
        breaks.push(g.exits[frame.exitBase + i])
        breakSources.push(g.sourceExits[frame.exitBase + i])
        i += 1
    }
    i = 0
    while frame.hasContinue && i < frame.localCount {
        continues.push(g.exits[frame.exitBase + frame.localCount + i])
        continueSources.push(g.sourceExits[frame.exitBase + frame.localCount + i])
        i += 1
    }
    while g.exits.len() > frame.exitBase { let _ = g.exits.pop() }
    while g.sourceExits.len() > frame.exitBase { let _ = g.sourceExits.pop() }
    while g.loopStates.len() > index { let _ = g.loopStates.pop() }
    return LoopExit{breaks: breaks, continues: continues, hasBreak: frame.hasBreak,
        breakSources: breakSources, continueSources: continueSources}
}

fn emitBlock(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, start: int, count: int) -> Flow {
    let localCount = g.locals.len()
    var flow = Flow{}
    emit(&g, "{")
    var i = 0
    while i < count {
        let tempCount = g.temps.len()
        let next = emitStatement(&g, p, ts, reg, p.lists[start + i])
        discardTemps(&g, reg, tempCount)
        // Stage0 counts syntactic breaks, including after a terminating statement.
        flow.breaks = flow.breaks || next.breaks
        if flow.falls { flow.falls = next.falls }
        i += 1
    }
    cleanLocals(&g, reg, localCount)
    while g.locals.len() > localCount { let _ = g.locals.pop() }
    emit(&g, "}")
    return flow
}

fn recordExit(g: inout Generator, breaking: bool) {
    let index = g.loopStates.len() - 1
    let frame = g.loopStates[index]
    var offset = frame.exitBase
    var had = frame.hasBreak
    if !breaking {
        offset = frame.exitBase + frame.localCount
        had = frame.hasContinue
    }
    var i = 0
    while i < frame.localCount {
        var moved = g.locals[i].moved
        if had { moved = moved || g.exits[offset + i] }
        g.exits[offset + i] = moved
        var sources = g.locals[i].sources
        if had { sources = sources | g.sourceExits[offset + i] }
        g.sourceExits[offset + i] = sources
        i += 1
    }
    if breaking { g.loopStates[index].hasBreak = true } else {
        g.loopStates[index].hasContinue = true
    }
}

// Recheck only the body, as stage0 does, with the moved and source state of a
// repeated iteration. Generated C and transient analysis state belong to this probe.
fn replayBody(parent: Generator, p: Program, ts: Vec[Token], reg: Registry, s: Statement,
    next: Vec[bool], nextSources: Vec[int]) -> Replay {
    var probe = Generator{
        counter: parent.counter,
        locals: parent.locals.clone(),
        temps: parent.temps.clone(),
        locks: parent.locks.clone(),
        binaryLocks: parent.binaryLocks.clone(),
        accessLocks: parent.accessLocks.clone(),
        iterationLocks: parent.iterationLocks.clone(),
        reservations: parent.reservations.clone(),
        inoutLocks: parent.inoutLocks.clone(),
        loopStates: parent.loopStates.clone(),
        exits: parent.exits.clone(),
        sourceExits: parent.sourceExits.clone(),
        result: parent.result,
        allowed: parent.allowed,
        loops: parent.loops + 1,
        file: parent.file
    }
    restoreState(&probe, next)
    restoreSources(&probe, nextSources)
    let count = probe.locals.len()
    let tempCount = probe.temps.len()
    pushLoop(&probe, count, tempCount)
    let _flow = emitBlock(&probe, p, ts, reg, s.bodyStart, s.bodyCount)
    let frame = popLoop(&probe)
    let following = iterationSources(nextSources, sourceState(probe), frame.continueSources)
    return Replay{breaks: frame.breaks.clone(), breakSources: frame.breakSources.clone(),
        nextSources: following}
}

fn emitLoopBody(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, s: Statement) -> Flow {
    let before = movedState(g)
    let sourcesBefore = sourceState(g)
    let count = g.locals.len()
    let tempCount = g.temps.len()
    pushLoop(&g, count, tempCount)
    g.loops += 1
    let _inner = emitBlock(&g, p, ts, reg, s.bodyStart, s.bodyCount)
    g.loops -= 1
    let frame = popLoop(&g)
    let ended = movedState(g)
    let end = joinStates(ended, frame.continues)
    let next = joinStates(before, end)
    var nextSources = iterationSources(sourcesBefore, sourceState(g), frame.continueSources)
    var exits = frame.breaks.clone()
    var exitSources = frame.breakSources.clone()
    var grew = false
    var i = 0
    while i < before.len() {
        if next[i] && !before[i] { grew = true }
        i += 1
    }
    // Sources written late in the body reach earlier statements of the next
    // iteration: replay until the entry state stops growing.
    if grew || sourcesGrew(sourcesBefore, nextSources) {
        loop {
            let repeated = replayBody(g, p, ts, reg, s, next, nextSources)
            if exits.len() == 0 { exits = repeated.breaks.clone() } else {
                exits = joinStates(exits, repeated.breaks)
            }
            exitSources = joinSources(exitSources, repeated.breakSources)
            if !sourcesGrew(nextSources, repeated.nextSources) { break }
            nextSources = joinSources(nextSources, repeated.nextSources)
        }
    }
    if s.kind == .Loop && frame.hasBreak {
        restoreState(&g, exits)
    } else {
        let after = joinStates(next, exits)
        restoreState(&g, after)
    }
    restoreSources(&g, joinSources(nextSources, exitSources))
    emit(&g, "}")
    // recordExit also sees break inside expression handlers. A syntactically
    // nested catch must not make an escapable loop look non-terminating.
    return Flow{falls: s.kind != .Loop || frame.hasBreak}
}

fn loopStatement(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, s: Statement) -> Flow {
    emit(&g, "for (;;) {")
    if s.kind == .While {
        let tempCount = g.temps.len()
        g.loopCondition = true
        let condition = emitExpected(&g, p, ts, reg, s.expr, types.primitive(.Bool))
        g.loopCondition = false
        basic(reg, ts, s.token, condition.ty, .Bool)
        discardTemps(&g, reg, tempCount)
        emit(&g, support.join3("if (!", condition.name, ") break;"))
    }
    return emitLoopBody(&g, p, ts, reg, s)
}

fn forLoopStatement(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, s: Statement) -> Flow {
    let localCount = g.locals.len()
    let lockCount = g.iterationLocks.len()
    let tempCount = g.temps.len()
    emit(&g, "{")
    if s.kind == .ForRange {
        var start = Value{ty: types.primitive(.Unknown), name: String{}}
        var end = Value{ty: types.primitive(.Unknown), name: String{}}
        if untypedInteger(p, ts, s.expr) && !untypedInteger(p, ts, s.target) {
            // Infer a literal start from the end's type, without changing the
            // observable left-to-right evaluation of the two bounds.
            let before = take(&g.out)
            end = emitContext(&g, p, ts, reg, s.target, types.primitive(.Unknown))
            let endCode = take(&g.out)
            g.out = before
            let hint = operandHint(reg, end.ty, types.primitive(.Unknown))
            start = emitContext(&g, p, ts, reg, s.expr, hint)
            g.out.push(endCode)
        } else {
            start = emitContext(&g, p, ts, reg, s.expr, types.primitive(.Unknown))
            let hint = operandHint(reg, start.ty, types.primitive(.Unknown))
            end = emitContext(&g, p, ts, reg, s.target, hint)
        }
        requireInteger(ts, s.token, start.ty)
        require(reg, ts, s.token, end.ty, start.ty)
        declare(&g, ts, s.name, start.ty, false, false, false)
        let name = support.join2("v_", support.decimal(s.name))
        put(&g, support.join5("for (", types.cType(start.ty), " ", name, " = "))
        put(&g, support.join5(start.name, "; ", name, " < ", end.name))
        // The half-open comparison guarantees the increment cannot overflow.
        emit(&g, support.join3("; ", name, "++) {"))
    } else {
        let iterable = p.expressions[unparenthesized(p, s.expr)]
        let value = emitExpr(&g, p, ts, reg, s.expr)
        if value.ty.kind != .Vec && value.ty.kind != .Slice {
            lexer.fail(ts, s.token, "E0001", "iteration requires a vector or an integer range")
        }
        if iterable.kind != .Name {
            lexer.fail(ts, s.token, "U0001", "iteration requires a stable Vec local or parameter in this subset")
        }
        let elem = types.element(value.ty)
        // Owned String and struct elements are bound as read-only views of the
        // element (A2): never dropped or moved, and the vector stays locked.
        let owned = types.owned(reg, elem)
        if (owned && elem.kind != .String && elem.kind != .Named) ||
            (elem.kind != .Int && elem.kind != .Byte && elem.kind != .Bool && elem.kind != .Str &&
            elem.kind != .Named && elem.kind != .String) {
            lexer.fail(ts, s.token, "U0001", "iteration over this vector element type is outside the selfhost subset")
        }
        g.iterationLocks.push(value.root)
        declare(&g, ts, s.name, elem, false, owned, false)
        g.locals[g.locals.len() - 1].sources = value.sources
        g.locals[g.locals.len() - 1].element = owned
        let index = support.join2("iter_", support.decimal(g.counter))
        g.counter += 1
        put(&g, support.join5("for (int64_t ", index, " = 0; ", index, " < ("))
        emit(&g, support.join5(value.name, ").len; ", index, "++", ") {"))
        put(&g, support.join5(types.cType(elem), " v_", support.decimal(s.name), " = ((", types.cType(elem)))
        emit(&g, support.join5(" *)(", value.name, ").ptr)[", index, "];"))
    }
    // A header catch still targets the enclosing loop. Enter this loop only
    // after its input expressions and read-only binding have been checked.
    let flow = emitLoopBody(&g, p, ts, reg, s)
    while g.locals.len() > localCount { let _ = g.locals.pop() }
    while g.iterationLocks.len() > lockCount { let _ = g.iterationLocks.pop() }
    // Header owners live across continue, then drop while their C declarations
    // are still in scope. Abrupt outer exits use the existing cleanup edges.
    discardTemps(&g, reg, tempCount)
    emit(&g, "}")
    return flow
}

fn exitsProcess(g: Generator, p: Program, ts: Vec[Token], id: int) -> bool {
    let e = p.expressions[id]
    return e.kind == .Method && ts[e.token].text == "exit" &&
        standardModule(g, p, ts, p.expressions[e.left]) == 1
}

fn emitStatement(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, id: int) -> Flow {
    let s = p.statements[id]
    if s.kind == .Bind {
        var ty = types.resolve(reg, ts, s.annotation)
        g.jumpExpr = s.expr
        let initial = emitExpected(&g, p, ts, reg, s.expr, ty)
        g.jumpExpr = -1
        if ty.kind == .Unknown && initial.indexedBorrow && !initial.field {
            if ts[s.name].text == "_" { return Flow{} }
            lexer.fail(ts, s.token, "U0001", "persistent indexed-element borrows are outside this subset")
        }
        if initial.transient && ts[s.name].text != "_" {
            lexer.fail(ts, s.token, "U0001", "persistent views of owned strings are outside this subset")
        }
        if ty.kind == .Slice && initial.ty.kind == .Vec {
            lexer.fail(ts, s.token, "U0001", "persistent slice views of vectors are outside this subset")
        }
        if ty.kind == .Unknown { ty = initial.ty }
        require(reg, ts, s.token, initial.ty, ty)
        if initial.local >= 0 && g.locals[initial.local].element && ts[s.name].text != "_" {
            // stage0 binds a second read-only alias of the element.
            lexer.fail(ts, s.token, "U0001", "aliasing an iterated element is outside this subset")
        }
        let taken = takeValue(&g, reg, ts, s.token, initial)
        if ts[s.name].text != "_" {
            declare(&g, ts, s.name, ty, s.mutable, false, false)
            g.locals[g.locals.len() - 1].sources = taken.sources
            put(&g, types.cType(ty))
            put(&g, support.join3(" v_", support.decimal(s.name), " = "))
            emit(&g, support.join2(taken.name, ";"))
            zeroValue(&g, reg, taken)
        }
        return Flow{}
    }
    if s.kind == .Assign {
        var target = placeType(g, p, ts, reg, s.target, 0)
        if !target.indexed {
            if !target.mutable { lexer.fail(ts, s.token, "E0014", "cannot assign through an immutable local or parameter") }
            if !target.whole { readable(g, ts, target.root, s.token) }
            writable(g, ts, target.root, s.token)
        }
        if ts[s.token].text == "=" { g.jumpExpr = s.expr }
        let rhs = emitExpected(&g, p, ts, reg, s.expr, target.ty)
        g.jumpExpr = -1
        require(reg, ts, s.token, rhs.ty, target.ty)
        if rhs.transient {
            lexer.fail(ts, s.token, "U0001", "persistent views of owned strings are outside this subset")
        }
        if ts[s.token].text == "=" {
            let valueToken = p.expressions[s.expr].token
            if target.whole && !target.indexed && types.carriesBorrow(target.ty) {
                storeSources(&g, ts, valueToken, target.root, rhs.sources, true, false)
            } else if target.indexed && target.ty.kind == .Str {
                storeSources(&g, ts, valueToken, target.root, rhs.sources, false, false)
            }
            let taken = takeValue(&g, reg, ts, s.token, rhs)
            if target.indexed { target = placeOf(&g, p, ts, reg, s.target, 0) }
            if !target.whole { readable(g, ts, target.root, s.token) }
            dropValue(&g, reg, target.ty, target.name)
            emit(&g, support.join4(target.name, " = ", taken.name, ";"))
            zeroValue(&g, reg, taken)
            if target.whole { g.locals[target.root].moved = false }
        } else {
            if target.indexed { target = placeOf(&g, p, ts, reg, s.target, 0) }
            readable(g, ts, target.root, s.token)
            requireInteger(ts, s.token, target.ty)
            let code = integerOperation(ts, s.token, target.ty.kind, ts[s.token].text, target.name, rhs.name)
            emit(&g, support.join4(target.name, " = ", code, ";"))
        }
        return Flow{}
    }
    if s.kind == .Expr {
        let kind = p.expressions[s.expr].kind
        if kind != .Call && kind != .Method && kind != .Catch && kind != .Try {
            lexer.fail(ts, s.token, "E0001", "only a direct call may stand alone as a statement")
        }
        g.outputRoot = s.expr
        let _ignored = emitExpr(&g, p, ts, reg, s.expr)
        g.outputRoot = -1
        if _ignored.ty.kind == .Result {
            lexer.fail(ts, s.token, "E0001", "the result of this call must be handled or explicitly discarded")
        }
        if exitsProcess(g, p, ts, s.expr) { return Flow{falls: false} }
        return Flow{}
    }
    if s.kind == .Return { return returnStatement(&g, p, ts, reg, s.token, s.expr) }
    if s.kind == .If {
        let tempCount = g.temps.len()
        let condition = emitExpected(&g, p, ts, reg, s.expr, types.primitive(.Bool))
        basic(reg, ts, s.token, condition.ty, .Bool)
        discardTemps(&g, reg, tempCount)
        let before = movedState(g)
        let sourcesBefore = sourceState(g)
        emit(&g, support.join3("if (", condition.name, ")"))
        let yes = emitBlock(&g, p, ts, reg, s.bodyStart, s.bodyCount)
        let yesState = movedState(g)
        let yesSources = sourceState(g)
        restoreState(&g, before)
        restoreSources(&g, sourcesBefore)
        var no = Flow{}
        if s.elseCount > 0 {
            emit(&g, "else")
            no = emitBlock(&g, p, ts, reg, s.elseStart, s.elseCount)
        }
        let noState = movedState(g)
        let noSources = sourceState(g)
        if yes.falls && !no.falls {
            restoreState(&g, yesState)
            restoreSources(&g, yesSources)
        } else if !yes.falls && no.falls {
            restoreState(&g, noState)
            restoreSources(&g, noSources)
        } else {
            let merged = joinStates(yesState, noState)
            restoreState(&g, merged)
            restoreSources(&g, joinSources(yesSources, noSources))
        }
        return Flow{falls: yes.falls || no.falls, breaks: yes.breaks || no.breaks}
    }
    if s.kind == .While || s.kind == .Loop { return loopStatement(&g, p, ts, reg, s) }
    if s.kind == .ForRange || s.kind == .ForEach { return forLoopStatement(&g, p, ts, reg, s) }
    return loopExit(&g, ts, reg, s.token, s.kind == .Break)
}

// `return [expr]`, as a statement or as the fallback of `?? return`.
fn returnStatement(g: inout Generator, p: Program, ts: Vec[Token], reg: Registry, token: int, expr: int) -> Flow {
    if g.result.kind == .Result && types.resultOk(reg, g.result).kind == .Unit {
        if expr < 0 || p.expressions[unparenthesized(p, expr)].kind == .Unit {
            cleanTemps(&g, reg, 0)
            cleanLocals(&g, reg, 0)
            let returnedC = types.cType(g.result)
            emit(&g, support.join3("return (", returnedC, "){ .ok = true };"))
            return Flow{falls: false}
        }
    }
    if expr < 0 {
        require(reg, ts, token, types.primitive(.Unit), g.result)
        cleanTemps(&g, reg, 0)
        cleanLocals(&g, reg, 0)
        emit(&g, "return;")
    } else {
        if g.result.kind == .Unit && p.expressions[expr].kind != .Unit {
            lexer.fail(ts, token, "E0001", "a unit-returning function cannot return a value")
        }
        let resultType = g.result
        let returned = emitExpected(&g, p, ts, reg, expr, resultType)
        if resultType.kind == .Slice && returned.ty.kind == .Vec {
            lexer.fail(ts, token, "U0001", "returning a vector as a slice view is outside this subset")
        }
        require(reg, ts, token, returned.ty, resultType)
        if types.carriesBorrow(returned.ty) { returnedSources(g, p, ts, expr, returned) }
        if returned.ty.kind == .Unit {
            cleanTemps(&g, reg, 0)
            cleanLocals(&g, reg, 0)
            emit(&g, "return;")
        } else {
            let taken = takeValue(&g, reg, ts, token, returned)
            let n = g.counter
            g.counter += 1
            put(&g, types.cType(taken.ty))
            put(&g, support.join3(" return_", support.decimal(n), " = "))
            emit(&g, support.join2(taken.name, ";"))
            zeroValue(&g, reg, taken)
            cleanTemps(&g, reg, 0)
            cleanLocals(&g, reg, 0)
            emit(&g, support.join3("return return_", support.decimal(n), ";"))
        }
    }
    return Flow{falls: false}
}

// `break` or `continue`, as a statement or as the fallback of `?? break`.
fn loopExit(g: inout Generator, ts: Vec[Token], reg: Registry, token: int, breaking: bool) -> Flow {
    if g.loops == 0 { lexer.fail(ts, token, "E0015", "break/continue requires an enclosing loop") }
    let index = g.loopStates.len() - 1
    let localCount = g.loopStates[index].localCount
    let tempCount = g.loopStates[index].tempCount
    recordExit(&g, breaking)
    cleanTemps(&g, reg, tempCount)
    cleanLocals(&g, reg, localCount)
    if breaking {
        emit(&g, "break;")
        return Flow{falls: false, breaks: true}
    }
    emit(&g, "continue;")
    return Flow{falls: false}
}

fn signature(p: Program, ts: Vec[Token], reg: Registry, index: int) -> String {
    let f = p.functions[index]
    var params = String{}
    var i = 0
    while i < f.paramCount {
        let param = p.params[f.paramStart + i]
        let ty = types.resolve(reg, ts, param.ty)
        if ty.kind == .Unit { lexer.fail(ts, param.name, "U0001", "unit parameters are outside the selfhost subset") }
        if i > 0 { params.push(", ") }
        params.push(types.cType(ty))
        if param.byRef { params.push(" *v_") } else { params.push(" v_") }
        params.push(support.decimal(param.name))
        i += 1
    }
    if f.paramCount == 0 { params.push("void") }
    let result = types.resolve(reg, ts, f.result)
    return support.join5(support.join3("static ", types.cType(result), " sh_fn_"), support.decimal(index), "(", params, ")")
}

fn vectorLifecycle(g: inout Generator, reg: Registry, elem: Type) {
    let ty = Type{kind: .Vec, elementKind: elem.kind, elementDecl: elem.decl}
    let et = types.cType(elem)
    let stem = vectorHelper(ty)
    emit(&g, support.join3("static void sh_vec_drop_", stem, "(yv_vec *p) {"))
    emit(&g, support.join5(et, " *items = (", et, " *)p->ptr;", ""))
    emit(&g, "for (int64_t i = 0; i < p->len; ++i) {")
    emit(&g, support.join2(dropName(reg, elem), "(&items[i]);"))
    emit(&g, "}")
    emit(&g, "yv_vec_free(p);")
    emit(&g, "}")
    emit(&g, support.join3("static yv_vec sh_vec_clone_", stem, "(const yv_vec *p, uint32_t line, uint32_t col) {"))
    emit(&g, support.join5("const ", et, " *items = (const ", et, " *)p->ptr;"))
    emit(&g, support.join3("yv_vec out = yv_vec_with_cap((int64_t)sizeof(", et, "), p->len, line, col);"))
    emit(&g, "for (int64_t i = 0; i < p->len; ++i) {")
    let cloned = cloneExpression(reg, elem, "items[i]", "line", "col")
    emit(&g, support.join5("((", et, " *)out.ptr)[i] = ", cloned, ";"))
    emit(&g, "out.len = i + 1;")
    emit(&g, "}")
    emit(&g, "return out;")
    emit(&g, "}")
}

fn optionalLayout(g: inout Generator, elem: Type) {
    let ty = Type{kind: .Optional, elementKind: elem.kind, elementDecl: elem.decl}
    emit(&g, support.join5("typedef struct { bool has; ", types.cType(elem), " val; } ", types.cType(ty), ";"))
}

fn optionalLayouts(g: inout Generator, reg: Registry) {
    optionalLayout(&g, types.primitive(.Int))
    optionalLayout(&g, types.primitive(.Byte))
    optionalLayout(&g, types.primitive(.Bool))
    var i = 0
    while i < reg.entries.len() {
        if !reg.entries[i].owned {
            optionalLayout(&g, Type{kind: .Named, decl: i, elementKind: .Unknown})
        }
        i += 1
    }
}

fn resultLayouts(g: inout Generator, reg: Registry) {
    var i = 0
    while i < reg.results.len() {
        let ty = Type{kind: .Result, decl: i, elementKind: .Unknown}
        let success = types.resultOk(reg, ty)
        let error = types.resultError(reg, ty)
        emit(&g, support.join3("typedef struct sh_result_", support.decimal(i), " {"))
        emit(&g, "bool ok;")
        if success.kind != .Unit { emit(&g, support.join2(types.cType(success), " val;")) }
        emit(&g, support.join2(types.cType(error), " err;"))
        emit(&g, support.join3("} sh_result_", support.decimal(i), ";"))
        i += 1
    }
}

fn resultLifecycle(g: inout Generator, reg: Registry) {
    var i = 0
    while i < reg.results.len() {
        let ty = Type{kind: .Result, decl: i, elementKind: .Unknown}
        if types.owned(reg, ty) {
            emit(&g, support.join5("static void ", dropName(reg, ty), "(", types.cType(ty), " *p) {"))
            emit(&g, "if (p->ok) {")
            dropValue(&g, reg, types.resultOk(reg, ty), "p->val")
            emit(&g, "} else {")
            dropValue(&g, reg, types.resultError(reg, ty), "p->err")
            emit(&g, "}")
            emit(&g, support.join3("*p = (", types.cType(ty), "){0};"))
            emit(&g, "}")
        }
        i += 1
    }
}

fn declarations(g: inout Generator, reg: Registry) {
    var i = 0
    while i < reg.entries.len() {
        if reg.entries[i].kind == .Enum { emit(&g, support.join3("typedef int64_t sh_type_", support.decimal(i), ";")) }
        i += 1
    }
    var k = 0
    while k < reg.order.len() {
        let index = reg.order[k]
        let item = reg.entries[index]
        if item.kind == .Struct {
            emit(&g, support.join3("typedef struct sh_type_", support.decimal(index), " {"))
            if item.fieldCount == 0 { emit(&g, "char sh_empty;") }
            var j = 0
            while j < item.fieldCount {
                emit(&g, support.join4(types.cType(types.fieldOf(reg, index, j).ty), " f_", support.decimal(j), ";"))
                j += 1
            }
            emit(&g, support.join3("} sh_type_", support.decimal(index), ";"))
        }
        k += 1
    }

    optionalLayouts(&g, reg)
    resultLayouts(&g, reg)
    // Map helpers need only these layouts; generate() splices them in here once
    // every instance is known.
    g.mapAt = g.out.len()

    // Every named C layout is complete. Lifecycle prototypes break indirect
    // dependency cycles such as Node -> Vec[Node] without recursive discovery.
    emit(&g, "static void sh_vec_drop_string(yv_vec *p);")
    emit(&g, "static yv_vec sh_vec_clone_string(const yv_vec *p, uint32_t line, uint32_t col);")
    k = 0
    while k < reg.order.len() {
        let index = reg.order[k]
        if reg.entries[index].owned {
            let n = support.decimal(index)
            emit(&g, support.join5("static void sh_drop_", n, "(sh_type_", n, " *p);"))
            emit(&g, support.join5(support.join3("static sh_type_", n, " sh_clone_"), n, "(const sh_type_", n,
                " *p, uint32_t line, uint32_t col);"))
            emit(&g, support.join3("static void sh_vec_drop_type_", n, "(yv_vec *p);"))
            emit(&g, support.join3("static yv_vec sh_vec_clone_type_", n, "(const yv_vec *p, uint32_t line, uint32_t col);"))
        }
        k += 1
    }
    emit(&g, "static yv_vec sh_vec_clone_copy(const yv_vec *p, int64_t elem, uint32_t line, uint32_t col) {")
    emit(&g, "yv_vec out = yv_vec_with_cap(elem, p->len, line, col);")
    emit(&g, "if (p->len > 0) memcpy(out.ptr, p->ptr, (size_t)p->len * (size_t)elem);")
    emit(&g, "out.len = p->len;")
    emit(&g, "return out;")
    emit(&g, "}")
    vectorLifecycle(&g, reg, types.primitive(.String))
    k = 0
    while k < reg.order.len() {
        let index = reg.order[k]
        if reg.entries[index].owned {
            vectorLifecycle(&g, reg, Type{kind: .Named, decl: index, elementKind: .Unknown})
        }
        k += 1
    }
    k = 0
    while k < reg.order.len() {
        let index = reg.order[k]
        if reg.entries[index].owned {
            let n = support.decimal(index)
            emit(&g, support.join5("static void sh_drop_", n, "(sh_type_", n, " *p) {"))
            var j = reg.entries[index].fieldCount
            while j > 0 {
                j -= 1
                let ty = types.fieldOf(reg, index, j).ty
                if types.owned(reg, ty) { emit(&g, support.join4(dropName(reg, ty), "(&p->f_", support.decimal(j), ");")) }
            }
            emit(&g, support.join3("*p = (sh_type_", n, "){0};"))
            emit(&g, "}")
            emit(&g, support.join5(support.join3("static sh_type_", n, " sh_clone_"), n, "(const sh_type_", n,
                " *p, uint32_t line, uint32_t col) {"))
            emit(&g, support.join3("sh_type_", n, " out = *p;"))
            var field = 0
            while field < reg.entries[index].fieldCount {
                let ty = types.fieldOf(reg, index, field).ty
                if types.owned(reg, ty) {
                    let cloned = cloneExpression(reg, ty, support.join2("p->f_", support.decimal(field)), "line", "col")
                    emit(&g, support.join5("out.f_", support.decimal(field), " = ", cloned, ";"))
                }
                field += 1
            }
            emit(&g, "return out;")
            emit(&g, "}")
        }
        k += 1
    }
    resultLifecycle(&g, reg)
}

pub fn generate(p: Program, ts: Vec[Token], filename: str) -> String {
    let reg = types.collect(p, ts)
    var entry = -1
    var i = 0
    while i < p.functions.len() {
        let f = p.functions[i]
        let name = ts[f.name].text.clone()
        if reservedFunction(name) { lexer.fail(ts, f.name, "E0011", "cannot redefine a builtin") }
        var j = 0
        while j < i {
            if p.functions[j].file == f.file && ts[p.functions[j].name].text == name {
                lexer.fail(ts, f.name, "E0011", "duplicate function")
            }
            j += 1
        }
        // Only the entry file's main is the program entry point.
        if name == "main" && f.file == 0 {
            if f.paramCount != 0 || f.result.kind != .Unit {
                lexer.fail(ts, f.name, "E0016", "entry point must be fn main()")
            }
            entry = i
        }
        i += 1
    }
    if entry < 0 { lexer.fail(ts, 0, "E0016", "no fn main() entry point") }
    var g = Generator{result: types.primitive(.Unit)}
    emit(&g, "/* Generated by Yavo selfhost (bootstrap subset). */")
    emit(&g, "#include \"yavo_rt.h\"")
    declarations(&g, reg)
    i = 0
    while i < p.functions.len() {
        emit(&g, support.join2(signature(p, ts, reg, i), ";"))
        i += 1
    }
    i = 0
    while i < p.functions.len() {
        let f = p.functions[i]
        g.file = f.file
        g.result = types.resolve(reg, ts, f.result)
        g.allowed = allowedSources(p, ts, reg, i)
        var k = 0
        while k < f.paramCount {
            let param = p.params[f.paramStart + k]
            let ty = types.resolve(reg, ts, param.ty)
            declare(&g, ts, param.name, ty, param.byRef, param.byRef || types.owned(reg, ty), param.byRef)
            if param.byRef && ty.kind == .Slice {
                lexer.fail(ts, param.name, "U0001", "inout slice parameters are outside this subset")
            }
            if types.carriesBorrow(ty) {
                if k >= 62 {
                    lexer.fail(ts, param.name, "U0001", "borrowing parameters after the 62nd are outside this subset")
                }
                g.locals[k].sources = sourceBit(k)
            }
            k += 1
        }
        emit(&g, signature(p, ts, reg, i))
        emit(&g, "{")
        let flow = emitBlock(&g, p, ts, reg, f.bodyStart, f.bodyCount)
        if g.result.kind != .Unit && flow.falls {
            if g.result.kind == .Result && types.resultOk(reg, g.result).kind == .Unit {
                let returnedC = types.cType(g.result)
                emit(&g, support.join3("return (", returnedC, "){ .ok = true };"))
            } else {
                lexer.fail(ts, f.name, "E0013", "not every path returns a value")
            }
        }
        emit(&g, "}")
        g.locals = []
        i += 1
    }
    if p.files.len() > 1 {
        emit(&g, "static const yv_source_entry yv_source_files[] = {")
        var k = 0
        while k < p.files.len() {
            var eof = ts.len() - 1
            if k + 1 < p.files.len() { eof = p.files[k + 1].firstToken - 1 }
            let first = p.files[k].firstToken
            emit(&g, format("    {${cString(ts[eof].text)}, ${ts[first].lineBase + 1}},"))
            k += 1
        }
        emit(&g, "};")
    }
    emit(&g, "int main(int argc, char **argv) {")
    emit(&g, support.join3("yv_rt_init(", cString(filename), ");"))
    if p.files.len() > 1 {
        emit(&g, "yv_rt_set_sources(yv_source_files, sizeof(yv_source_files) / sizeof(yv_source_files[0]));")
    }
    emit(&g, "yv_rt_args(argc, argv);")
    emit(&g, support.join3("sh_fn_", support.decimal(entry), "();"))
    emit(&g, "return yv_rt_exit();")
    emit(&g, "}")
    // Instances reached only through struct fields or Result payloads.
    i = 0
    while i < reg.fields.len() {
        if reg.fields[i].ty.kind == .Map { useMap(&g, reg.fields[i].ty) }
        i += 1
    }
    i = 0
    while i < reg.results.len() {
        if reg.results[i].ok.kind == .Map { useMap(&g, reg.results[i].ok) }
        if reg.results[i].error.kind == .Map { useMap(&g, reg.results[i].error) }
        i += 1
    }
    let text = take(&g.out)
    g.out = text[0..g.mapAt].toString()
    i = 0
    while i < g.maps.len() {
        let instance = g.maps[i]
        mapLifecycle(&g, instance)
        i += 1
    }
    g.out.push(text[g.mapAt..text.len()])
    return take(&g.out)
}

// The helpers stage0 generates for Map[String, V] with a Copy V: entries in
// insertion order, open-addressing slots, and a rebuild that drops removed
// entries. All-zero is the empty map.
fn mapLifecycle(g: inout Generator, ty: Type) {
    let s = mapHelper(ty)
    let v = types.cType(types.element(ty))
    let o = types.cType(Type{kind: .Optional, elementKind: ty.elementKind})
    let e = format("sh_ment_${s}")
    emit(&g, format("typedef struct ${e} {"))
    emit(&g, "bool live;")
    emit(&g, "yv_string key;")
    emit(&g, format("${v} val;"))
    emit(&g, format("} ${e};"))
    emit(&g, format("static int64_t sh_map_find_${s}(const yv_map *m, yv_str q) {"))
    emit(&g, "if (m->nslots == 0) return -1;")
    emit(&g, "uint64_t mask = (uint64_t)m->nslots - 1, i = yv_hash_bytes((const uint8_t *)q.ptr, q.len) & mask;")
    emit(&g, "for (;;) {")
    emit(&g, "int64_t s = m->slots[i];")
    emit(&g, "if (s == 0) return -1;")
    emit(&g, format("const ${e} *e = &((const ${e} *)m->ents.ptr)[s - 1];"))
    emit(&g, "if (e->live && yv_str_eq(yv_string_view(&e->key), q)) return s - 1;")
    emit(&g, "i = (i + 1) & mask;")
    emit(&g, "}")
    emit(&g, "}")
    emit(&g, format("static void sh_map_rebuild_${s}(yv_map *m, uint32_t line, uint32_t col) {"))
    emit(&g, format("${e} *es = (${e} *)m->ents.ptr;"))
    emit(&g, "int64_t j = 0;")
    emit(&g, "for (int64_t i = 0; i < m->ents.len; i++) {")
    emit(&g, "if (es[i].live) {")
    emit(&g, "if (i != j) es[j] = es[i];")
    emit(&g, "j++;")
    emit(&g, "}")
    emit(&g, "}")
    emit(&g, "m->ents.len = j;")
    emit(&g, "yv_map_slots_reset(m, yv_map_slot_count(j, line, col), line, col);")
    emit(&g, "for (int64_t i = 0; i < j; i++) {")
    emit(&g, "yv_str k = yv_string_view(&es[i].key);")
    emit(&g, "yv_map_slot_put(m, yv_hash_bytes((const uint8_t *)k.ptr, k.len), i);")
    emit(&g, "}")
    emit(&g, "}")
    emit(&g, format("static void sh_map_set_${s}(yv_map *m, yv_string key, ${v} val, uint32_t line, uint32_t col) {"))
    emit(&g, format("int64_t i = sh_map_find_${s}(m, yv_string_view(&key));"))
    emit(&g, "if (i >= 0) {")
    emit(&g, "yv_string_drop(&key);")
    emit(&g, format("((${e} *)m->ents.ptr)[i].val = val;"))
    emit(&g, "return;")
    emit(&g, "}")
    emit(&g, format("if ((m->ents.len + 1) * 2 > m->nslots) sh_map_rebuild_${s}(m, line, col);"))
    emit(&g, format("${e} *e = (${e} *)yv_vec_push_slot(&m->ents, (int64_t)sizeof(${e}), line, col);"))
    emit(&g, "e->live = true;")
    emit(&g, "e->key = key;")
    emit(&g, "e->val = val;")
    emit(&g, "m->live++;")
    emit(&g, "yv_str k = yv_string_view(&e->key);")
    emit(&g, "yv_map_slot_put(m, yv_hash_bytes((const uint8_t *)k.ptr, k.len), m->ents.len - 1);")
    emit(&g, "}")
    emit(&g, format("static ${o} sh_map_get_${s}(const yv_map *m, yv_str q) {"))
    emit(&g, format("${o} r = {0};"))
    emit(&g, format("int64_t i = sh_map_find_${s}(m, q);"))
    emit(&g, format("if (i >= 0) { r.has = true; r.val = ((const ${e} *)m->ents.ptr)[i].val; }"))
    emit(&g, "return r;")
    emit(&g, "}")
    emit(&g, format("static ${o} sh_map_remove_${s}(yv_map *m, yv_str q) {"))
    emit(&g, format("${o} r = {0};"))
    emit(&g, format("int64_t i = sh_map_find_${s}(m, q);"))
    emit(&g, "if (i < 0) return r;")
    emit(&g, format("${e} *e = &((${e} *)m->ents.ptr)[i];"))
    emit(&g, "r.has = true;")
    emit(&g, "r.val = e->val;")
    emit(&g, "yv_string_drop(&e->key);")
    emit(&g, "e->live = false;")
    emit(&g, "m->live--;")
    emit(&g, "return r;")
    emit(&g, "}")
    emit(&g, format("static void sh_map_drop_${s}(yv_map *p) {"))
    emit(&g, format("${e} *es = (${e} *)p->ents.ptr;"))
    emit(&g, "for (int64_t i = 0; i < p->ents.len; i++) {")
    emit(&g, "if (es[i].live) yv_string_drop(&es[i].key);")
    emit(&g, "}")
    emit(&g, "yv_map_free(p);")
    emit(&g, "*p = (yv_map){0};")
    emit(&g, "}")
    emit(&g, format("static yv_map sh_map_clone_${s}(const yv_map *p, uint32_t line, uint32_t col) {"))
    emit(&g, "yv_map m = {0};")
    emit(&g, format("const ${e} *es = (const ${e} *)p->ents.ptr;"))
    emit(&g, "for (int64_t i = 0; i < p->ents.len; i++) {")
    emit(&g, format("if (es[i].live) sh_map_set_${s}(&m, yv_string_from(yv_string_view(&es[i].key), line, col), es[i].val, line, col);"))
    emit(&g, "}")
    emit(&g, "return m;")
    emit(&g, "}")
}
