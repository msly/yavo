// Recursive-descent parser for the bootstrap subset. The first syntax error is fatal.

struct State {
    pos: int = 0
    nesting: int = 0
    items: int = 0
    expressions: Vec[Expression] = []
    statements: Vec[Statement] = []
    functions: Vec[Function] = []
    types: Vec[TypeDecl] = []
    lists: Vec[int] = []
    params: Vec[Parameter] = []
    fields: Vec[FieldDecl] = []
    resultTypes: Vec[ResultRef] = []
    importsFs: bool = false
    importsOs: bool = false
}

fn at(s: State, ts: Vec[Token], text: str) -> bool {
    return (ts[s.pos].kind == .Word || ts[s.pos].kind == .Symbol) && ts[s.pos].text == text
}

fn eat(s: inout State, ts: Vec[Token], text: str) -> bool {
    if at(s, ts, text) {
        s.pos += 1
        return true
    }
    return false
}

fn syntax(s: State, ts: Vec[Token], code: str, message: str) {
    fail(ts, s.pos, code, message)
}

fn expect(s: inout State, ts: Vec[Token], text: str) -> int {
    let p = s.pos
    if !eat(&s, ts, text) {
        syntax(s, ts, "E0020", join3("expected '", text, "'"))
    }
    return p
}

fn newlines(s: inout State, ts: Vec[Token]) {
    while ts[s.pos].kind == .Newline { s.pos += 1 }
}

fn reservedWord(text: str) -> bool {
    return text == "fn" || text == "pub" || text == "let" || text == "var" ||
        text == "if" || text == "else" || text == "while" || text == "for" ||
        text == "in" || text == "loop" || text == "break" || text == "continue" ||
        text == "return" || text == "true" || text == "false" || text == "use" ||
        text == "struct" || text == "enum" || text == "match" || text == "interface" ||
        text == "impl" || text == "const" || text == "type" || text == "none" ||
        text == "err" || text == "try" || text == "catch" || text == "inout" ||
        text == "sink" || text == "of" || text == "with" || text == "scope" ||
        text == "unsafe" || text == "self" || text == "Self" || text == "defer" ||
        text == "spawn"
}

fn identifier(s: inout State, ts: Vec[Token]) -> int {
    if ts[s.pos].kind != .Word || reservedWord(ts[s.pos].text) {
        syntax(s, ts, "E0020", "expected an identifier")
    }
    let p = s.pos
    s.pos += 1
    return p
}

// Child lists are copied contiguously into the shared pool once complete.
fn store(s: inout State, items: Vec[int]) -> int {
    let start = s.lists.len()
    var i = 0
    while i < items.len() {
        s.lists.push(items[i])
        i += 1
    }
    return start
}

fn vectorType(s: inout State, ts: Vec[Token], name: int) -> TypeRef {
    expect(&s, ts, "[")
    let token = s.pos
    let elem = typeName(&s, ts)
    var count = 1
    while eat(&s, ts, ",") {
        let _extra = typeName(&s, ts)
        count += 1
    }
    expect(&s, ts, "]")
    if count != 1 {
        fail(ts, name, "E0001", "Vec takes exactly one type argument")
    }
    if elem.kind == .Vec {
        fail(ts, token, "U0001", "nested Vec elements are outside the selfhost subset")
    }
    if elem.kind == .Result {
        fail(ts, token, "U0001", "Result vector elements are outside the selfhost subset")
    }
    return TypeRef{kind: .Vec, name: name, elementKind: elem.kind, elementName: token}
}

fn typeAtom(s: inout State, ts: Vec[Token]) -> TypeRef {
    enter(&s, ts)
    var result = TypeRef{elementKind: .Unknown, kind: .Unknown}
    if eat(&s, ts, "int") { result = TypeRef{elementKind: .Unknown, kind: .Int}
    } else if eat(&s, ts, "byte") { result = TypeRef{elementKind: .Unknown, kind: .Byte}
    } else if eat(&s, ts, "bool") { result = TypeRef{elementKind: .Unknown, kind: .Bool}
    } else if eat(&s, ts, "str") { result = TypeRef{elementKind: .Unknown, kind: .Str}
    } else if eat(&s, ts, "String") { result = TypeRef{elementKind: .Unknown, kind: .String}
    } else if at(s, ts, "Vec") {
        let name = s.pos
        s.pos += 1
        if at(s, ts, "[") { result = vectorType(&s, ts, name) } else {
            result = TypeRef{elementKind: .Unknown, kind: .Named, name: name}
        }
    } else if eat(&s, ts, "(") {
        let open = s.pos - 1
        if !at(s, ts, ")") {
            let _first = typeName(&s, ts)
            var count = 1
            while eat(&s, ts, ",") {
                if at(s, ts, ")") { break }
                let _next = typeName(&s, ts)
                count += 1
            }
            expect(&s, ts, ")")
            if count < 2 {
                fail(ts, open, "E0020", "a tuple type needs at least two elements")
            }
            fail(ts, open, "U0001", "tuple types are outside the selfhost subset")
        }
        expect(&s, ts, ")")
        result = TypeRef{elementKind: .Unknown, kind: .Unit}
    } else if ts[s.pos].kind == .Word && !reservedWord(ts[s.pos].text) {
        let name = s.pos
        s.pos += 1
        result = TypeRef{elementKind: .Unknown, kind: .Named, name: name}
    } else if at(s, ts, "inout") || at(s, ts, "sink") || at(s, ts, "Self") ||
        at(s, ts, "[") || at(s, ts, "?") || at(s, ts, "??") || at(s, ts, "&") {
        syntax(s, ts, "U0001", "type is outside the selfhost subset")
    } else {
        syntax(s, ts, "E0020", "expected a type name")
    }
    if at(s, ts, "[") || at(s, ts, ".") || at(s, ts, "->") || at(s, ts, "+") {
        syntax(s, ts, "U0001", "type suffix is outside the selfhost subset")
    }
    s.nesting -= 1
    return result
}

fn typeName(s: inout State, ts: Vec[Token]) -> TypeRef {
    let ok = typeAtom(&s, ts)
    if !at(s, ts, "!") { return ok }
    let token = s.pos
    s.pos += 1
    let errorToken = s.pos
    let error = typeAtom(&s, ts)
    if at(s, ts, "!") {
        syntax(s, ts, "E0020", "a result type has one success type and one error type")
    }
    let index = s.resultTypes.len()
    s.resultTypes.push(ResultRef{ok: ok, error: error, errorToken: errorToken})
    return TypeRef{kind: .Result, name: token, elementKind: .Unknown, result: index}
}

fn pushExpr(s: inout State, kind: ExprKind, token: int, left: int, right: int) -> int {
    let id = s.expressions.len()
    s.expressions.push(Expression{kind: kind, token: token, elementKind: .Unknown, left: left, right: right})
    return id
}

fn pushList(s: inout State, kind: ExprKind, token: int, left: int, args: Vec[int]) -> int {
    let start = store(&s, args)
    let id = s.expressions.len()
    s.expressions.push(Expression{kind: kind, token: token, elementKind: .Unknown, left: left,
        argStart: start, argCount: args.len()})
    return id
}

fn pushStmt(s: inout State, kind: StmtKind, token: int, expr: int) -> int {
    let id = s.statements.len()
    s.statements.push(Statement{kind: kind, annotation: TypeRef{elementKind: .Unknown, kind: .Unknown},
        token: token, expr: expr})
    return id
}

fn enter(s: inout State, ts: Vec[Token]) {
    // This is an explicit implementation limit, not a language grammar rule.
    if s.nesting >= 128 {
        syntax(s, ts, "U0001", "selfhost parser nesting limit (128) exceeded")
    }
    s.nesting += 1
}

fn precedence(op: str) -> int {
    if op == "||" { return 1 }
    if op == "&&" { return 2 }
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return 3 }
    if op == "|" { return 5 }
    if op == "^" { return 6 }
    if op == "&" { return 7 }
    if op == "<<" || op == ">>" { return 8 }
    if op == "+" || op == "-" || op == "+%" || op == "-%" { return 9 }
    if op == "*" || op == "/" || op == "%" || op == "*%" { return 10 }
    return 0
}

fn vectorLiteral(s: inout State, ts: Vec[Token]) -> int {
    enter(&s, ts)
    let token = expect(&s, ts, "[")
    var args: Vec[int] = []
    loop {
        while ts[s.pos].kind == .Newline || at(s, ts, ",") { s.pos += 1 }
        if eat(&s, ts, "]") { break }
        if at(s, ts, ":") {
            syntax(s, ts, "U0001", "map literals are outside the selfhost subset")
        }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed vector literal")
        }
        let item = parseExpression(&s, ts)
        if at(s, ts, ":") {
            syntax(s, ts, "U0001", "map literals are outside the selfhost subset")
        }
        args.push(item)
        if ts[s.pos].kind != .Newline && !at(s, ts, ",") && !at(s, ts, "]") {
            syntax(s, ts, "E0020", "expected a newline or comma after the vector element")
        }
    }
    s.nesting -= 1
    return pushList(&s, .Vector, token, -1, args)
}

fn primary(s: inout State, ts: Vec[Token]) -> int {
    let p = s.pos
    if ts[p].kind == .Number {
        s.pos += 1
        return pushExpr(&s, .Number, p, -1, -1)
    }
    if ts[p].kind == .Byte {
        s.pos += 1
        return pushExpr(&s, .Byte, p, -1, -1)
    }
    if ts[p].kind == .Text {
        s.pos += 1
        return pushExpr(&s, .Text, p, -1, -1)
    }
    if at(s, ts, "true") || at(s, ts, "false") {
        s.pos += 1
        return pushExpr(&s, .Boolean, p, -1, -1)
    }
    if eat(&s, ts, "(") {
        if eat(&s, ts, ")") {
            return pushExpr(&s, .Unit, p, -1, -1)
        }
        let inner = parseExpression(&s, ts)
        if at(s, ts, ",") {
            syntax(s, ts, "U0001", "tuple expressions are outside the selfhost subset")
        }
        expect(&s, ts, ")")
        return pushExpr(&s, .Paren, p, inner, -1)
    }
    if eat(&s, ts, "err") {
        // Stage0 parses err as one expression, not a variadic ordinary call.
        expect(&s, ts, "(")
        let error = parseExpression(&s, ts)
        expect(&s, ts, ")")
        return pushList(&s, .Call, p, -1, [error])
    }
    if ts[p].kind == .Word && !reservedWord(ts[p].text) {
        s.pos += 1
        return pushExpr(&s, .Name, p, -1, -1)
    }
    if eat(&s, ts, ".") {
        let variant = identifier(&s, ts)
        return pushExpr(&s, .Variant, variant, -1, -1)
    }
    if at(s, ts, "[") { return vectorLiteral(&s, ts) }
    if at(s, ts, "&") {
        // Borrow syntax is accepted only as an inout or take argument by the checker.
        enter(&s, ts)
        s.pos += 1
        let target = postfix(&s, ts)
        s.nesting -= 1
        return pushExpr(&s, .Ref, p, target, -1)
    }
    if at(s, ts, "match") || at(s, ts, "none") || at(s, ts, "spawn") {
        syntax(s, ts, "U0001", "expression is outside the selfhost SH-1 subset")
    }
    syntax(s, ts, "E0020", "expected an expression")
    return -1
}

fn construction(s: inout State, ts: Vec[Token], name: int) -> int {
    enter(&s, ts)
    expect(&s, ts, "{")
    var args: Vec[int] = []
    var names: Vec[int] = []
    loop {
        while ts[s.pos].kind == .Newline || at(s, ts, ",") { s.pos += 1 }
        if eat(&s, ts, "}") { break }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed struct construction")
        }
        let field = identifier(&s, ts)
        expect(&s, ts, ":")
        let initial = parseExpression(&s, ts)
        names.push(field)
        args.push(initial)
        if ts[s.pos].kind != .Newline && !at(s, ts, ",") && !at(s, ts, "}") {
            syntax(s, ts, "E0020", "expected a newline or comma after the field value")
        }
    }
    s.nesting -= 1
    let id = pushList(&s, .Construct, name, -1, args)
    s.expressions[id].nameStart = store(&s, names)
    s.expressions[id].nameCount = names.len()
    return id
}

// Match stage0's distinction between an index and explicit generic arguments.
fn typeArgumentsAhead(s: State, ts: Vec[Token]) -> bool {
    var depth = 0
    var i = s.pos
    while i < ts.len() {
        if ts[i].kind == .Symbol && ts[i].text == "[" { depth += 1
        } else if ts[i].kind == .Symbol && ts[i].text == "]" {
            depth -= 1
            if depth == 0 {
                if i + 1 >= ts.len() { return false }
                if ts[i + 1].kind == .Symbol && ts[i + 1].text == "(" { return true }
                return ts[i + 1].kind == .Symbol && ts[i + 1].text == "{" && ts[i + 1].start == ts[i].end
            }
        } else if ts[i].kind == .Eof || ts[i].kind == .Newline ||
            ts[i].text == "{" || ts[i].text == "}" || ts[i].text == "=" {
            return false
        }
        i += 1
    }
    return false
}

fn postfix(s: inout State, ts: Vec[Token]) -> int {
    var current = primary(&s, ts)
    loop {
        if eat(&s, ts, ".") {
            let field = identifier(&s, ts)
            current = pushExpr(&s, .Field, field, current, -1)
        } else if at(s, ts, "(") {
            let target = s.expressions[current].token
            let targetKind = s.expressions[current].kind
            let receiver = s.expressions[current].left
            if targetKind != .Name && targetKind != .Field {
                syntax(s, ts, "U0001", "this call target is outside the selfhost subset")
            }
            s.pos += 1
            var args: Vec[int] = []
            while !at(s, ts, ")") {
                let arg = parseExpression(&s, ts)
                args.push(arg)
                if !eat(&s, ts, ",") { break }
            }
            expect(&s, ts, ")")
            if targetKind == .Field {
                current = pushList(&s, .Method, target, receiver, args)
            } else {
                current = pushList(&s, .Call, target, -1, args)
            }
        } else if at(s, ts, "[") {
            let target = s.expressions[current].token
            if s.expressions[current].kind == .Name && typeArgumentsAhead(s, ts) {
                if ts[target].text != "Vec" {
                    syntax(s, ts, "U0001", "generic expressions are outside the selfhost subset")
                }
                let ty = vectorType(&s, ts, target)
                if !at(s, ts, "{") {
                    syntax(s, ts, "U0001", "generic calls are outside the selfhost subset")
                }
                let constructed = construction(&s, ts, target)
                if s.expressions[constructed].argCount > 0 {
                    fail(ts, target, "E0001", "Vec construction takes no fields; use push")
                }
                s.expressions[constructed].kind = .Vector
                s.expressions[constructed].elementKind = ty.elementKind
                s.expressions[constructed].elementName = ty.elementName
                current = constructed
            } else {
                let token = expect(&s, ts, "[")
                if at(s, ts, "..") {
                    syntax(s, ts, "U0001", "slices without a start are outside the selfhost subset")
                }
                let index = parseExpression(&s, ts)
                if eat(&s, ts, "..") {
                    if at(s, ts, "]") {
                        syntax(s, ts, "U0001", "slices without an end are outside the selfhost subset")
                    }
                    let end = parseExpression(&s, ts)
                    expect(&s, ts, "]")
                    current = pushExpr(&s, .Slice, token, current, index)
                    s.expressions[current].extra = end
                } else {
                    if at(s, ts, ",") {
                        syntax(s, ts, "U0001", "type arguments in expressions are outside the selfhost subset")
                    }
                    expect(&s, ts, "]")
                    current = pushExpr(&s, .Index, token, current, index)
                }
            }
        } else if at(s, ts, "{") && s.expressions[current].kind == .Name {
            let name = s.expressions[current].token
            if ts[s.pos].start != ts[name].end || ts[name].text[0] < 'A' || ts[name].text[0] > 'Z' {
                break
            }
            current = construction(&s, ts, name)
        } else {
            break
        }
    }
    return current
}

fn unary(s: inout State, ts: Vec[Token]) -> int {
    if at(s, ts, "try") {
        enter(&s, ts)
        let token = s.pos
        s.pos += 1
        let operand = unary(&s, ts)
        s.nesting -= 1
        return pushExpr(&s, .Try, token, operand, -1)
    }
    if at(s, ts, "-") || at(s, ts, "!") {
        enter(&s, ts)
        let p = s.pos
        s.pos += 1
        let operand = unary(&s, ts)
        s.nesting -= 1
        return pushExpr(&s, .Unary, p, operand, -1)
    }
    return postfix(&s, ts)
}

fn parseBinary(s: inout State, ts: Vec[Token], minimum: int) -> int {
    var lhs = unary(&s, ts)
    loop {
        if ts[s.pos].kind != .Symbol { break }
        let level = precedence(ts[s.pos].text)
        if level == 0 || level < minimum { break }
        let op = s.pos
        s.pos += 1
        let rhs = parseBinary(&s, ts, level + 1)
        lhs = pushExpr(&s, .Binary, op, lhs, rhs)
        if level == 3 && ts[s.pos].kind == .Symbol && precedence(ts[s.pos].text) == 3 {
            syntax(s, ts, "E0020", "comparison operators cannot be chained")
        }
    }
    return lhs
}

fn parseExpression(s: inout State, ts: Vec[Token]) -> int {
    enter(&s, ts)
    var value = parseBinary(&s, ts, 1)
    s.nesting -= 1
    if at(s, ts, "catch") {
        let token = s.pos
        s.pos += 1
        var binding = s.pos
        if ts[s.pos].kind == .Word && ts[s.pos].text == "_" { s.pos += 1 } else {
            binding = identifier(&s, ts)
        }
        if at(s, ts, "=>") {
            syntax(s, ts, "U0001", "expression catch handlers are outside the selfhost subset")
        }
        let handler = parseBlock(&s, ts)
        value = pushList(&s, .Catch, token, value, handler)
        s.expressions[value].extra = binding
    }
    if at(s, ts, "??") ||
        at(s, ts, "catch") || at(s, ts, "=>") || at(s, ts, "(") {
        syntax(s, ts, "U0001", "expression suffix is outside the selfhost SH-1 subset")
    }
    return value
}

fn parseBlock(s: inout State, ts: Vec[Token]) -> Vec[int] {
    enter(&s, ts)
    expect(&s, ts, "{")
    var body: Vec[int] = []
    loop {
        newlines(&s, ts)
        if eat(&s, ts, "}") { break }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed block")
        }
        let item = parseStatement(&s, ts)
        body.push(item)
        if ts[s.pos].kind != .Newline && !at(s, ts, "}") {
            syntax(s, ts, "E0020", "expected a newline after the statement")
        }
    }
    s.nesting -= 1
    return body
}

fn setBody(s: inout State, id: int, body: Vec[int]) {
    s.statements[id].bodyStart = store(&s, body)
    s.statements[id].bodyCount = body.len()
}

fn ifStatement(s: inout State, ts: Vec[Token]) -> int {
    enter(&s, ts)
    let p = expect(&s, ts, "if")
    if at(s, ts, "let") {
        syntax(s, ts, "U0001", "if let is outside the selfhost SH-1 subset")
    }
    let condition = parseExpression(&s, ts)
    let body = parseBlock(&s, ts)
    var other: Vec[int] = []
    // Like stage0, else must share the closing brace's line.
    if eat(&s, ts, "else") {
        if at(s, ts, "if") {
            let nested = ifStatement(&s, ts)
            other.push(nested)
        } else {
            other = parseBlock(&s, ts)
        }
    }
    s.nesting -= 1
    let id = pushStmt(&s, .If, p, condition)
    setBody(&s, id, body)
    s.statements[id].elseStart = store(&s, other)
    s.statements[id].elseCount = other.len()
    return id
}

fn parseStatement(s: inout State, ts: Vec[Token]) -> int {
    let p = s.pos
    if at(s, ts, "let") || at(s, ts, "var") {
        let mutable = at(s, ts, "var")
        s.pos += 1
        let name = identifier(&s, ts)
        var annotation = TypeRef{elementKind: .Unknown, kind: .Unknown}
        if eat(&s, ts, ":") { annotation = typeName(&s, ts) }
        expect(&s, ts, "=")
        let value = parseExpression(&s, ts)
        let id = s.statements.len()
        s.statements.push(Statement{kind: .Bind, token: p, name: name,
            annotation: annotation, mutable: mutable, expr: value})
        return id
    }
    if eat(&s, ts, "return") {
        var value = -1
        if ts[s.pos].kind != .Newline && !at(s, ts, "}") {
            value = parseExpression(&s, ts)
        }
        return pushStmt(&s, .Return, p, value)
    }
    if at(s, ts, "if") { return ifStatement(&s, ts) }
    if eat(&s, ts, "while") {
        if at(s, ts, "let") {
            syntax(s, ts, "U0001", "while let is outside the selfhost SH-1 subset")
        }
        let condition = parseExpression(&s, ts)
        let body = parseBlock(&s, ts)
        let id = pushStmt(&s, .While, p, condition)
        setBody(&s, id, body)
        return id
    }
    if eat(&s, ts, "loop") {
        let body = parseBlock(&s, ts)
        let id = pushStmt(&s, .Loop, p, -1)
        setBody(&s, id, body)
        return id
    }
    if eat(&s, ts, "break") { return pushStmt(&s, .Break, p, -1) }
    if eat(&s, ts, "continue") { return pushStmt(&s, .Continue, p, -1) }
    if at(s, ts, "for") || at(s, ts, "with") || at(s, ts, "scope") ||
        at(s, ts, "defer") || at(s, ts, "unsafe") {
        syntax(s, ts, "U0001", "statement is outside the selfhost SH-1 subset")
    }
    let lhs = parseExpression(&s, ts)
    if at(s, ts, "=") || at(s, ts, "+=") || at(s, ts, "-=") ||
        at(s, ts, "*=") || at(s, ts, "/=") || at(s, ts, "%=") {
        let op = s.pos
        let name = s.expressions[lhs].token
        s.pos += 1
        let rhs = parseExpression(&s, ts)
        let id = pushStmt(&s, .Assign, op, rhs)
        s.statements[id].name = name
        s.statements[id].target = lhs
        return id
    }
    return pushStmt(&s, .Expr, p, lhs)
}

fn parseFunction(s: inout State, ts: Vec[Token]) -> Function {
    expect(&s, ts, "fn")
    let name = identifier(&s, ts)
    if at(s, ts, "[") {
        syntax(s, ts, "U0001", "generics are outside the selfhost SH-1 subset")
    }
    expect(&s, ts, "(")
    var params: Vec[Parameter] = []
    while !at(s, ts, ")") {
        let param = identifier(&s, ts)
        expect(&s, ts, ":")
        let mode = eat(&s, ts, "inout")
        let ty = typeName(&s, ts)
        params.push(Parameter{name: param, ty: ty, byRef: mode})
        if !eat(&s, ts, ",") { break }
    }
    expect(&s, ts, ")")
    var result = TypeRef{elementKind: .Unknown, kind: .Unit}
    if eat(&s, ts, "->") { result = typeName(&s, ts) }
    var borrowedResult = result.kind == .Str
    if result.kind == .Result {
        borrowedResult = s.resultTypes[result.result].ok.kind == .Str
    }
    if borrowedResult || at(s, ts, "of") {
        syntax(s, ts, "U0001", "borrowed returns are outside the selfhost subset")
    }
    let body = parseBlock(&s, ts)
    let paramStart = s.params.len()
    var i = 0
    while i < params.len() {
        s.params.push(params[i])
        i += 1
    }
    let bodyStart = store(&s, body)
    return Function{name: name, result: result, paramStart: paramStart, paramCount: params.len(),
        bodyStart: bodyStart, bodyCount: body.len()}
}

fn aggregate(s: inout State, ts: Vec[Token]) -> TypeDecl {
    var kind: AggregateKind = .Struct
    if eat(&s, ts, "enum") { kind = .Enum } else {
        expect(&s, ts, "struct")
    }
    let name = identifier(&s, ts)
    if at(s, ts, "[") || at(s, ts, ":") {
        syntax(s, ts, "U0001", "generic types and interfaces are outside the selfhost subset")
    }
    expect(&s, ts, "{")
    var fields: Vec[FieldDecl] = []
    var variants: Vec[int] = []
    loop {
        while ts[s.pos].kind == .Newline || at(s, ts, ",") { s.pos += 1 }
        if eat(&s, ts, "}") { break }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed type declaration")
        }
        if at(s, ts, "fn") || at(s, ts, "pub") {
            syntax(s, ts, "U0001", "methods are outside the selfhost subset")
        }
        let member = identifier(&s, ts)
        if kind == .Struct {
            expect(&s, ts, ":")
            let ty = typeName(&s, ts)
            var initial = -1
            if eat(&s, ts, "=") { initial = parseExpression(&s, ts) }
            fields.push(FieldDecl{name: member, ty: ty, initial: initial})
        } else {
            if at(s, ts, "(") {
                syntax(s, ts, "U0001", "enum payloads are outside the selfhost subset")
            }
            variants.push(member)
        }
        if ts[s.pos].kind != .Newline && !at(s, ts, ",") && !at(s, ts, "}") {
            syntax(s, ts, "E0020", "expected a newline or comma after the member")
        }
    }
    let fieldStart = s.fields.len()
    var i = 0
    while i < fields.len() {
        s.fields.push(fields[i])
        i += 1
    }
    let variantStart = store(&s, variants)
    return TypeDecl{kind: kind, name: name, fieldStart: fieldStart, fieldCount: fields.len(),
        variantStart: variantStart, variantCount: variants.len()}
}

// Only the standard fs and os modules are available, and only before other items.
fn importStd(s: inout State, ts: Vec[Token]) {
    let token = expect(&s, ts, "use")
    if s.items > 0 {
        fail(ts, token, "U0001", "imports after other items are outside the selfhost subset")
    }
    if !at(s, ts, "std") {
        syntax(s, ts, "U0001", "module imports are outside the selfhost subset")
    }
    s.pos += 1
    expect(&s, ts, "/")
    var names: Vec[int] = []
    if eat(&s, ts, "{") {
        loop {
            names.push(identifier(&s, ts))
            if !eat(&s, ts, ",") { break }
        }
        expect(&s, ts, "}")
    } else {
        names.push(identifier(&s, ts))
    }
    var i = 0
    while i < names.len() {
        if ts[names[i]].text == "fs" { s.importsFs = true
        } else if ts[names[i]].text == "os" { s.importsOs = true
        } else {
            fail(ts, names[i], "U0001", "this standard module is outside the selfhost subset")
        }
        i += 1
    }
}

pub fn parse(ts: Vec[Token]) -> Program {
    var s = State{}
    loop {
        newlines(&s, ts)
        if ts[s.pos].kind == .Eof { break }
        if at(s, ts, "use") {
            importStd(&s, ts)
            continue
        }
        s.items += 1
        if at(s, ts, "pub") { s.pos += 1 }
        if at(s, ts, "struct") || at(s, ts, "enum") {
            let declaration = aggregate(&s, ts)
            s.types.push(declaration)
        } else if at(s, ts, "fn") {
            let f = parseFunction(&s, ts)
            s.functions.push(f)
        } else {
            if at(s, ts, "interface") || at(s, ts, "impl") ||
                at(s, ts, "const") || at(s, ts, "type") {
                syntax(s, ts, "U0001", "item is outside the selfhost subset")
            }
            syntax(s, ts, "E0020", "expected a function or type item")
        }
    }
    return Program{expressions: take(&s.expressions), statements: take(&s.statements),
        functions: take(&s.functions), types: take(&s.types), lists: take(&s.lists),
        params: take(&s.params), fields: take(&s.fields),
        resultTypes: take(&s.resultTypes),
        importsFs: s.importsFs, importsOs: s.importsOs}
}
