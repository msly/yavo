use support
use lexer
use model

// Recursive-descent parser for the bootstrap subset. The first syntax error is fatal.

struct State {
    pos: int = 0
    nesting: int = 0
    items: int = 0
    expressions: Vec[Expression] = []
    statements: Vec[Statement] = []
    functions: Vec[Function] = []
    types: Vec[TypeDecl] = []
    lists: Vec[int] = []
    params: Vec[Parameter] = []
    fields: Vec[FieldDecl] = []
    resultTypes: Vec[ResultRef] = []
    stringParts: Vec[StringPart] = []
    files: Vec[SourceFile] = []
    imports: Vec[ModuleImport] = []
    file: int = 0
    importsFs: bool = false
    importsOs: bool = false
}

fn at(s: State, ts: Vec[Token], text: str) -> bool {
    return (ts[s.pos].kind == .Word || ts[s.pos].kind == .Symbol) && ts[s.pos].text == text
}

fn eat(s: inout State, ts: Vec[Token], text: str) -> bool {
    if at(s, ts, text) {
        s.pos += 1
        return true
    }
    return false
}

fn syntax(s: State, ts: Vec[Token], code: str, message: str) {
    if ts[s.pos].kind == .DeferredError {
        lexer.fail(ts, s.pos, ts[s.pos].text, ts[s.pos].message)
    }
    lexer.fail(ts, s.pos, code, message)
}

fn expect(s: inout State, ts: Vec[Token], text: str) -> int {
    let p = s.pos
    if !eat(&s, ts, text) {
        syntax(s, ts, "E0020", support.join3("expected '", text, "'"))
    }
    return p
}

fn newlines(s: inout State, ts: Vec[Token]) {
    while ts[s.pos].kind == .Newline { s.pos += 1 }
}

fn reservedWord(text: str) -> bool {
    return text == "fn" || text == "pub" || text == "let" || text == "var" ||
        text == "if" || text == "else" || text == "while" || text == "for" ||
        text == "in" || text == "loop" || text == "break" || text == "continue" ||
        text == "return" || text == "true" || text == "false" || text == "use" ||
        text == "struct" || text == "enum" || text == "match" || text == "interface" ||
        text == "impl" || text == "const" || text == "type" || text == "none" ||
        text == "err" || text == "try" || text == "catch" || text == "inout" ||
        text == "sink" || text == "of" || text == "with" || text == "scope" ||
        text == "unsafe" || text == "self" || text == "Self" || text == "defer" ||
        text == "spawn"
}

fn identifier(s: inout State, ts: Vec[Token]) -> int {
    if ts[s.pos].kind != .Word || reservedWord(ts[s.pos].text) {
        syntax(s, ts, "E0020", "expected an identifier")
    }
    let p = s.pos
    s.pos += 1
    return p
}

// Child lists are copied contiguously into the shared pool once complete.
fn store(s: inout State, items: []int) -> int {
    let start = s.lists.len()
    for item in items {
        s.lists.push(item)
    }
    return start
}

// `Map[String, V]`: the reference keeps the Map token in name and the value
// type in elementKind/elementName; only String keys and scalar values are in
// this subset (resolve() checks the value).
fn mapType(s: inout State, ts: Vec[Token]) -> TypeRef {
    let name = s.pos
    s.pos += 1
    expect(&s, ts, "[")
    let keyToken = s.pos
    let key = typeName(&s, ts)
    var count = 1
    var valueToken = -1
    var value = TypeRef{elementKind: .Unknown, kind: .Unknown}
    while eat(&s, ts, ",") {
        if count == 1 {
            valueToken = s.pos
            value = typeName(&s, ts)
        } else {
            let _extra = typeName(&s, ts)
        }
        count += 1
    }
    expect(&s, ts, "]")
    if count != 2 {
        lexer.fail(ts, name, "E0001", "Map takes exactly two type arguments")
    }
    if key.kind != .String {
        lexer.fail(ts, keyToken, "U0001", "Map keys other than String are outside the selfhost subset")
    }
    if value.kind != .Int && value.kind != .Bool && value.kind != .Byte {
        lexer.fail(ts, valueToken, "U0001", "Map values other than int, bool and byte are outside the selfhost subset")
    }
    return TypeRef{kind: .Map, name: name, elementKind: value.kind, elementName: valueToken}
}

fn vectorType(s: inout State, ts: Vec[Token], name: int) -> TypeRef {
    expect(&s, ts, "[")
    let token = s.pos
    let elem = typeName(&s, ts)
    var count = 1
    while eat(&s, ts, ",") {
        let _extra = typeName(&s, ts)
        count += 1
    }
    expect(&s, ts, "]")
    if count != 1 {
        lexer.fail(ts, name, "E0001", "Vec takes exactly one type argument")
    }
    if elem.kind == .Vec {
        lexer.fail(ts, token, "U0001", "nested Vec elements are outside the selfhost subset")
    }
    if elem.kind == .Result {
        lexer.fail(ts, token, "U0001", "Result vector elements are outside the selfhost subset")
    }
    if elem.kind == .Optional {
        lexer.fail(ts, token, "U0001", "Optional vector elements are outside the selfhost subset")
    }
    return TypeRef{kind: .Vec, name: name, elementKind: elem.kind, elementName: token}
}

fn typeAtom(s: inout State, ts: Vec[Token]) -> TypeRef {
    enter(&s, ts)
    var result = TypeRef{elementKind: .Unknown, kind: .Unknown}
    if eat(&s, ts, "int") { result = TypeRef{elementKind: .Unknown, kind: .Int}
    } else if eat(&s, ts, "byte") { result = TypeRef{elementKind: .Unknown, kind: .Byte}
    } else if eat(&s, ts, "bool") { result = TypeRef{elementKind: .Unknown, kind: .Bool}
    } else if eat(&s, ts, "str") { result = TypeRef{elementKind: .Unknown, kind: .Str}
    } else if eat(&s, ts, "String") { result = TypeRef{elementKind: .Unknown, kind: .String}
    } else if eat(&s, ts, "?") {
        let question = s.pos - 1
        let token = s.pos
        let inner = typeAtom(&s, ts)
        if inner.kind == .Optional || inner.kind == .Vec || inner.kind == .Result {
            lexer.fail(ts, question, "U0001", "nested Optional and container payloads are outside the selfhost subset")
        }
        result = TypeRef{kind: .Optional, name: question, elementKind: inner.kind, elementName: token}
    } else if at(s, ts, "[") && ts[s.pos + 1].text == "]" {
        // A read-only view `[]T`; like Vec, the element is a single atom.
        let open = s.pos
        s.pos += 2
        let token = s.pos
        let inner = typeAtom(&s, ts)
        if inner.kind == .Optional || inner.kind == .Vec || inner.kind == .Result || inner.kind == .Slice {
            lexer.fail(ts, token, "U0001", "slices of containers, Optionals or Results are outside the selfhost subset")
        }
        result = TypeRef{kind: .Slice, name: open, elementKind: inner.kind, elementName: token}
    } else if at(s, ts, "Map") && ts[s.pos + 1].text == "[" {
        result = mapType(&s, ts)
    } else if at(s, ts, "Vec") {
        let name = s.pos
        s.pos += 1
        if at(s, ts, "[") { result = vectorType(&s, ts, name) } else {
            result = TypeRef{elementKind: .Unknown, kind: .Named, name: name}
        }
    } else if eat(&s, ts, "(") {
        let open = s.pos - 1
        if !at(s, ts, ")") {
            let _first = typeName(&s, ts)
            var count = 1
            while eat(&s, ts, ",") {
                if at(s, ts, ")") { break }
                let _next = typeName(&s, ts)
                count += 1
            }
            expect(&s, ts, ")")
            if count < 2 {
                lexer.fail(ts, open, "E0020", "a tuple type needs at least two elements")
            }
            lexer.fail(ts, open, "U0001", "tuple types are outside the selfhost subset")
        }
        expect(&s, ts, ")")
        result = TypeRef{elementKind: .Unknown, kind: .Unit}
    } else if ts[s.pos].kind == .Word && !reservedWord(ts[s.pos].text) {
        let name = s.pos
        s.pos += 1
        // `module.Type`: the reference keeps the module token; resolve() sees
        // the "." after it and looks the type up in that module.
        if at(s, ts, ".") && ts[s.pos + 1].kind == .Word && !reservedWord(ts[s.pos + 1].text) {
            s.pos += 2
        }
        result = TypeRef{elementKind: .Unknown, kind: .Named, name: name}
    } else if at(s, ts, "inout") || at(s, ts, "sink") || at(s, ts, "Self") ||
        at(s, ts, "[") || at(s, ts, "??") || at(s, ts, "&") {
        syntax(s, ts, "U0001", "type is outside the selfhost subset")
    } else {
        syntax(s, ts, "E0020", "expected a type name")
    }
    if at(s, ts, "[") || at(s, ts, ".") || at(s, ts, "->") || at(s, ts, "+") {
        syntax(s, ts, "U0001", "type suffix is outside the selfhost subset")
    }
    s.nesting -= 1
    return result
}

fn typeName(s: inout State, ts: Vec[Token]) -> TypeRef {
    let ok = typeAtom(&s, ts)
    if !at(s, ts, "!") { return ok }
    let token = s.pos
    s.pos += 1
    let errorToken = s.pos
    let error = typeAtom(&s, ts)
    if at(s, ts, "!") {
        syntax(s, ts, "E0020", "a result type has one success type and one error type")
    }
    let index = s.resultTypes.len()
    s.resultTypes.push(ResultRef{ok: ok, error: error, errorToken: errorToken})
    return TypeRef{kind: .Result, name: token, elementKind: .Unknown, result: index}
}

fn pushExpr(s: inout State, kind: ExprKind, token: int, left: int, right: int) -> int {
    let id = s.expressions.len()
    s.expressions.push(Expression{kind: kind, token: token, elementKind: .Unknown, left: left, right: right})
    return id
}

fn pushList(s: inout State, kind: ExprKind, token: int, left: int, args: Vec[int]) -> int {
    let start = store(&s, args)
    let id = s.expressions.len()
    s.expressions.push(Expression{kind: kind, token: token, elementKind: .Unknown, left: left,
        argStart: start, argCount: args.len()})
    return id
}

fn pushStmt(s: inout State, kind: StmtKind, token: int, expr: int) -> int {
    let id = s.statements.len()
    s.statements.push(Statement{kind: kind, annotation: TypeRef{elementKind: .Unknown, kind: .Unknown},
        token: token, expr: expr})
    return id
}

fn enter(s: inout State, ts: Vec[Token]) {
    // This is an explicit implementation limit, not a language grammar rule.
    if s.nesting >= 128 {
        syntax(s, ts, "U0001", "selfhost parser nesting limit (128) exceeded")
    }
    s.nesting += 1
}

fn precedence(op: str) -> int {
    if op == "||" { return 1 }
    if op == "&&" { return 2 }
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return 3 }
    if op == "??" { return 4 }
    if op == "|" { return 5 }
    if op == "^" { return 6 }
    if op == "&" { return 7 }
    if op == "<<" || op == ">>" { return 8 }
    if op == "+" || op == "-" || op == "+%" || op == "-%" { return 9 }
    if op == "*" || op == "/" || op == "%" || op == "*%" { return 10 }
    return 0
}

fn vectorLiteral(s: inout State, ts: Vec[Token]) -> int {
    enter(&s, ts)
    let token = expect(&s, ts, "[")
    var args: Vec[int] = []
    if at(s, ts, ":") && ts[s.pos + 1].text == "]" {
        // `[:]`, the empty Map; its type comes from the expected type.
        s.pos += 2
        s.nesting -= 1
        return pushExpr(&s, .EmptyMap, token, -1, -1)
    }
    loop {
        while ts[s.pos].kind == .Newline || at(s, ts, ",") { s.pos += 1 }
        if eat(&s, ts, "]") { break }
        if at(s, ts, ":") {
            syntax(s, ts, "U0001", "map literals are outside the selfhost subset")
        }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed vector literal")
        }
        let item = parseExpression(&s, ts)
        if at(s, ts, ":") {
            syntax(s, ts, "U0001", "map literals are outside the selfhost subset")
        }
        args.push(item)
        if ts[s.pos].kind != .Newline && !at(s, ts, ",") && !at(s, ts, "]") {
            syntax(s, ts, "E0020", "expected a newline or comma after the vector element")
        }
    }
    s.nesting -= 1
    return pushList(&s, .Vector, token, -1, args)
}

// Rust also diagnoses an empty interpolation when its only source character
// was rejected by the lexer. That diagnostic starts before leading whitespace.
fn interpolationOnlyFault(ts: Vec[Token], opening: int, fault: int) -> bool {
    if fault != opening + 1 || ts[fault].start == ts[opening].start ||
        ts[fault].message != "unexpected character" { return false }
    var pos = ts[fault].start - ts[opening].start
    pos += lexer.scalarWidth(ts[opening].text[pos])
    while pos < ts[opening].text.len() {
        let c = ts[opening].text[pos]
        if c != ' ' && c != '\t' && c != '\r' {
            return c == '/' && pos + 1 < ts[opening].text.len() && ts[opening].text[pos + 1] == '/'
        }
        pos += 1
    }
    return true
}

fn interpolatedString(s: inout State, ts: Vec[Token]) -> int {
    enter(&s, ts)
    let token = s.pos
    s.pos += 1
    var parts: Vec[StringPart] = []
    loop {
        if ts[s.pos].kind == .StringEnd {
            s.pos += 1
            break
        }
        if ts[s.pos].kind == .Text {
            parts.push(StringPart{token: s.pos})
            s.pos += 1
            continue
        }
        if ts[s.pos].kind != .InterpolationStart {
            syntax(s, ts, "E0020", "expected an interpolation part")
        }
        let opening = s.pos
        s.pos += 1
        if ts[s.pos].kind == .InterpolationEnd || ts[s.pos].kind == .FormatSpec {
            lexer.fail(ts, opening, "E0020", "empty interpolation")
        }
        if ts[s.pos].kind == .DeferredError && interpolationOnlyFault(ts, opening, s.pos) {
            lexer.fail(ts, opening, "E0020", "empty interpolation")
        }
        let value = parseExpression(&s, ts)
        var spec = -1
        if ts[s.pos].kind == .FormatSpec {
            spec = s.pos
            s.pos += 1
        }
        if ts[s.pos].kind != .InterpolationEnd {
            syntax(s, ts, "E0020", "only one expression is allowed in an interpolation")
        }
        s.pos += 1
        parts.push(StringPart{token: opening, expr: value, spec: spec})
    }
    s.nesting -= 1
    let start = s.stringParts.len()
    for part in parts { s.stringParts.push(part) }
    let id = pushExpr(&s, .Interpolated, token, -1, -1)
    s.expressions[id].argStart = start
    s.expressions[id].argCount = parts.len()
    return id
}

fn primary(s: inout State, ts: Vec[Token]) -> int {
    let p = s.pos
    if ts[p].kind == .StringStart { return interpolatedString(&s, ts) }
    if ts[p].kind == .Number {
        s.pos += 1
        return pushExpr(&s, .Number, p, -1, -1)
    }
    if ts[p].kind == .Byte {
        s.pos += 1
        return pushExpr(&s, .Byte, p, -1, -1)
    }
    if ts[p].kind == .Text {
        s.pos += 1
        return pushExpr(&s, .Text, p, -1, -1)
    }
    if at(s, ts, "true") || at(s, ts, "false") {
        s.pos += 1
        return pushExpr(&s, .Boolean, p, -1, -1)
    }
    if eat(&s, ts, "none") { return pushExpr(&s, .None, p, -1, -1) }
    if eat(&s, ts, "(") {
        if eat(&s, ts, ")") {
            return pushExpr(&s, .Unit, p, -1, -1)
        }
        let inner = parseExpression(&s, ts)
        if at(s, ts, ",") {
            syntax(s, ts, "U0001", "tuple expressions are outside the selfhost subset")
        }
        expect(&s, ts, ")")
        return pushExpr(&s, .Paren, p, inner, -1)
    }
    if eat(&s, ts, "err") {
        // Stage0 parses err as one expression, not a variadic ordinary call.
        expect(&s, ts, "(")
        let error = parseExpression(&s, ts)
        expect(&s, ts, ")")
        return pushList(&s, .Call, p, -1, [error])
    }
    if ts[p].kind == .Word && !reservedWord(ts[p].text) {
        s.pos += 1
        return pushExpr(&s, .Name, p, -1, -1)
    }
    if eat(&s, ts, ".") {
        let variant = identifier(&s, ts)
        return pushExpr(&s, .Variant, variant, -1, -1)
    }
    if at(s, ts, "[") { return vectorLiteral(&s, ts) }
    if at(s, ts, "&") {
        // Borrow syntax is accepted only as an inout or take argument by the checker.
        enter(&s, ts)
        s.pos += 1
        let target = postfix(&s, ts)
        s.nesting -= 1
        return pushExpr(&s, .Ref, p, target, -1)
    }
    if at(s, ts, "match") || at(s, ts, "spawn") {
        syntax(s, ts, "U0001", "expression is outside the selfhost SH-1 subset")
    }
    if at(s, ts, "*") { syntax(s, ts, "U0001", "dereference is outside the selfhost subset") }
    syntax(s, ts, "E0020", "expected an expression")
    return -1
}

fn construction(s: inout State, ts: Vec[Token], name: int) -> int {
    enter(&s, ts)
    expect(&s, ts, "{")
    var args: Vec[int] = []
    var names: Vec[int] = []
    loop {
        while ts[s.pos].kind == .Newline || at(s, ts, ",") { s.pos += 1 }
        if eat(&s, ts, "}") { break }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed struct construction")
        }
        let field = identifier(&s, ts)
        expect(&s, ts, ":")
        let initial = parseExpression(&s, ts)
        names.push(field)
        args.push(initial)
        if ts[s.pos].kind != .Newline && !at(s, ts, ",") && !at(s, ts, "}") {
            syntax(s, ts, "E0020", "expected a newline or comma after the field value")
        }
    }
    s.nesting -= 1
    let id = pushList(&s, .Construct, name, -1, args)
    s.expressions[id].nameStart = store(&s, names)
    s.expressions[id].nameCount = names.len()
    return id
}

// Match stage0's distinction between an index and explicit generic arguments.
fn typeArgumentsAhead(s: State, ts: Vec[Token]) -> bool {
    var depth = 0
    var i = s.pos
    while i < ts.len() {
        if ts[i].kind == .Symbol && ts[i].text == "[" { depth += 1
        } else if ts[i].kind == .Symbol && ts[i].text == "]" {
            depth -= 1
            if depth == 0 {
                if i + 1 >= ts.len() { return false }
                if ts[i + 1].kind == .Symbol && ts[i + 1].text == "(" { return true }
                return ts[i + 1].kind == .Symbol && ts[i + 1].text == "{" && ts[i + 1].start == ts[i].end
            }
        } else if ts[i].kind == .Eof || ts[i].kind == .Newline ||
            ts[i].text == "{" || ts[i].text == "}" || ts[i].text == "=" {
            return false
        }
        i += 1
    }
    return false
}

fn postfix(s: inout State, ts: Vec[Token]) -> int {
    var current = primary(&s, ts)
    loop {
        if eat(&s, ts, ".") {
            let field = identifier(&s, ts)
            current = pushExpr(&s, .Field, field, current, -1)
        } else if at(s, ts, "(") {
            let target = s.expressions[current].token
            let targetKind = s.expressions[current].kind
            let receiver = s.expressions[current].left
            if targetKind != .Name && targetKind != .Field {
                syntax(s, ts, "U0001", "this call target is outside the selfhost subset")
            }
            s.pos += 1
            var args: Vec[int] = []
            while !at(s, ts, ")") {
                let arg = parseExpression(&s, ts)
                args.push(arg)
                if !eat(&s, ts, ",") { break }
            }
            expect(&s, ts, ")")
            if targetKind == .Field {
                current = pushList(&s, .Method, target, receiver, args)
            } else {
                current = pushList(&s, .Call, target, -1, args)
            }
        } else if at(s, ts, "[") {
            let target = s.expressions[current].token
            if s.expressions[current].kind == .Name && typeArgumentsAhead(s, ts) {
                if ts[target].text != "Vec" {
                    syntax(s, ts, "U0001", "generic expressions are outside the selfhost subset")
                }
                let ty = vectorType(&s, ts, target)
                if !at(s, ts, "{") {
                    syntax(s, ts, "U0001", "generic calls are outside the selfhost subset")
                }
                let constructed = construction(&s, ts, target)
                if s.expressions[constructed].argCount > 0 {
                    lexer.fail(ts, target, "E0001", "Vec construction takes no fields; use push")
                }
                s.expressions[constructed].kind = .Vector
                s.expressions[constructed].elementKind = ty.elementKind
                s.expressions[constructed].elementName = ty.elementName
                current = constructed
            } else {
                let token = expect(&s, ts, "[")
                if at(s, ts, "..") {
                    syntax(s, ts, "U0001", "slices without a start are outside the selfhost subset")
                }
                let index = parseExpression(&s, ts)
                if eat(&s, ts, "..") {
                    if at(s, ts, "]") {
                        syntax(s, ts, "U0001", "slices without an end are outside the selfhost subset")
                    }
                    let end = parseExpression(&s, ts)
                    expect(&s, ts, "]")
                    current = pushExpr(&s, .Slice, token, current, index)
                    s.expressions[current].extra = end
                } else {
                    if at(s, ts, ",") {
                        syntax(s, ts, "U0001", "type arguments in expressions are outside the selfhost subset")
                    }
                    expect(&s, ts, "]")
                    current = pushExpr(&s, .Index, token, current, index)
                }
            }
        } else if at(s, ts, "{") && (s.expressions[current].kind == .Name ||
            (s.expressions[current].kind == .Field &&
             s.expressions[s.expressions[current].left].kind == .Name)) {
            let name = s.expressions[current].token
            if ts[s.pos].start != ts[name].end || ts[name].text[0] < 'A' || ts[name].text[0] > 'Z' {
                break
            }
            var qualifier = -1
            if s.expressions[current].kind == .Field {
                qualifier = s.expressions[s.expressions[current].left].token
            }
            current = construction(&s, ts, name)
            // A module-qualified construction keeps the module token in extra.
            s.expressions[current].extra = qualifier
        } else {
            break
        }
    }
    return current
}

fn unary(s: inout State, ts: Vec[Token]) -> int {
    if at(s, ts, "try") {
        enter(&s, ts)
        let token = s.pos
        s.pos += 1
        let operand = unary(&s, ts)
        s.nesting -= 1
        return pushExpr(&s, .Try, token, operand, -1)
    }
    if at(s, ts, "-") || at(s, ts, "!") {
        enter(&s, ts)
        let p = s.pos
        s.pos += 1
        let operand = unary(&s, ts)
        s.nesting -= 1
        return pushExpr(&s, .Unary, p, operand, -1)
    }
    return postfix(&s, ts)
}

fn parseBinary(s: inout State, ts: Vec[Token], minimum: int) -> int {
    var lhs = unary(&s, ts)
    loop {
        if ts[s.pos].kind != .Symbol { break }
        let level = precedence(ts[s.pos].text)
        if level == 0 || level < minimum { break }
        let op = s.pos
        s.pos += 1
        if level == 4 {
            if at(s, ts, "return") || at(s, ts, "break") || at(s, ts, "continue") {
                // Where the jump may stand is decided when the statement is checked.
                let keyword = s.pos
                s.pos += 1
                var value = -1
                if ts[keyword].text == "return" && ts[s.pos].kind != .Newline && ts[s.pos].kind != .Eof &&
                    !at(s, ts, "}") && !at(s, ts, ")") && !at(s, ts, ",") {
                    value = parseExpression(&s, ts)
                }
                let jump = pushExpr(&s, .Jump, keyword, value, -1)
                lhs = pushExpr(&s, .Coalesce, op, lhs, jump)
                continue
            }
            // Unlike the other binary operators, ?? is right associative.
            // Bound its same-precedence recursion with the parser nesting gate.
            enter(&s, ts)
            let rhs = parseBinary(&s, ts, level)
            s.nesting -= 1
            lhs = pushExpr(&s, .Coalesce, op, lhs, rhs)
        } else {
            let rhs = parseBinary(&s, ts, level + 1)
            lhs = pushExpr(&s, .Binary, op, lhs, rhs)
        }
        if level == 3 && ts[s.pos].kind == .Symbol && precedence(ts[s.pos].text) == 3 {
            syntax(s, ts, "E0020", "comparison operators cannot be chained")
        }
    }
    return lhs
}

fn parseExpression(s: inout State, ts: Vec[Token]) -> int {
    enter(&s, ts)
    var value = parseBinary(&s, ts, 1)
    s.nesting -= 1
    if at(s, ts, "catch") {
        let token = s.pos
        s.pos += 1
        var binding = s.pos
        if ts[s.pos].kind == .Word && ts[s.pos].text == "_" { s.pos += 1 } else {
            binding = identifier(&s, ts)
        }
        if at(s, ts, "=>") {
            syntax(s, ts, "U0001", "expression catch handlers are outside the selfhost subset")
        }
        let handler = parseBlock(&s, ts)
        value = pushList(&s, .Catch, token, value, handler)
        s.expressions[value].extra = binding
    }
    if at(s, ts, "??") ||
        at(s, ts, "catch") || at(s, ts, "=>") || at(s, ts, "(") {
        syntax(s, ts, "U0001", "expression suffix is outside the selfhost SH-1 subset")
    }
    return value
}

fn parseBlock(s: inout State, ts: Vec[Token]) -> Vec[int] {
    enter(&s, ts)
    expect(&s, ts, "{")
    var body: Vec[int] = []
    loop {
        newlines(&s, ts)
        if eat(&s, ts, "}") { break }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed block")
        }
        let item = parseStatement(&s, ts)
        body.push(item)
        if ts[s.pos].kind != .Newline && !at(s, ts, "}") {
            syntax(s, ts, "E0020", "expected a newline after the statement")
        }
    }
    s.nesting -= 1
    return body
}

fn setBody(s: inout State, id: int, body: Vec[int]) {
    s.statements[id].bodyStart = store(&s, body)
    s.statements[id].bodyCount = body.len()
}

fn ifStatement(s: inout State, ts: Vec[Token]) -> int {
    enter(&s, ts)
    let p = expect(&s, ts, "if")
    if at(s, ts, "let") {
        syntax(s, ts, "U0001", "if let is outside the selfhost SH-1 subset")
    }
    let condition = parseExpression(&s, ts)
    let body = parseBlock(&s, ts)
    var other: Vec[int] = []
    // Like stage0, else must share the closing brace's line.
    if eat(&s, ts, "else") {
        if at(s, ts, "if") {
            let nested = ifStatement(&s, ts)
            other.push(nested)
        } else {
            other = parseBlock(&s, ts)
        }
    }
    s.nesting -= 1
    let id = pushStmt(&s, .If, p, condition)
    setBody(&s, id, body)
    s.statements[id].elseStart = store(&s, other)
    s.statements[id].elseCount = other.len()
    return id
}

fn forStatement(s: inout State, ts: Vec[Token]) -> int {
    let token = expect(&s, ts, "for")
    let name = identifier(&s, ts)
    var second = -1
    if eat(&s, ts, ",") { second = identifier(&s, ts) }
    expect(&s, ts, "in")
    // Both inputs use the ordinary expression parser: a terminating catch may
    // consume its own block before the range delimiter or the loop body.
    let value = parseExpression(&s, ts)
    var kind: StmtKind = .ForEach
    var end = -1
    if eat(&s, ts, "..") {
        if second >= 0 {
            lexer.fail(ts, second, "E0020", "a range loop has one variable")
        }
        kind = .ForRange
        end = parseExpression(&s, ts)
    } else if second >= 0 {
        lexer.fail(ts, second, "U0001", "indexed iteration is outside the selfhost subset")
    }
    let body = parseBlock(&s, ts)
    let id = pushStmt(&s, kind, token, value)
    s.statements[id].name = name
    s.statements[id].target = end
    setBody(&s, id, body)
    return id
}

fn parseStatement(s: inout State, ts: Vec[Token]) -> int {
    let p = s.pos
    if at(s, ts, "{") { syntax(s, ts, "U0001", "block statements are outside the selfhost subset") }
    if at(s, ts, "let") || at(s, ts, "var") {
        let mutable = at(s, ts, "var")
        s.pos += 1
        let name = identifier(&s, ts)
        var annotation = TypeRef{elementKind: .Unknown, kind: .Unknown}
        if eat(&s, ts, ":") { annotation = typeName(&s, ts) }
        expect(&s, ts, "=")
        let value = parseExpression(&s, ts)
        let id = s.statements.len()
        s.statements.push(Statement{kind: .Bind, token: p, name: name,
            annotation: annotation, mutable: mutable, expr: value})
        return id
    }
    if eat(&s, ts, "return") {
        var value = -1
        if ts[s.pos].kind != .Newline && !at(s, ts, "}") {
            value = parseExpression(&s, ts)
        }
        return pushStmt(&s, .Return, p, value)
    }
    if at(s, ts, "if") { return ifStatement(&s, ts) }
    if eat(&s, ts, "while") {
        if at(s, ts, "let") {
            syntax(s, ts, "U0001", "while let is outside the selfhost SH-1 subset")
        }
        let condition = parseExpression(&s, ts)
        let body = parseBlock(&s, ts)
        let id = pushStmt(&s, .While, p, condition)
        setBody(&s, id, body)
        return id
    }
    if eat(&s, ts, "loop") {
        let body = parseBlock(&s, ts)
        let id = pushStmt(&s, .Loop, p, -1)
        setBody(&s, id, body)
        return id
    }
    if at(s, ts, "for") { return forStatement(&s, ts) }
    if eat(&s, ts, "break") { return pushStmt(&s, .Break, p, -1) }
    if eat(&s, ts, "continue") { return pushStmt(&s, .Continue, p, -1) }
    if at(s, ts, "with") || at(s, ts, "scope") ||
        at(s, ts, "defer") || at(s, ts, "unsafe") {
        syntax(s, ts, "U0001", "statement is outside the selfhost SH-1 subset")
    }
    let lhs = parseExpression(&s, ts)
    if at(s, ts, "=") || at(s, ts, "+=") || at(s, ts, "-=") ||
        at(s, ts, "*=") || at(s, ts, "/=") || at(s, ts, "%=") {
        let op = s.pos
        let name = s.expressions[lhs].token
        s.pos += 1
        let rhs = parseExpression(&s, ts)
        let id = pushStmt(&s, .Assign, op, rhs)
        s.statements[id].name = name
        s.statements[id].target = lhs
        return id
    }
    return pushStmt(&s, .Expr, p, lhs)
}

fn parseFunction(s: inout State, ts: Vec[Token]) -> Function {
    expect(&s, ts, "fn")
    let name = identifier(&s, ts)
    if at(s, ts, "[") {
        syntax(s, ts, "U0001", "generics are outside the selfhost SH-1 subset")
    }
    expect(&s, ts, "(")
    var params: Vec[Parameter] = []
    while !at(s, ts, ")") {
        let param = identifier(&s, ts)
        expect(&s, ts, ":")
        let mode = eat(&s, ts, "inout")
        let ty = typeName(&s, ts)
        params.push(Parameter{name: param, ty: ty, byRef: mode})
        if !eat(&s, ts, ",") { break }
    }
    expect(&s, ts, ")")
    var result = TypeRef{elementKind: .Unknown, kind: .Unit}
    if eat(&s, ts, "->") { result = typeName(&s, ts) }
    // Like stage0, any word may name a source here; names are resolved
    // against the parameters when the function is checked.
    var sourced = false
    var sources: Vec[int] = []
    if result.kind != .Unit && eat(&s, ts, "of") {
        sourced = true
        let paren = eat(&s, ts, "(")
        loop {
            if ts[s.pos].kind != .Word {
                syntax(s, ts, "E0020", "expected a parameter name or static after of")
            }
            sources.push(s.pos)
            s.pos += 1
            if !paren || !eat(&s, ts, ",") { break }
        }
        if paren { expect(&s, ts, ")") }
    }
    let body = parseBlock(&s, ts)
    let paramStart = s.params.len()
    var i = 0
    while i < params.len() {
        s.params.push(params[i])
        i += 1
    }
    let sourceStart = store(&s, sources)
    let bodyStart = store(&s, body)
    return Function{name: name, result: result, paramStart: paramStart, paramCount: params.len(),
        bodyStart: bodyStart, bodyCount: body.len(), sourced: sourced, sourceStart: sourceStart,
        sourceCount: sources.len()}
}

fn aggregate(s: inout State, ts: Vec[Token]) -> TypeDecl {
    var kind: AggregateKind = .Struct
    if eat(&s, ts, "enum") { kind = .Enum } else {
        expect(&s, ts, "struct")
    }
    let name = identifier(&s, ts)
    if at(s, ts, "[") || at(s, ts, ":") {
        syntax(s, ts, "U0001", "generic types and interfaces are outside the selfhost subset")
    }
    expect(&s, ts, "{")
    var fields: Vec[FieldDecl] = []
    var variants: Vec[int] = []
    loop {
        while ts[s.pos].kind == .Newline || at(s, ts, ",") { s.pos += 1 }
        if eat(&s, ts, "}") { break }
        if ts[s.pos].kind == .Eof {
            syntax(s, ts, "E0020", "unclosed type declaration")
        }
        if at(s, ts, "fn") || at(s, ts, "pub") {
            syntax(s, ts, "U0001", "methods are outside the selfhost subset")
        }
        let member = identifier(&s, ts)
        if kind == .Struct {
            expect(&s, ts, ":")
            let ty = typeName(&s, ts)
            var initial = -1
            if eat(&s, ts, "=") { initial = parseExpression(&s, ts) }
            fields.push(FieldDecl{name: member, ty: ty, initial: initial})
        } else {
            if at(s, ts, "(") {
                syntax(s, ts, "U0001", "enum payloads are outside the selfhost subset")
            }
            variants.push(member)
        }
        if ts[s.pos].kind != .Newline && !at(s, ts, ",") && !at(s, ts, "}") {
            syntax(s, ts, "E0020", "expected a newline or comma after the member")
        }
    }
    let fieldStart = s.fields.len()
    var i = 0
    while i < fields.len() {
        s.fields.push(fields[i])
        i += 1
    }
    let variantStart = store(&s, variants)
    return TypeDecl{kind: kind, name: name, fieldStart: fieldStart, fieldCount: fields.len(),
        variantStart: variantStart, variantCount: variants.len()}
}

// Standard fs/os imports set per-file flags; any other path names a user
// module relative to the entry file's directory. Imports precede other items.
fn importItem(s: inout State, ts: Vec[Token]) {
    let token = expect(&s, ts, "use")
    if s.items > 0 {
        lexer.fail(ts, token, "U0001", "imports after other items are outside the selfhost subset")
    }
    if !at(s, ts, "std") {
        moduleImport(&s, ts)
        return
    }
    s.pos += 1
    expect(&s, ts, "/")
    var names: Vec[int] = []
    if eat(&s, ts, "{") {
        loop {
            names.push(identifier(&s, ts))
            if !eat(&s, ts, ",") { break }
        }
        expect(&s, ts, "}")
    } else {
        names.push(identifier(&s, ts))
    }
    var i = 0
    while i < names.len() {
        if ts[names[i]].text == "fs" { s.importsFs = true
        } else if ts[names[i]].text == "os" { s.importsOs = true
        } else {
            lexer.fail(ts, names[i], "U0001", "this standard module is outside the selfhost subset")
        }
        i += 1
    }
}

fn moduleImport(s: inout State, ts: Vec[Token]) {
    let prefixStart = s.pos
    var prefixCount = 0
    var names: Vec[int] = [identifier(&s, ts)]
    while eat(&s, ts, "/") {
        if eat(&s, ts, "{") {
            prefixCount = names.len()
            names = []
            loop {
                names.push(identifier(&s, ts))
                if !eat(&s, ts, ",") { break }
            }
            expect(&s, ts, "}")
            break
        }
        names.push(identifier(&s, ts))
    }
    if prefixCount == 0 {
        // Without braces, every segment but the last is prefix.
        prefixCount = names.len() - 1
        names = [names[names.len() - 1]]
    }
    let first = s.files[s.file].importStart
    for alias in names {
        var j = first
        while j < s.imports.len() {
            if ts[s.imports[j].alias].text == ts[alias].text {
                lexer.fail(ts, alias, "E0011", support.join3("module name '", ts[alias].text, "' is imported more than once"))
            }
            j += 1
        }
        s.imports.push(ModuleImport{alias: alias, prefixStart: prefixStart, prefixCount: prefixCount})
    }
}

pub fn startParse() -> State {
    return State{}
}

// Parses one file whose tokens start at s.pos (the file's first token) and
// stops after that file's Eof. Items record their file and visibility.
pub fn parseFile(s: inout State, ts: Vec[Token]) {
    s.file = s.files.len()
    s.files.push(SourceFile{firstToken: s.pos, importStart: s.imports.len()})
    s.items = 0
    s.importsFs = false
    s.importsOs = false
    loop {
        newlines(&s, ts)
        if ts[s.pos].kind == .Eof { break }
        if at(s, ts, "use") {
            importItem(&s, ts)
            continue
        }
        s.items += 1
        let public = eat(&s, ts, "pub")
        if at(s, ts, "struct") || at(s, ts, "enum") {
            var declaration = aggregate(&s, ts)
            declaration.file = s.file
            declaration.public = public
            s.types.push(declaration)
        } else if at(s, ts, "fn") {
            var f = parseFunction(&s, ts)
            f.file = s.file
            f.public = public
            s.functions.push(f)
        } else {
            if at(s, ts, "interface") || at(s, ts, "impl") ||
                at(s, ts, "const") || at(s, ts, "type") {
                syntax(s, ts, "U0001", "item is outside the selfhost subset")
            }
            syntax(s, ts, "E0020", "expected a function or type item")
        }
    }
    s.pos += 1
    s.files[s.file].importsFs = s.importsFs
    s.files[s.file].importsOs = s.importsOs
    s.files[s.file].importCount = s.imports.len() - s.files[s.file].importStart
    // A module name may not also name a top-level declaration of this file.
    var j = s.files[s.file].importStart
    while j < s.imports.len() {
        let alias = s.imports[j].alias
        var clash = false
        var k = 0
        while k < s.functions.len() {
            if s.functions[k].file == s.file && ts[s.functions[k].name].text == ts[alias].text { clash = true }
            k += 1
        }
        k = 0
        while k < s.types.len() {
            if s.types[k].file == s.file && ts[s.types[k].name].text == ts[alias].text { clash = true }
            k += 1
        }
        if clash {
            lexer.fail(ts, alias, "E0011", support.join3("module name '", ts[alias].text, "' conflicts with a local declaration"))
        }
        j += 1
    }
}

pub fn finishParse(s: inout State) -> Program {
    return Program{expressions: take(&s.expressions), statements: take(&s.statements),
        functions: take(&s.functions), types: take(&s.types), lists: take(&s.lists),
        params: take(&s.params), fields: take(&s.fields),
        resultTypes: take(&s.resultTypes), stringParts: take(&s.stringParts),
        files: take(&s.files), imports: take(&s.imports)}
}

pub fn parse(ts: Vec[Token]) -> Program {
    var s = State{}
    parseFile(&s, ts)
    return finishParse(&s)
}
