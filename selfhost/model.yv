// Flat, Copy AST: edges and child lists are indices into Program pools;
// source spelling lives in lexer tokens.
pub enum BasicType {
    Unknown
    Unit
    Int
    Bool
    Str
    String
    Vec
    Named
    Byte
    Args
    Result
    Optional
}

pub struct TypeRef {
    kind: BasicType
    name: int = -1
    elementKind: BasicType
    elementName: int = -1
    result: int = -1
}

// Vec and Copy Optional share the flat elementKind/elementName representation;
// neither admits another container or Result as its element in this subset.

// Result payloads are non-Result types. The syntax pool keeps TypeRef Copy.
pub struct ResultRef {
    ok: TypeRef
    error: TypeRef
    errorToken: int
}

pub enum AggregateKind {
    Struct
    Enum
}

pub struct FieldDecl {
    name: int
    ty: TypeRef
    initial: int = -1
}

// fieldStart/fieldCount index Program.fields; variants index Program.lists.
pub struct TypeDecl {
    kind: AggregateKind
    name: int
    fieldStart: int = 0
    fieldCount: int = 0
    variantStart: int = 0
    variantCount: int = 0
}

pub enum ExprKind {
    Unit
    Paren
    Number
    Boolean
    Text
    Name
    Unary
    Binary
    Call
    Method
    Construct
    Vector
    Index
    Field
    Variant
    Byte
    Slice
    Ref
    Catch
    Try
    None
    Coalesce
    Interpolated
}

// args/names index Program.lists. A Slice keeps its end in extra; a Catch
// keeps its handler statements in args and its binding token in extra.
// Interpolated is the exception: its args directly index Program.stringParts.
pub struct Expression {
    kind: ExprKind
    token: int
    elementKind: BasicType
    elementName: int = -1
    left: int = -1
    right: int = -1
    extra: int = -1
    argStart: int = 0
    argCount: int = 0
    nameStart: int = 0
    nameCount: int = 0
}

// A text part uses token's decoded text and expr=-1. A value part keeps its
// expression index and optional raw format-specifier token (without the colon).
pub struct StringPart {
    token: int
    expr: int = -1
    spec: int = -1
}

pub enum StmtKind {
    Bind
    Assign
    Expr
    Return
    If
    While
    Loop
    Break
    Continue
    ForRange
    ForEach
}

// body/otherwise index Program.lists. For loops keep the binding token in name;
// expr is the range start or iterable, and a ForRange keeps its end in target.
pub struct Statement {
    kind: StmtKind
    token: int
    name: int = -1
    target: int = -1
    annotation: TypeRef
    mutable: bool = false
    expr: int = -1
    bodyStart: int = 0
    bodyCount: int = 0
    elseStart: int = 0
    elseCount: int = 0
}

pub struct Parameter {
    name: int
    ty: TypeRef
    byRef: bool = false
}

// params index Program.params; body indexes Program.lists.
pub struct Function {
    name: int
    result: TypeRef
    paramStart: int = 0
    paramCount: int = 0
    bodyStart: int = 0
    bodyCount: int = 0
}

pub struct Program {
    expressions: Vec[Expression] = []
    statements: Vec[Statement] = []
    functions: Vec[Function] = []
    types: Vec[TypeDecl] = []
    lists: Vec[int] = []
    params: Vec[Parameter] = []
    fields: Vec[FieldDecl] = []
    resultTypes: Vec[ResultRef] = []
    stringParts: Vec[StringPart] = []
    importsFs: bool = false
    importsOs: bool = false
}
