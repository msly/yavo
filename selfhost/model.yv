// Flat, Copy AST: edges and child lists are indices into Program pools;
// source spelling lives in lexer tokens.
pub enum BasicType {
    Unknown
    Unit
    Int
    Bool
    Str
    String
    Vec
    Named
    Byte
    Args
    Result
    Optional
    Slice
    Map
    Tuple
    Set
    Heap
}

pub struct TypeRef {
    kind: BasicType
    name: int = -1
    elementKind: BasicType
    elementName: int = -1
    result: int = -1
    tupleStart: int = -1
    tupleCount: int = 0
}

// Vec, Heap and Optional share the flat elementKind/elementName representation.
// Flat tuple members index Program.tupleAtoms; Optional tuples carry the same
// tupleStart/tupleCount, as do Heap elements, so TypeRef remains Copy. A Vec
// whose elementKind is Vec denotes exactly Vec[Vec[int]]; other nesting stays out.

// Result payloads are non-Result types. The syntax pool keeps TypeRef Copy.
pub struct ResultRef {
    ok: TypeRef
    error: TypeRef
    errorToken: int
}

pub enum AggregateKind {
    Struct
    Enum
}

pub struct FieldDecl {
    name: int
    ty: TypeRef
    initial: int = -1
}

// fieldStart/fieldCount index Program.fields; variants index Program.lists.
pub struct TypeDecl {
    kind: AggregateKind
    name: int
    fieldStart: int = 0
    fieldCount: int = 0
    variantStart: int = 0
    variantCount: int = 0
    file: int = 0
    public: bool = false
}

pub enum ExprKind {
    Unit
    Paren
    Number
    Boolean
    Text
    Name
    Unary
    Binary
    Call
    Method
    Construct
    Vector
    Index
    Field
    Variant
    Byte
    Slice
    Ref
    Catch
    Try
    None
    Coalesce
    Interpolated
    Jump
    EmptyMap
    Tuple
    HeapType
    Closure
}

// args/names index Program.lists. A Slice keeps its end in extra; a Catch
// keeps its handler statements in args and its binding token in extra.
// Interpolated is the exception: its args directly index Program.stringParts.
// A Jump is the `return [value]`, `break` or `continue` fallback of `??`: its
// token is the keyword and left is the returned value or -1.
// HeapType keeps its explicit type in annotation. A Closure has its parameter
// tokens at nameStart/nameCount and its single expression body in left.
pub struct Expression {
    kind: ExprKind
    token: int
    elementKind: BasicType
    elementName: int = -1
    annotation: TypeRef
    left: int = -1
    right: int = -1
    extra: int = -1
    argStart: int = 0
    argCount: int = 0
    nameStart: int = 0
    nameCount: int = 0
}

// A text part uses token's decoded text and expr=-1. A value part keeps its
// expression index and optional raw format-specifier token (without the colon).
pub struct StringPart {
    token: int
    expr: int = -1
    spec: int = -1
}

pub enum StmtKind {
    Bind
    Assign
    Expr
    Return
    If
    IfLet
    While
    WhileLet
    Loop
    Break
    Continue
    ForRange
    ForEach
}

// body/otherwise index Program.lists. For loops keep the first binding token in
// name; expr is the range start or iterable. ForRange keeps its end in target;
// ForEach keeps its second binding token in target, or -1 for a single binding.
// IfLet/WhileLet keep their payload binding token in name and Optional in expr.
pub struct Statement {
    kind: StmtKind
    token: int
    name: int = -1
    target: int = -1
    annotation: TypeRef
    mutable: bool = false
    expr: int = -1
    bodyStart: int = 0
    bodyCount: int = 0
    elseStart: int = 0
    elseCount: int = 0
}

pub struct Parameter {
    name: int
    ty: TypeRef
    byRef: bool = false
    consuming: bool = false
}

// params index Program.params; body indexes Program.lists. A returned-borrow
// clause `of a` / `of (a, b)` keeps its name tokens in Program.lists at
// sourceStart; sourced records whether the clause was written at all.
pub struct Function {
    name: int
    result: TypeRef
    paramStart: int = 0
    paramCount: int = 0
    bodyStart: int = 0
    bodyCount: int = 0
    file: int = 0
    public: bool = false
    sourced: bool = false
    sourceStart: int = 0
    sourceCount: int = 0
}

// One source file of a module program. Its tokens run from firstToken to its
// own Eof token, whose text is the file path. imports index Program.imports.
pub struct SourceFile {
    firstToken: int
    importsFs: bool = false
    importsIo: bool = false
    importsOs: bool = false
    importsCollections: bool = false
    importStart: int = 0
    importCount: int = 0
}

// `use a/b/c` or `use a/b/{c, d}`: alias is the last segment's token; the
// prefixCount segments before it are at prefixStart, prefixStart + 2, ...
// file is filled by the loader once the module's source file is known.
pub struct ModuleImport {
    alias: int
    prefixStart: int = 0
    prefixCount: int = 0
    file: int = -1
}

pub struct Program {
    expressions: Vec[Expression] = []
    statements: Vec[Statement] = []
    functions: Vec[Function] = []
    types: Vec[TypeDecl] = []
    lists: Vec[int] = []
    params: Vec[Parameter] = []
    fields: Vec[FieldDecl] = []
    resultTypes: Vec[ResultRef] = []
    tupleAtoms: Vec[TypeRef] = []
    stringParts: Vec[StringPart] = []
    files: Vec[SourceFile] = []
    imports: Vec[ModuleImport] = []
}
